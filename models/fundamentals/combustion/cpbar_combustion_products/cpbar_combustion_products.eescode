{=============================================================================
  cpbar: mean specific heat of the combustion products of a CmHn fuel
  CoolSolve Library model CSL-0005 (function library, kind = function)
  -----------------------------------------------------------------------------
  Three routines of the ULiege combustion library (EES .LIB, P. Ngendakumana,
  2003), returning gas properties of the products of combustion of a
  hydrocarbon CmHn in simplified air (79 % N2 / 21 % O2, molar):
    - PROCEDURE cpbar: mean specific heat c_bar_p of the products between two
      temperatures; in incomplete combustion (air deficiency) it also returns
      the unburned-CO losses Q_4, the fraction x of the C atoms oxidized to
      CO2 and the minimum excess air e_min; f = 0 returns the properties of
      pure air;
    - FUNCTION gamma: ratio of specific heats of the same products;
    - FUNCTION mmprod: molar mass of the same products.
  The demonstration program at the end calls every routine for the three
  regimes (complete combustion with excess air, incomplete combustion, pure
  air) with the fuel and temperatures of the original test file.

  Inputs : m, n   number of C and H atoms in the fuel CmHn [-]
           f      fuel-air ratio [kg of fuel / kg of air] (f = 0: pure air)
           T_p1, T_p2  temperatures between which c_bar_p is averaged [°C]
  Outputs: c_bar_p [J/kg-K], Q_4 [J/kg of fuel], x [-], e_min [-], e [-],
           gamma [-], molar mass [kg/kmol]
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
           (mass basis required, see the unit checks of the original)
  Source : CombCmHn_SI_PNG2003_V2.LIB (ULiege Thermodynamics Laboratory,
           P. Ngendakumana 2003; also distributed as the CoolSolve example
           cpbar.eescode) - see README.md
  Status : VERIFIED against the EES stored solution of the original test file
           (CoolSolve branch fix/library-gaps).
           See README.md, "Verification".
 =============================================================================}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2,T=T_p2))*MM_CO2
h_CO = (enthalpy(CO,T=T_p1)-enthalpy(CO,T=T_p2))*MM_CO
h_H2O =(enthalpy(H2O,T=T_p1)-enthalpy(H2O,T=T_p2))*MM_H2O
h_N2 = (enthalpy(N2,T=T_p1)-enthalpy(N2,T=T_p2))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_p1-T_p2)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2, T=T_p2))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_p1)-enthalpy(H2O, T=T_p2))*MM_H2O
hp_3 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
hp_4 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_p1-T_p2)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
ha_2 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_p1-T_p2)
ENDIF

END


FUNCTION gamma (m,n,f,T_p1,T_p2)

{GAMMA  function returns the specific heats ratio of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of
fuel (m and n), the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2)
in °C.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the function returns the specific heats for pure air if f=0 (whatever m and n).

When using this function, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
If (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
IF (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2); MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)


IF (f>0) Then

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
MM_prod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2,T=T_p2))*MM_CO2
h_CO = (enthalpy(CO,T=T_p1)-enthalpy(CO,T=T_p2))*MM_CO
h_H2O =(enthalpy(H2O,T=T_p1)-enthalpy(H2O,T=T_p2))*MM_H2O
h_N2 = (enthalpy(N2,T=T_p1)-enthalpy(N2,T=T_p2))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/MM_prod)/(T_p1-T_p2)
gamma = c_bar_p/(c_bar_p-R_u/MM_prod)

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy, specific heat and gamma of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2, T=T_p2))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_p1)-enthalpy(H2O, T=T_p2))*MM_H2O
hp_3 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
hp_4 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
cpbar  = hp/(T_p1-T_p2)
gamma = cpbar/(cpbar-R_u/MM_prod)
ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
ha_2 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
cpbar  = ha/(T_p1-T_p2)
gamma = cpbar/(cpbar-R_u/MM_a)
ENDIF

END

FUNCTION  mmprod(m,n,f)

{MMPROD function returns the molar mass (kg/kmol) of the combustion products of a
CmHn hydrocarbon. The inputs are : the type of fuel (m and n) and the fuel-air ratio (f).

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the function returns the molar mass for pure air if f=0 (whatever m and n).}

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Molar masses of the species"
MM_O2 = molarmass(O2) ; MM_N2 = molarmass(N2)
MM_CO2 = molarmass(CO2) ; MM_CO = molarmass(CO); MM_H2O = molarmass(H2O)

IF (f>0) Then

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) THEN
"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = (m+n/4)*(1+e)*(79/21)
c = n/2
x=2*(e*(m+n/4)+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
mmprod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
mmprod = MM_a

ENDIF

END


"!Demonstration program: calls every routine on the three regimes"
"It is ignored by the future $INCLUDE library:cpbar_combustion_products (CS-FEAT-IMPORT)."
"Fuel of the original EES test file: a fuel oil CmHn with m = 86/12, n = 14 (M = 100 kg/kmol);"
"temperatures 25 °C -> 200 °C. EES reference values in the README (verification table)."

"cpbar - complete combustion with excess air (f = 0.05 < f_st = 0.0681)"
m_c = 86/12 ; n_c = 14/1 ; f_c = 0.05 ; T_p1_c = 200 ; T_p2_c = 25
CALL cpbar(m_c,n_c,f_c,T_p1_c,T_p2_c:c_bar_p_c,Q_4_c,x_c,e_min_c,e_c)

"cpbar - incomplete combustion, air deficiency (f = 0.07 > f_st): reference run of the EES test file"
m_i = 86/12 ; n_i = 14/1 ; f_i = 0.07 ; T_p1_i = 200 ; T_p2_i = 25
CALL cpbar(m_i,n_i,f_i,T_p1_i,T_p2_i:c_bar_p_i,Q_4_i,x_i,e_min_i,e_i)

"cpbar - pure air (f = 0, m and n irrelevant)"
m_a = 0 ; n_a = 0 ; f_a = 0 ; T_p1_a = 200 ; T_p2_a = 25
CALL cpbar(m_a,n_a,f_a,T_p1_a,T_p2_a:c_bar_p_a,Q_4_a,x_a,e_min_a,e_a)

"gamma - complete combustion (f = 0.05)"
gamma_c = gamma (m_c,n_c,f_c,T_p1_c,T_p2_c)

"gamma - incomplete combustion, air deficiency (f = 0.08 > f_st)"
gamma_i = gamma (m_i,n_i,0.08,T_p1_i,T_p2_i)

"gamma - pure air"
gamma_a = gamma (m_a,n_a,f_a,T_p1_a,T_p2_a)

"mmprod - complete combustion (f = 0.05)"
MM_prod_c =  mmprod(m_c,n_c,f_c)

"mmprod - pure air"
MM_prod_a =  mmprod(m_a,n_a,f_a)
