{=============================================================================
  BrineProp: thermophysical properties of aqueous secondary refrigerants
  (function library)
  CoolSolve Library model CSL-0079
 -----------------------------------------------------------------------------
  Freezing point, density, specific heat, thermal conductivity and dynamic
  viscosity of eleven aqueous secondary refrigerants (glycols, alcohols,
  ammonia and salt brines) as a function of the mass concentration and the
  temperature: an 18-term polynomial in the deviations of the concentration
  and the temperature from the mean values of the solution, with the
  coefficients of the ULiege BrineProp library (Brineprop.lib and
  Brineprop2.LIB).

  Routines (include them with $INCLUDE brineprop_secondary_refrigerants):
    rho = BrineProperty('Density', 'EG', 30, T)
        FUNCTION, one property in SI units, for use in an equation
    CALL BRINEPROP(Pr$, Fl$, Conc, Temp : output)
        one property, in the units of the EES library
    CALL BRINEPROP2(Fl$, Conc, Temp : FreezingPt, Density, SpecHeat,
                    ThermalConductivity, DynamicViscosity, Pr)
        the five properties and the Prandtl number, in the units of the EES
        library
  For a new model, CoolProp's incompressible solutions give the same
  properties (a 2010 edition of the same IIR correlations, within about 1 %
  at usual conditions) with the standard property functions and no
  $INCLUDE: rho = density(EG, 30, T=T), cp(...), conductivity(...),
  viscosity(...), for EG, PG, EthanolSolution, Methanol, Glycerol, CaCl2 and
  NaCl; this library remains needed for the EES models that call BRINEPROP
  or BRINEPROP2, for the freezing point and for NH3, K2CO3, MgCl2 and KAc
  (see README.md, CoolProp incompressible solutions).

  Inputs : property name 'Freeze', 'Density', 'SpecHeat', 'ThermalC' or
           'DynVisc'; solution code Fl$ (EG, PG, EA, MA, GL, NH3, K2CO3,
           CaCl2, MgCl2, NaCl, KAc), names in any case; Conc = mass
           concentration [%], inside the range of the solution; Temp [C]
  Outputs: freezing point [C], density [kg/m^3], specific heat [J/kg-K],
           thermal conductivity [W/m-K], dynamic viscosity [Pa-s]; BRINEPROP
           returns the specific heat in kJ/kg-K and the viscosity in
           milliPa-s, BRINEPROP2 the specific heat in kJ/kg-K, as the EES
           library does, so that the EES models that call them run unchanged
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiege Thermodynamics Laboratory, BrineProp library (Brineprop.lib,
           1997; Brineprop2.LIB), collection of S. Quoilin - see README.md
  Companion tables: brineprop_secondary_refrigerants-BrineSolutions.csv (the
           11 solutions: code, name, concentration range, mean concentration
           and mean temperature of the polynomial) and
           -BrineCoefficients.csv (the 18 coefficients of each solution, one
           column per property, 198 x 5)
 =============================================================================}

FUNCTION BrineProperty(Prop$, Fl$, Conc, Temp)
  "Row of the solution in the table BrineSolutions (an unknown code is an error)"
  i = LOOKUP$ROW('BrineSolutions', 'Code', Fl$)
  IF (Conc < LOOKUP('BrineSolutions', i, 'Conc_min')) THEN CALL ERROR('BrineProperty: the mass concentration XXXA1 % is below the range of the solution (table BrineSolutions)', Conc)
  IF (Conc > LOOKUP('BrineSolutions', i, 'Conc_max')) THEN CALL ERROR('BrineProperty: the mass concentration XXXA1 % is above the range of the solution (table BrineSolutions)', Conc)
  "Column of the property in the table BrineCoefficients"
  j = 0
  IF (Prop$ = 'Freeze') THEN j = 1
  IF (Prop$ = 'Density') THEN j = 2
  IF (Prop$ = 'SpecHeat') THEN j = 3
  IF (Prop$ = 'ThermalC') THEN j = 4
  IF (Prop$ = 'DynVisc') THEN j = 5
  IF (j = 0) THEN CALL ERROR('BrineProperty: unknown property XXX$ (Freeze, Density, SpecHeat, ThermalC or DynVisc)', Prop$)
  "The 18 coefficients of the solution for this property"
  k = 0
  REPEAT
    k = k + 1
    c[k] = LOOKUP('BrineCoefficients', 18*(i - 1) + k, j)
  UNTIL (k >= 18)
  "Deviations from the mean concentration and temperature of the solution"
  x = Conc - LOOKUP('BrineSolutions', i, 'Conc_mean')
  y = Temp - LOOKUP('BrineSolutions', i, 'T_mean')
  f = c[1] + c[2]*y + c[3]*y^2 + c[4]*y^3 + c[5]*x + c[6]*x*y + c[7]*x*y^2 + c[8]*x*y^3 + c[9]*x^2 + c[10]*x^2*y + c[11]*x^2*y^2 + c[12]*x^2*y^3 + c[13]*x^3 + c[14]*x^3*y + c[15]*x^3*y^2 + c[16]*x^4 + c[17]*x^4*y + c[18]*x^5
  "The polynomial of the viscosity gives its logarithm, in milliPa-s"
  IF (j = 5) THEN f = exp(f)/1000
  BrineProperty := f
END

PROCEDURE BRINEPROP(Pr$, Fl$, Conc, Temp : output)
  "One property in the units of the EES library: Pr$ = 'Freeze' [C], 'Density' [kg/m^3], 'SpecHeat' [kJ/kg-K], 'ThermalC' [W/m-K] or 'DynVisc' [milliPa-s]"
  value = BrineProperty(Pr$, Fl$, Conc, Temp)
  factor = 1
  IF (Pr$ = 'SpecHeat') THEN factor = 0.001
  IF (Pr$ = 'DynVisc') THEN factor = 1000
  output = factor*value
END

PROCEDURE BRINEPROP2(Fl$, Conc, Temp : FreezingPt, Density, SpecHeat, ThermalConductivity, DynamicViscosity, Pr)
  "The five properties and the Prandtl number in the units of the EES library: SpecHeat [kJ/kg-K], DynamicViscosity [Pa-s]"
  FreezingPt = BrineProperty('Freeze', Fl$, Conc, Temp)
  Density = BrineProperty('Density', Fl$, Conc, Temp)
  c_p = BrineProperty('SpecHeat', Fl$, Conc, Temp)
  ThermalConductivity = BrineProperty('ThermalC', Fl$, Conc, Temp)
  DynamicViscosity = BrineProperty('DynVisc', Fl$, Conc, Temp)
  SpecHeat = c_p/1000
  Pr = c_p*DynamicViscosity/ThermalConductivity
END

"!Demonstration program (ignored by $INCLUDE)"

"!Case 1 (BRINEPROP): propylene glycol 50 % at 65 °C, the example block that"
"!followed END in Brineprop.lib (its temperature is written 65 [K] there;"
"!the temperature of the library is in degrees Celsius, as its help file states)"
brine_1$='PG'
X_brine_1=50 [%]
T_brine_1=65 [C]
CALL BRINEPROP('Freeze',brine_1$,X_brine_1,T_brine_1:T_freeze_1)
CALL BRINEPROP('Density',brine_1$,X_brine_1,T_brine_1:rho_brine_1)
CALL BRINEPROP('SpecHeat',brine_1$,X_brine_1,T_brine_1:c_p_brine_1_kJ)
CALL BRINEPROP('ThermalC',brine_1$,X_brine_1,T_brine_1:k_brine_1)
CALL BRINEPROP('DynVisc',brine_1$,X_brine_1,T_brine_1:mu_brine_1_mPa_s)

"!Case 2 (BRINEPROP): ethylene glycol 25 % at the temperature stored by the"
"!glycol run-around loop reference model of the same library (inventory"
"!TM-0476): its stored solution holds rho_gw = 1036.228755 kg/m^3,"
"!c_p_gw = 3805.350851 J/kg-K and mu_gw = 0.002943460833 Pa-s"
brine_2$='EG'
X_brine_2=25 [%]
T_brine_2=6.324036551 [C]
CALL BRINEPROP('Freeze',brine_2$,X_brine_2,T_brine_2:T_freeze_2)
CALL BRINEPROP('Density',brine_2$,X_brine_2,T_brine_2:rho_brine_2)
CALL BRINEPROP('SpecHeat',brine_2$,X_brine_2,T_brine_2:c_p_brine_2_kJ)
CALL BRINEPROP('ThermalC',brine_2$,X_brine_2,T_brine_2:k_brine_2)
CALL BRINEPROP('DynVisc',brine_2$,X_brine_2,T_brine_2:mu_brine_2_mPa_s)
"SI values of the two properties in kJ/kg-K and milliPa-s, as the stored solution of the glycol loop model holds them"
c_p_brine_2=c_p_brine_2_kJ*1000 "[J/kg-K]"
mu_brine_2=mu_brine_2_mPa_s/1000 "[Pa-s]"

"!Case 3 (BRINEPROP2): ethylene glycol 30 % at -5 °C, the call of the"
"!Vitocal 300-G heat pump model of the collection (CSL-0116), whose stored"
"!solution holds the six outputs"
brine_3$='EG'
X_brine_3=30 [%]
T_brine_3=-5 [C]
CALL BRINEPROP2(brine_3$,X_brine_3,T_brine_3:T_freeze_3,rho_brine_3,c_p_brine_3_kJ,k_brine_3,mu_brine_3,Pr_brine_3)

"!Case 4 (BRINEPROP2): calcium chloride 25 % at -4 °C, the example call that"
"!followed END in Brineprop2.LIB, with its solution name in mixed case"
brine_4$='Cacl2'
X_brine_4=25 [%]
T_brine_4=-4 [C]
CALL BRINEPROP2(brine_4$,X_brine_4,T_brine_4:T_freeze_4,rho_brine_4,c_p_brine_4_kJ,k_brine_4,mu_brine_4,Pr_brine_4)

"!Case 5 (BrineProperty, SI units, in equations): the state of case 2"
T_freeze_5 = BrineProperty('Freeze', brine_2$, X_brine_2, T_brine_2)    "[C]"
rho_brine_5 = BrineProperty('Density', brine_2$, X_brine_2, T_brine_2)  "[kg/m^3]"
c_p_brine_5 = BrineProperty('SpecHeat', brine_2$, X_brine_2, T_brine_2) "[J/kg-K]"
k_brine_5 = BrineProperty('ThermalC', brine_2$, X_brine_2, T_brine_2)   "[W/m-K]"
mu_brine_5 = BrineProperty('DynVisc', brine_2$, X_brine_2, T_brine_2)   "[Pa-s]"
