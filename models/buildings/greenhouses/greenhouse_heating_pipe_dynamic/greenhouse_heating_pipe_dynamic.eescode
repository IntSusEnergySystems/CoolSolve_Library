{=============================================================================
  Greenhouse heating pipe rail: discretized dynamic model
  CoolSolve Library model CSL-0335
 -----------------------------------------------------------------------------
  Six-day simulation (10-15 Dec, Brussels TMY) of the pipe-rail heating
  circuit of a Venlo tomato greenhouse: the pipe loop is divided into five
  cells in series, each with the water temperature as a state (finite-volume
  energy balance, constant-property water), exchanging hindered convection
  with the air and long-wave radiation with the canopy, floor and cover. The
  climate core (air, canopy, cover, floor, five ground layers, air moisture)
  is the one of CSL-0334; the roof vents open proportionally above the
  set-point. Outdoor weather and the heating-circuit boundary conditions
  (supply temperature and mass flow rate, weather-compensated schedule) are
  read from the companion table
  greenhouse_heating_pipe_dynamic-heating.csv (hourly). No thermal screen,
  no lighting, no CO2 balance, no crop growth - see README.md.

  Inputs : 'heating' table (tau, T_out, RH_out, I_glob, u_wind, T_sky,
           T_air_sp, CO2_air_sp, T_su_pip, M_dot_pip), construction
           parameters, initial state
  Outputs: trajectory of T_air, T_can, T_cov, T_flr, T_so1..5, VP_air,
           T_w1..5 (pipe cells), RH_air, vents opening ($IntegralTable)
  Units  : SI - temperatures in °C, pressures in Pa, energies in J, all
           quantities per m2 of greenhouse floor
  Source : Greenhouses Modelica library (example Greenhouse_2), Q. Altes-Buch
           et al. - see README.md
=============================================================================}

"!Integration interval (six days, hourly output)"
tau_1 = 0                        "start of the integration interval [s]"
tau_2 = 518400                   "end of the integration interval [s]"
tau_hour = tau/3600              "time in hours [h]"

"!Weather and climate set-points from the lookup table"
T_out = INTERPOLATE('heating', 'tau', 'T_out', tau)          "outdoor air temperature [C]"
RH_out = INTERPOLATE('heating', 'tau', 'RH_out', tau)        "outdoor relative humidity [%]"
I_glob = INTERPOLATE('heating', 'tau', 'I_glob', tau)        "global irradiation on the cover [W/m^2]"
u_wind = INTERPOLATE('heating', 'tau', 'u_wind', tau)        "wind speed [m/s]"
T_sky = INTERPOLATE('heating', 'tau', 'T_sky', tau)          "sky temperature [C]"
T_air_sp = INTERPOLATE('heating', 'tau', 'T_air_sp', tau)    "air temperature set-point [C]"
CO2_air = INTERPOLATE('heating', 'tau', 'CO2_air_sp', tau)   "CO2 concentration of the air [ppm]"
T_su_pip = INTERPOLATE('heating', 'tau', 'T_su_pip', tau)   "pipe water supply temperature [C]"
M_dot_pip = INTERPOLATE('heating', 'tau', 'M_dot_pip', tau) "pipe water mass flow rate [kg/m^2-s]"

"!Constants"
sigma = 5.67E-8                 "Stefan-Boltzmann constant [W/m^2-K^4]"
g = 9.81                        "gravitational acceleration [m/s^2]"
R = 8314                        "universal gas constant [J/kmol-K]"
M_H2O = 18                      "molar mass of water [kg/kmol]"
R_v = 8314/18                   "specific gas constant of water vapour [J/kg-K]"
DELTAh_fg = 2.45E6              "latent heat of vaporization of water at 21 C [J/kg]"
T_bar = 291                     "fixed air temperature of the moisture balance [K]"

"!Geometry and construction (Venlo-type, Greenhouse_2 example: 1.4 ha, 625 pipe loops of 50 m)"
phi = 25                        "roof slope [deg]"
h_air = 3.8                     "height of the (single) air zone [m]"
l_pip = 2.232                   "pipe rail length per m^2 of floor (625*50/1.4e4) [m/m^2]"
d_pip = 0.051                   "pipe rail outer diameter [m]"

"!Cover (single glass layer)"
eps_cov = 0.84                  "emissivity [-]"
tau_covPAR = 0.85               "PAR transmission coefficient [-]"
rho_covPAR = 0.13               "PAR reflection coefficient [-]"
tau_covNIR = 0.85               "NIR transmission coefficient [-]"
rho_covNIR = 0.13               "NIR reflection coefficient [-]"
rho_cov = 2600                  "density [kg/m^3]"
cp_cov = 840                     "specific heat capacity [J/kg-K]"
e_cov = 4E-3                    "thickness [m]"

"!Canopy (tomato)"
eps_can = 1                     "emissivity [-]"
U_leaf_air = 5                  "free-convection coefficient of a leaf [W/m^2-K]"
LAI = 1.06                      "leaf area index, fixed (no crop growth) [m^2/m^2]"
rho_canPAR = 0.07               "PAR reflection coefficient of the canopy [-]"
rho_canNIR = 0.35               "NIR reflection coefficient of the canopy [-]"
K1_PAR = 0.7                    "PAR extinction coefficient (downward) [-]"
K2_PAR = 0.7                    "PAR extinction coefficient (upward) [-]"
K_NIR = 0.27                    "NIR extinction coefficient [-]"
c_leaf = 1200                   "leaf heat capacity per m^2 of leaf [J/m^2-K]"

"!Floor (concrete surface layer)"
eps_flr = 0.89                  "emissivity [-]"
rho_flrPAR = 0.07               "PAR reflection coefficient [-]"
rho_flrNIR = 0.07               "NIR reflection coefficient [-]"
C_flr = 2E4                     "floor surface layer capacitance per m^2 of floor [J/m^2-K]"
e_flr = 0.02                    "concrete floor layer thickness [m]"
lambda_flr = 1.7                "concrete thermal conductivity [W/m-K]"

"!Ground (nodal soil model, doubling layer thickness)"
lambda_so = 0.85                "soil thermal conductivity [W/m-K]"
rc_so = 1.73E6                  "soil volumetric heat capacity [J/m^3-K]"
e_so1 = 0.02                    "soil layer thicknesses [m]"
e_so2 = 0.04
e_so3 = 0.08
e_so4 = 0.16
e_so5 = 0.32
T_so_deep = 3                   "deep-ground boundary temperature [C]"

"!Ventilation and leakage"
eta_RfFlr = 0.1                 "maximum roof vent area / floor area [-]"
C_d = 0.75                      "ventilation discharge coefficient [-]"
C_w = 0.09                      "wind pressure coefficient [-]"
h_ven = 0.68                    "vertical dimension of a ventilation opening [m]"
c_leak = 1.5E-4                 "greenhouse leakage coefficient [-]"

"!Heating pipes (pipe rail, hindered convection)"
eps_pip = 0.88                  "emissivity [-]"
c_pipFF = 0.49                  "view-factor coefficient of a hindered pipe [-]"
N_cell = 5                      "number of pipe cells in series [-]"
rho_w = 1000                    "water density (constant property) [kg/m^3]"
cp_w = 4187                     "water specific heat capacity (constant property) [J/kg-K]"
d_int = 0.047                   "pipe inner diameter (0.051 m o.d., 2 mm wall) [m]"
V_pip = pi*d_int^2/4*l_pip      "pipe water volume per m^2 of floor [m^3/m^2]"
C_water = rho_w*cp_w*V_pip/N_cell   "water capacitance of one pipe cell [J/m^2-K]"

"!Air properties"
rho_air = 1.2                   "air density [kg/m^3]"
c_p_air = 1005                  "air specific heat capacity [J/kg-K]"
rho_can = 1.23                  "air density used in the transpiration formula [kg/m^3]"

"!Transpiration (Stanghellini 1987, simplified switch form of the library)"
gamma = 65.8                    "psychrometric constant [Pa/K]"
r_b = 275                       "boundary layer resistance of the leaves [s/m]"
r_min = 82                      "minimum canopy resistance [s/m]"
C_1 = 4.3                       "radiation resistance parameter [W/m^2]"
C_2 = 0.54                      "radiation resistance parameter [W/m^2]"

"!Ventilation control (proportional)"
K_ven = 0.2                     "proportional gain of the vents opening [1/K]"
DELTAT_ven = 2                  "vents opening temperature band above the set-point [K]"

"!Capacitances (per m^2 of floor)"
C_air = rho_air*c_p_air*h_air   "air zone [J/m^2-K]"
C_can = c_leaf*LAI              "canopy [J/m^2-K]"
C_cov = rho_cov*cp_cov*e_cov/cos(phi)   "cover [J/m^2-K]"
C_so1 = rc_so*e_so1             "soil layer capacitances [J/m^2-K]"
C_so2 = rc_so*e_so2
C_so3 = rc_so*e_so3
C_so4 = rc_so*e_so4
C_so5 = rc_so*e_so5

"!View factors"
A_pip = pi*d_pip*l_pip          "pipe area per m^2 of floor [m^2/m^2]"
FF_pip = A_pip*c_pipFF          "pipe view factor [-]"
FF_can = 1 - exp(-0.94*LAI)     "canopy view factor [-]"

"!Solar model (PAR/NIR split, no thermal screen)"
eta_PAR = 0.5                   "PAR share of the global radiation [-]"
eta_NIR = 0.5                   "NIR share of the global radiation [-]"
eta_air_G = 0.1                 "share absorbed by construction elements [-]"
alpha_covPAR = 1 - tau_covPAR - rho_covPAR   "PAR absorption coefficient of the cover [-]"
alpha_covNIR = 1 - tau_covNIR - rho_covNIR   "NIR absorption coefficient of the cover [-]"
q_swr_cov = (alpha_covPAR*eta_PAR + alpha_covNIR*eta_NIR)*I_glob   "short-wave absorbed by the cover [W/m^2]"
R_t_PAR = I_glob*eta_PAR*tau_covPAR*(1 - eta_air_G)   "PAR transmitted into the greenhouse [W/m^2]"
q_swr_canPAR = R_t_PAR*(1 - rho_canPAR)*(1 - exp(-K1_PAR*LAI)) + R_t_PAR*exp(-K1_PAR*LAI)*rho_flrPAR*(1 - rho_canPAR)*(1 - exp(-K2_PAR*LAI))   "PAR absorbed by the canopy (direct + floor-reflected) [W/m^2]"
q_swr_flrPAR = R_t_PAR*exp(-K1_PAR*LAI)*(1 - rho_flrPAR)   "PAR absorbed by the floor [W/m^2]"
tau_CF_NIR = exp(-K_NIR*LAI)*(1 - rho_flrNIR)/(1 - rho_canNIR*(1 - exp(-K_NIR*LAI))*rho_flrNIR)   "NIR transmission of the canopy-floor block [-]"
rho_CF_NIR = rho_canNIR*(1 - exp(-K_NIR*LAI)) + exp(-2*K_NIR*LAI)*(1 - rho_flrNIR)*rho_flrNIR/(1 - rho_canNIR*(1 - exp(-K_NIR*LAI))*rho_flrNIR)   "NIR reflection of the canopy-floor block [-]"
tau_CCF_NIR = tau_covNIR*tau_CF_NIR/(1 - rho_covNIR*rho_CF_NIR)   "NIR transmission of the cover-canopy-floor block [-]"
rho_CCF_NIR = rho_covNIR + tau_covNIR^2*rho_CF_NIR/(1 - rho_covNIR*rho_CF_NIR)   "NIR reflection of the cover-canopy-floor block [-]"
alpha_canNIR = 1 - tau_CCF_NIR - rho_CCF_NIR   "lumped NIR absorption coefficient of the canopy [-]"
alpha_flrNIR = tau_CCF_NIR      "lumped NIR absorption coefficient of the floor [-]"
R_NIR = I_glob*eta_NIR*(1 - eta_air_G)   "NIR entering the greenhouse [W/m^2]"
q_swr_can = q_swr_canPAR + R_NIR*alpha_canNIR   "short-wave absorbed by the canopy [W/m^2]"
q_swr_flr = q_swr_flrPAR + R_NIR*alpha_flrNIR   "short-wave absorbed by the floor [W/m^2]"
q_swr_air = eta_air_G*I_glob*(tau_covPAR*eta_PAR + (alpha_canNIR + alpha_flrNIR)*eta_NIR)   "short-wave absorbed by construction elements, released to the air [W/m^2]"
R_can_glob = I_glob*(1 - eta_air_G)*(eta_PAR*tau_covPAR + eta_NIR*(alpha_canNIR + alpha_flrNIR))   "global radiation above the canopy [W/m^2]"

"!Vapour pressures"
VP_sat_air = -274.36 + 877.52*exp(0.0545*T_air)   "saturation vapour pressure of the air [Pa]"
VP_sat_cov = -274.36 + 877.52*exp(0.0545*T_cov)   "saturation vapour pressure at the cover [Pa]"
VP_sat_can = -274.36 + 877.52*exp(0.0545*T_can)   "saturation vapour pressure at the canopy [Pa]"
VP_out = RH_out/100*(-274.36 + 877.52*exp(0.0545*T_out))   "outdoor vapour pressure [Pa]"

"!Convective heat exchange coefficients"
U_air_cov = 1.7*((T_air - T_cov)^2 + 1e-8)^0.165/cos(phi)^0.66   "free convection, air-cover (inclined); |dT|^0.33 with a smooth floor [W/m^2-K]"
U_can_air = 2*LAI*U_leaf_air    "canopy-air (both leaf sides) [W/m^2-K]"
s_sw = 11                       "slope of the smooth switches [1/K or 1/(m/s)]"
DU_air_flr = T_air - T_flr      "air-floor temperature difference [K]"
U_air_flr = 1/(1 + exp(-s_sw*DU_air_flr))*1.7*abs(DU_air_flr)^0.33 + 1/(1 + exp(s_sw*DU_air_flr))*1.3*abs(DU_air_flr)^0.25   "free convection, air-floor (up/down) [W/m^2-K]"
du_wind = 4 - u_wind            "wind speed distance to the correlation switch [m/s]"
alpha_cov_out = (1/(1 + exp(-s_sw*du_wind))*(2.8 + 1.2*u_wind) + 1/(1 + exp(s_sw*du_wind))*2.5*u_wind^0.8)/cos(phi)   "wind-driven outer cover convection [W/m^2-K]"

"!Convective and conductive heat flows (positive in the direction indicated)"
q_cnv_air_cov = U_air_cov*(T_air - T_cov)         "convection air-cover [W/m^2]"
q_cnv_can_air = U_can_air*(T_can - T_air)         "convection canopy-air [W/m^2]"
q_cnv_air_flr = U_air_flr*(T_air - T_flr)         "convection air-floor [W/m^2]"
q_cnv_pip_air[1] = 1.99*((T_w[1] - T_air)^2 + 1e-8)^0.16*pi*d_pip*l_pip/N_cell*(T_w[1] - T_air)   "hindered pipe convection, cell 1-air [W/m^2]"
q_cnv_pip_air[2] = 1.99*((T_w[2] - T_air)^2 + 1e-8)^0.16*pi*d_pip*l_pip/N_cell*(T_w[2] - T_air)   "hindered pipe convection, cell 2-air [W/m^2]"
q_cnv_pip_air[3] = 1.99*((T_w[3] - T_air)^2 + 1e-8)^0.16*pi*d_pip*l_pip/N_cell*(T_w[3] - T_air)   "hindered pipe convection, cell 3-air [W/m^2]"
q_cnv_pip_air[4] = 1.99*((T_w[4] - T_air)^2 + 1e-8)^0.16*pi*d_pip*l_pip/N_cell*(T_w[4] - T_air)   "hindered pipe convection, cell 4-air [W/m^2]"
q_cnv_pip_air[5] = 1.99*((T_w[5] - T_air)^2 + 1e-8)^0.16*pi*d_pip*l_pip/N_cell*(T_w[5] - T_air)   "hindered pipe convection, cell 5-air [W/m^2]"
q_cnv_pip_air_tot = sum(q_cnv_pip_air[1..5])   "total pipe convection to the air [W/m^2]"
q_cnv_cov_out = alpha_cov_out*(T_cov - T_out)     "convection cover-outdoor air [W/m^2]"
U_flr_so1 = 2/(e_flr/lambda_flr + e_so1/lambda_so)   "conduction floor-soil(1) [W/m^2-K]"
U_so12 = 2*lambda_so/(e_so1 + e_so2)              "conduction soil(1)-soil(2) [W/m^2-K]"
U_so23 = 2*lambda_so/(e_so2 + e_so3)              "conduction soil(2)-soil(3) [W/m^2-K]"
U_so34 = 2*lambda_so/(e_so3 + e_so4)              "conduction soil(3)-soil(4) [W/m^2-K]"
U_so45 = 2*lambda_so/(e_so4 + e_so5)              "conduction soil(4)-soil(5) [W/m^2-K]"
U_so5_dp = lambda_so/(e_so5/2)                    "conduction soil(5)-deep ground [W/m^2-K]"
q_cnd_flr_so1 = U_flr_so1*(T_flr - T_so1)         "conduction floor-soil(1) [W/m^2]"
q_cnd_so12 = U_so12*(T_so1 - T_so2)               "conduction soil(1)-soil(2) [W/m^2]"
q_cnd_so23 = U_so23*(T_so2 - T_so3)               "conduction soil(2)-soil(3) [W/m^2]"
q_cnd_so34 = U_so34*(T_so3 - T_so4)               "conduction soil(3)-soil(4) [W/m^2]"
q_cnd_so45 = U_so45*(T_so4 - T_so5)               "conduction soil(4)-soil(5) [W/m^2]"
q_cnd_so5_dp = U_so5_dp*(T_so5 - T_so_deep)       "conduction soil(5)-deep ground [W/m^2]"

"!Long-wave radiation flows"
T_air_K = T_air + 273.15
T_can_K = T_can + 273.15
T_cov_K = T_cov + 273.15
T_flr_K = T_flr + 273.15
T_sky_K = T_sky + 273.15
q_rad_cov_sky = eps_cov*sigma*(T_cov_K^4 - T_sky_K^4)   "radiation cover-sky [W/m^2]"
q_rad_can_cov = eps_can*eps_cov*FF_can*sigma*(T_can_K^4 - T_cov_K^4)   "radiation canopy-cover [W/m^2]"
q_rad_can_flr = eps_can*eps_flr*FF_can*(1 - FF_pip)*sigma*(T_can_K^4 - T_flr_K^4)   "radiation canopy-floor [W/m^2]"
q_rad_flr_cov = eps_flr*eps_cov*(1 - FF_pip)*(1 - FF_can)*sigma*(T_flr_K^4 - T_cov_K^4)   "radiation floor-cover [W/m^2]"
q_rad_pip_can[1] = eps_pip*eps_can*FF_pip*FF_can*sigma*((T_w[1] + 273.15)^4 - T_can_K^4)/N_cell   "radiation cell 1-can [W/m^2]"
q_rad_pip_can[2] = eps_pip*eps_can*FF_pip*FF_can*sigma*((T_w[2] + 273.15)^4 - T_can_K^4)/N_cell   "radiation cell 2-can [W/m^2]"
q_rad_pip_can[3] = eps_pip*eps_can*FF_pip*FF_can*sigma*((T_w[3] + 273.15)^4 - T_can_K^4)/N_cell   "radiation cell 3-can [W/m^2]"
q_rad_pip_can[4] = eps_pip*eps_can*FF_pip*FF_can*sigma*((T_w[4] + 273.15)^4 - T_can_K^4)/N_cell   "radiation cell 4-can [W/m^2]"
q_rad_pip_can[5] = eps_pip*eps_can*FF_pip*FF_can*sigma*((T_w[5] + 273.15)^4 - T_can_K^4)/N_cell   "radiation cell 5-can [W/m^2]"
q_rad_pip_flr[1] = eps_pip*eps_flr*FF_pip*(1 - FF_can)*sigma*((T_w[1] + 273.15)^4 - T_flr_K^4)/N_cell   "radiation cell 1-flr [W/m^2]"
q_rad_pip_flr[2] = eps_pip*eps_flr*FF_pip*(1 - FF_can)*sigma*((T_w[2] + 273.15)^4 - T_flr_K^4)/N_cell   "radiation cell 2-flr [W/m^2]"
q_rad_pip_flr[3] = eps_pip*eps_flr*FF_pip*(1 - FF_can)*sigma*((T_w[3] + 273.15)^4 - T_flr_K^4)/N_cell   "radiation cell 3-flr [W/m^2]"
q_rad_pip_flr[4] = eps_pip*eps_flr*FF_pip*(1 - FF_can)*sigma*((T_w[4] + 273.15)^4 - T_flr_K^4)/N_cell   "radiation cell 4-flr [W/m^2]"
q_rad_pip_flr[5] = eps_pip*eps_flr*FF_pip*(1 - FF_can)*sigma*((T_w[5] + 273.15)^4 - T_flr_K^4)/N_cell   "radiation cell 5-flr [W/m^2]"
q_rad_pip_cov[1] = eps_pip*eps_cov*FF_pip*(1 - FF_can)*sigma*((T_w[1] + 273.15)^4 - T_cov_K^4)/N_cell   "radiation cell 1-cov [W/m^2]"
q_rad_pip_cov[2] = eps_pip*eps_cov*FF_pip*(1 - FF_can)*sigma*((T_w[2] + 273.15)^4 - T_cov_K^4)/N_cell   "radiation cell 2-cov [W/m^2]"
q_rad_pip_cov[3] = eps_pip*eps_cov*FF_pip*(1 - FF_can)*sigma*((T_w[3] + 273.15)^4 - T_cov_K^4)/N_cell   "radiation cell 3-cov [W/m^2]"
q_rad_pip_cov[4] = eps_pip*eps_cov*FF_pip*(1 - FF_can)*sigma*((T_w[4] + 273.15)^4 - T_cov_K^4)/N_cell   "radiation cell 4-cov [W/m^2]"
q_rad_pip_cov[5] = eps_pip*eps_cov*FF_pip*(1 - FF_can)*sigma*((T_w[5] + 273.15)^4 - T_cov_K^4)/N_cell   "radiation cell 5-cov [W/m^2]"
q_rad_pip_can_tot = sum(q_rad_pip_can[1..5])   "total radiation pipes-can [W/m^2]"
q_rad_pip_flr_tot = sum(q_rad_pip_flr[1..5])   "total radiation pipes-flr [W/m^2]"
q_rad_pip_cov_tot = sum(q_rad_pip_cov[1..5])   "total radiation pipes-cov [W/m^2]"

"!Ventilation (roof vents + leakage)"
u_ven = min(max(K_ven*(T_air - T_air_sp - DELTAT_ven), 0), 1)   "roof vents opening (proportional control) [-]"
T_mean_K = (T_air_K + (T_out + 273.15))/2         "mean indoor-outdoor temperature [K]"
f_ven = u_ven*eta_RfFlr*C_d/2*sqrt(abs(g*h_ven/2*abs(T_air - T_out)/T_mean_K + C_w*u_wind^2))   "roof ventilation rate [m^3/m^2-s]"
f_leak = max(0.25, u_wind)*c_leak "leakage rate [m^3/m^2-s]"
f_air_out = f_ven + f_leak       "total air exchange rate [m^3/m^2-s]"
h_sens_air_out = rho_air*c_p_air*f_air_out*(T_air - T_out)   "sensible ventilation loss [W/m^2]"
MV_air_out = M_H2O*f_air_out/R*(VP_air/T_air_K - VP_out/(T_out + 273.15))   "vapour flow out by ventilation [kg/m^2-s]"

"!Canopy transpiration (Stanghellini, smooth day/night switch on R_can)"
S_rs = 1/(1 + exp(-(R_can_glob - 5)))   "switch: 0 night, 1 day [-]"
r_I = (R_can_glob/(2*LAI) + C_1)/(R_can_glob/(2*LAI) + C_2)   "radiation resistance factor [-]"
C_3 = 0.5e-2*(1 - S_rs) + 2.3e-2*S_rs   "temperature resistance parameter, night/day [1/K^2]"
T_m = 33.6*(1 - S_rs) + 24.5*S_rs      "temperature of minimal leaf resistance, night/day [C]"
C_4 = 1.1e-11*(1 - S_rs) + 6.1e-7*S_rs   "CO2 resistance parameter, night/day [1/ppm^2]"
C_5 = 5.2e-6*(1 - S_rs) + 4.3e-6*S_rs   "vapour pressure resistance parameter, night/day [1/Pa^2]"
r_CO2 = min(1.5, 1 + C_4*(CO2_air - 200)^2)   "CO2 resistance factor [-]"
r_VP = min(3.8, 1 + C_5*(VP_sat_can - VP_air)^2)   "vapour pressure deficit resistance factor [-]"
r_T = 1 + C_3*(T_can - T_m)^2     "temperature resistance factor [-]"
r_s = r_min*r_I*r_CO2*r_VP*r_T    "stomatal resistance [s/m]"
q_lat_can_air = 2*rho_can*c_p_air*LAI/(gamma*(r_b + r_s))*(VP_sat_can - VP_air)   "latent heat of transpiration, Stanghellini [W/m^2]"
MV_can_air = q_lat_can_air/DELTAh_fg   "canopy transpiration [kg/m^2-s]"

"!Condensation on the inner side of the cover"
q_lat_air_cov = DELTAh_fg*max(0, 6.4e-9*U_air_cov*(VP_air - VP_sat_cov))   "latent heat of condensation at the cover [W/m^2]"
MV_air_cov = q_lat_air_cov/DELTAh_fg   "condensation flow [kg/m^2-s]"

"!Node balances (left-hand sides of the state equations)"
Q_cap_air = q_swr_air + q_cnv_pip_air_tot + q_cnv_can_air - q_cnv_air_flr - q_cnv_air_cov - h_sens_air_out   "net heat to the air capacitance [W/m^2]"
Q_cap_can = q_swr_can + q_rad_pip_can_tot - q_cnv_can_air - q_lat_can_air - q_rad_can_cov - q_rad_can_flr   "net heat to the canopy capacitance [W/m^2]"
Q_cap_cov = q_swr_cov + q_cnv_air_cov + q_lat_air_cov + q_rad_can_cov + q_rad_flr_cov + q_rad_pip_cov_tot - q_cnv_cov_out - q_rad_cov_sky   "net heat to the cover capacitance [W/m^2]"
Q_cap_flr = q_swr_flr + q_rad_pip_flr_tot + q_rad_can_flr + q_cnv_air_flr - q_rad_flr_cov - q_cnd_flr_so1   "net heat to the floor capacitance [W/m^2]"
Q_cap_so1 = q_cnd_flr_so1 - q_cnd_so12   "net heat to soil layer 1 [W/m^2]"
Q_cap_so2 = q_cnd_so12 - q_cnd_so23   "net heat to soil layer 2 [W/m^2]"
Q_cap_so3 = q_cnd_so23 - q_cnd_so34   "net heat to soil layer 3 [W/m^2]"
Q_cap_so4 = q_cnd_so34 - q_cnd_so45   "net heat to soil layer 4 [W/m^2]"
Q_cap_so5 = q_cnd_so45 - q_cnd_so5_dp   "net heat to soil layer 5 [W/m^2]"
MV_air = MV_can_air - MV_air_cov - MV_air_out   "net vapour flow to the air moisture state [kg/m^2-s]"

"!State equations (integrated)"
T_air = 19 + INTEGRAL(Q_cap_air/C_air, tau, 0, 518400, 60)        "air temperature [C]"
T_can = 19 + INTEGRAL(Q_cap_can/C_can, tau, 0, 518400, 60)        "canopy temperature [C]"
T_cov = 8 + INTEGRAL(Q_cap_cov/C_cov, tau, 0, 518400, 60)         "cover temperature [C]"
T_flr = 16 + INTEGRAL(Q_cap_flr/C_flr, tau, 0, 518400, 60)        "floor temperature [C]"
T_so1 = 14 + INTEGRAL(Q_cap_so1/C_so1, tau, 0, 518400, 60)        "soil layer temperatures [C]"
T_so2 = 12 + INTEGRAL(Q_cap_so2/C_so2, tau, 0, 518400, 60)
T_so3 = 10 + INTEGRAL(Q_cap_so3/C_so3, tau, 0, 518400, 60)
T_so4 = 8 + INTEGRAL(Q_cap_so4/C_so4, tau, 0, 518400, 60)
T_so5 = 5 + INTEGRAL(Q_cap_so5/C_so5, tau, 0, 518400, 60)
VP_air = 0.8*(-274.36 + 877.52*exp(0.0545*19)) + INTEGRAL(R_v*T_bar/h_air*MV_air, tau, 0, 518400, 60)   "air vapour pressure [Pa]"

"!Heating pipe rail: five cells in series, water temperature states (upwind advection, eq. 28 of the paper)"
T_w[1] = 40 + INTEGRAL((M_dot_pip*cp_w*(T_su_pip - T_w[1]) - q_pip_cell[1])/C_water, tau, 0, 518400, 60)   "pipe cell water temperatures [C]"
T_w[2] = 40 + INTEGRAL((M_dot_pip*cp_w*(T_w[1] - T_w[2]) - q_pip_cell[2])/C_water, tau, 0, 518400, 60)
T_w[3] = 40 + INTEGRAL((M_dot_pip*cp_w*(T_w[2] - T_w[3]) - q_pip_cell[3])/C_water, tau, 0, 518400, 60)
T_w[4] = 40 + INTEGRAL((M_dot_pip*cp_w*(T_w[3] - T_w[4]) - q_pip_cell[4])/C_water, tau, 0, 518400, 60)
T_w[5] = 40 + INTEGRAL((M_dot_pip*cp_w*(T_w[4] - T_w[5]) - q_pip_cell[5])/C_water, tau, 0, 518400, 60)
q_pip_cell[1] = q_cnv_pip_air[1] + q_rad_pip_can[1] + q_rad_pip_flr[1] + q_rad_pip_cov[1]   "heat released by cell 1 (convection + radiation) [W/m^2]"
q_pip_cell[2] = q_cnv_pip_air[2] + q_rad_pip_can[2] + q_rad_pip_flr[2] + q_rad_pip_cov[2]   "heat released by cell 2 (convection + radiation) [W/m^2]"
q_pip_cell[3] = q_cnv_pip_air[3] + q_rad_pip_can[3] + q_rad_pip_flr[3] + q_rad_pip_cov[3]   "heat released by cell 3 (convection + radiation) [W/m^2]"
q_pip_cell[4] = q_cnv_pip_air[4] + q_rad_pip_can[4] + q_rad_pip_flr[4] + q_rad_pip_cov[4]   "heat released by cell 4 (convection + radiation) [W/m^2]"
q_pip_cell[5] = q_cnv_pip_air[5] + q_rad_pip_can[5] + q_rad_pip_flr[5] + q_rad_pip_cov[5]   "heat released by cell 5 (convection + radiation) [W/m^2]"
Q_pip = sum(q_pip_cell[1..5])   "total pipe heat release [W/m^2]"
Q_pip_w = M_dot_pip*cp_w*(T_su_pip - T_w[5])   "heat given up by the water over the loop [W/m^2]"

"!Results"
RH_air = 100*VP_air/VP_sat_air   "relative humidity of the air [%]"

$IntegralTable tau:3600 tau_hour T_air T_can T_cov T_flr T_so1 T_so2 T_so3 T_so4 T_so5 VP_air RH_air T_w[1] T_w[2] T_w[3] T_w[4] T_w[5] Q_pip u_ven f_air_out T_out I_glob T_su_pip M_dot_pip
