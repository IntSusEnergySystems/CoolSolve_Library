{=============================================================================
  Engine derating according to ISO 3046/1 (ambient pressure, temperature)
  CoolSolve Library model CSL-0151 (runnable variant, exercise 1)
-----------------------------------------------------------------------------
  Same model as the native file engine_derating_iso3046.eescode, with the
  two changes forced by the CoolSolve gaps (each logged in the README):
  - the $if selection is resolved to the stored run, exercise 1 (naturally
    aspirated Diesel, 372 kW on site at 400 m / 45 C / 80 % RH,
    eta_m = 0.85); the exercise-2 branch (supercharged engine, 1000 kW at
    3000 m) is omitted (CS-GAP-IF-DIRECTIVE);
  - the accented variable names are written in ASCII (W_dot_sh_ref,
    p_atm_ref, T_a_ref, T_c_ref, T_ref for W_dot_sh_réf, p_atm_réf, T_a_réf,
    T_c_réf, T_réf) (CS-GAP-ACCENTED-IDENT).
  No CoolSolve-only syntax is used; the file is valid EES.

  Inputs : W_dot_sh_x (site power), altitude, T_a_x, phi_a_x, eta_m
  Outputs: alpha (derating factor), K, W_dot_sh_ref (reference power)
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, MCI TP2 exercises 1-2 (P. Ngendakumana; R. Dickes) - see README.md
=============================================================================}

FUNCTION patm(Altitude)
h = Altitude
patm = (101.248815 - 0.0118062234*h + 4.72680601E-07*h^2)*1000   "atmospheric pressure [Pa] (kPa in the original, x1000)"
END

"!Engine derating according to ISO 3046/1"
W_dot_sh_x = W_dot_sh_ref*alpha   "W_dot_sh_réf in the original; alpha <= 1"

Exercice$ = '1'   "1 or 2 (branch resolved to '1' in this variant)"

"Naturally aspirated Diesel engine that must deliver 372 kW on site in the following ambient conditions:
altitude 400 m, ambient temperature 45 °C and a relative humidity of the air of 80 %. The manufacturer
gives a mechanical efficiency of 0.85."

"Reference (standard) conditions"
p_atm_ref = 100E3   "p_atm_réf; atmospheric pressure [Pa] (100 kPa in the original)"
T_a_ref = 24.85   "T_a_réf; intake air temperature [°C] (298 K in the original)"
phi_a_ref = 30   "phi_a_réf; intake air relative humidity [%]"
T_c_ref = 24.85   "T_c_réf; coolant temperature [°C] (298 K in the original)"
p_w_s_ref = pressure(STEAM,T=T_a_ref,x=1)   "p_w_s_réf; saturation pressure of water vapour at the reference temperature [Pa]"
T_ref = 273.15   "T_réf; K/°C offset used for the absolute temperatures of the correction factor [K]"

"Engine derating (see the table of the standard for the factor a and the exponents m, n and s)"
alpha = K-0.7*(1-K)*(1/eta_m-1)
K = ((p_atm_x - a*(phi_a_x/100)*p_w_s_x)/(p_atm_ref - a*(phi_a_ref/100)*p_w_s_ref))^m*((T_a_ref+T_ref)/(T_a_x+T_ref))^n*((T_c_ref+T_ref)/(T_c_x+T_ref))^s   "absolute temperatures [K]"

"Engine power in the reference conditions"
W_dot_sh_x = 372E3   "site shaft power [W] (372 kW in the original)"
altitude = 400   "[m]"
p_atm_x = patm(altitude)   "atmospheric pressure on site [Pa]"
phi_a_x = 80   "relative humidity of the intake air [%]"
eta_m = 0.85   "mechanical efficiency [-]"
T_a_x = 45   "intake air temperature [°C]"
p_w_s_x = pressure(STEAM,T=T_a_x,x=1)   "saturation pressure of water vapour at T_a_x [Pa]"
"Naturally aspirated Diesel - power limited by the excess air according to ISO 3046/1"
T_c_x = T_a_x   "just to give this variable a value since the engine is not supercharged (as in the original)"
a = 1   "factor of the ISO 3046/1 table [-]"
m = 1   "exponent of the ISO 3046/1 table [-]"
n = 0.75   "exponent of the ISO 3046/1 table [-]"
s = 0   "exponent of the ISO 3046/1 table [-]"
{"Influence of the humidity of the air"
Test_ref = (phi_a_ref/100)*p_w_s_ref
Test_x = (phi_a_x/100)*p_w_s_x}   "as in the original (commented out)"
