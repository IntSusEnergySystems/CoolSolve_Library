{=============================================================================
  Engine data-sheet coherence check and ISO 3046-type derating (worked example)
  CoolSolve Library model CSL-0273
 -----------------------------------------------------------------------------
  Worked example from the ULiège MCI course (instructor solution, tag "RD"):
  a 5-cylinder diesel engine data sheet is checked for internal coherence
  (swept volume, mean piston speed, shaft power from the torque, charge-air
  cooler duty, exhaust flow); thermal efficiency, excess air, volumetric and
  compressor isentropic efficiencies are computed; finally the engine is
  derated to the site conditions of Lac Victoria (ISO 3046-type correction
  factor K, charge-air-cooled exponents m = 0.7 and n = 1.2) and its CO2
  emissions per distance are estimated. Equations as in the original; units
  already SI (degC, Pa, J) - see README.md.

  Inputs : engine data-sheet values (bore d, stroke L, speed N, torque C, ...)
  Outputs: V_s, C_m, W_dot_gr, eta_mot, e, epsilon_v, epsilon_s_cp,
           W_dot_victoria, alpha_detarage, emission_CO2
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, "Moteurs à combustion interne" (MCI), June 2019 exam
           solution by R. Dickes (file resolultion_RD.EES) - see README.md
============================================================================}

"Data coherence"

"! a. Swept volume (cylinder capacity)"
n_s = 5                  "number of cylinders [-]"
d = 0.13                 "bore [m]"
L = 0.14                 "stroke [m]"
V_s = n_s*pi*d^2/4*L     "computed total swept volume [m^3]"
V_s_data = 9.3/1000      "data-sheet swept volume [m^3] (9.3 L in the original)"

"! b. Mean piston speed"
C_m = 2*L*N/60           "computed mean piston speed [m/s]"
C_m_data = 9.8           "data-sheet mean piston speed [m/s]"

"! c. Shaft power"
C = 1337                 "torque [N.m]"
N = 2100                 "engine speed [rpm]"
W_dot_gr_data = 294000   "data-sheet gross shaft power [W] (294 kW in the original)"
W_dot_gr = C*2*pi*N/60   "shaft power computed from the torque [W]"

"! d. Charge-air cooler duty (air cooling power)"
T_air_ic_su = 165        "charge-air cooler air inlet temperature [°C]"
T_air_ic_ex = 47         "charge-air cooler air outlet temperature [°C]"
m_dot_air = 25/60        "intake air mass flow rate [kg/s] (25 kg/min in the original)"
Q_dot_air = m_dot_air*cp('air', T=0.5*T_air_ic_su +0.5*T_air_ic_ex)*(T_air_ic_su-T_air_ic_ex)  "charge-air cooler duty [W]"
Q_dot_air_data = 49000   "data-sheet charge-air cooler duty [W] (49 kW in the original)"

"! e. Exhaust gas flow"
c_spec = 209/1000/3600   "specific fuel consumption [g/J] (209 g/kWh in the original)"
m_dot_fuel = c_spec*W_dot_gr_data/1000  "fuel mass flow rate [kg/s]"
m_dot_ex = m_dot_air  +  m_dot_fuel     "exhaust gas mass flow rate [kg/s]"
m_dot_ex_data = 26/60    "data-sheet exhaust gas flow [kg/s] (26 kg/min in the original)"

"Questions"

"! a. Clearance (dead) volume fraction"
rv = 18                  "compression ratio [-]"
rv = V_bdc/V_tdc         "compression ratio (definition) [-]"
V_tdc = V_c              "clearance (dead) volume [m^3]"
V_bdc = V_s/n_s+V_c      "cylinder volume at BDC [m^3]"
rel_vc = V_c/V_bdc       "clearance volume fraction [-]"

"! b. Design parameters"
L_star = L/D             "L/d, EES names being case-insensitive D = d the bore [-]"
N_star = N/60*(W_dot_gr_data/n_s)^0.5  "design parameter of the original (as in the original)"

"! c. Engine thermal efficiency"
eta_mot = W_dot_gr_data/(m_dot_fuel*PCI)  "thermal efficiency from the fuel consumption [-]"
eta_mot_bis = W_dot_gr_data/(W_dot_gr_data + Q_dot_coolant + Q_dot_exhaust + Q_dot_env)  "thermal efficiency from the heat balance [-]"
Q_dot_coolant = 226*1000  "coolant heat flow [W] (226 kW in the original)"
Q_dot_exhaust = 204*1000  "exhaust heat flow [W] (204 kW in the original)"
Q_dot_env = 15*1000       "environment heat flow [W] (15 kW in the original)"
PCI = (42.7*1+0.05)*1000000  "lower heating value of the fuel [J/kg]"

"! d. Energy-balance residual"
res_bilan = (m_dot_fuel*PCI -(W_dot_gr_data + Q_dot_coolant + Q_dot_exhaust + Q_dot_env) )/m_dot_fuel/PCI  "residual of the heat balance [-]"

"! e. Excess air"
m_c = 12                 "number of carbon atoms of the fuel (CmHn) [-]"
n_h = 26                 "number of hydrogen atoms of the fuel (CmHn) [-]"
f = m_dot_fuel/m_dot_air "fuel-air ratio [-]"
f_st = (12*m_c+n_h)/((m_c+n_h/4)*(32+79/21*28))  "stoichiometric fuel-air ratio of CmHn [-]"
f_st/f = (1+e)           "excess air ratio (1 + excess air e) [-]"

"! f. Engine volumetric efficiency"
i = 0.5                  "coefficient of the original (as in the original) [-]"
epsilon_v = m_dot_air/(m_dot_air_th)  "volumetric efficiency (definition) [-]"
m_dot_air_th = i*n_s*pi*d^2/4*L*N/60*rho_air_su  "theoretical intake air mass flow rate [kg/s]"
rho_air_su = density(air, T=T_air_su, P = P_air_su)  "intake air density [kg/m^3]"
T_air_su = 25            "intake air temperature [°C]"
P_air_su = 1e5           "intake air pressure [Pa]"

"! g. Compressor isentropic efficiency"
T_ex_cp = T_air_ic_su    "compressor outlet temperature (intercooler inlet) [°C]"
T_su_cp =T_air_su        "compressor inlet temperature [°C]"
p_su_cp = P_air_su       "compressor inlet pressure [Pa]"
p_ex_cp= 2.5e5								"!compressor outlet pressure [Pa]; negligible pressure drop in the intercooler and intake ducts"
h_su_cp = enthalpy(AIR,T=T_su_cp)  "compressor inlet enthalpy [J/kg]"
h_ex_cp = enthalpy(AIR,T=T_ex_cp)  "compressor outlet enthalpy [J/kg]"
s_su_cp = entropy(AIR,T=T_su_cp, P=p_su_cp)  "compressor inlet entropy [J/(kg.K)]"
s_ex_cp_s = s_su_cp							"isentropic compression [J/(kg.K)]"
h_ex_cp_s = enthalpy(AIR,s=s_ex_cp_s, P=p_ex_cp)	"computation of h_ex_cp_s [J/kg]"
T_ex_cp_s = temperature(AIR,s=s_ex_cp_s, P=p_ex_cp)  "isentropic compressor outlet temperature [°C]"
epsilon_s_cp =(h_ex_cp_s-h_su_cp)/(h_ex_cp-h_su_cp)  "compressor isentropic efficiency [-]"

"Site derating (Lac Victoria, as in the original)"
eta_m = 0.85             "mechanical efficiency [-]"
h = 1133                 "site altitude [m]"
P_victoria = (101.249-0.0118062*h+4.72681e-7*h^2)*1000  "site atmospheric pressure [Pa] (barometric formula of the original, kPa x1000)"
T_victoria = 30 +273.15  "site ambient temperature [K] (30 °C in the original)"
P_ref = 100000           "reference atmospheric pressure [Pa]"
T_ref = 298              "reference ambient temperature [K]"
W_dot_victoria = W_dot_gr_data*alpha_detarage  "derated shaft power on site [W]"
alpha_detarage = K-(0.7*(1-K)*(1/eta_m - 1))  "ISO 3046-type derating factor [-]"
K = ((P_victoria/P_ref)^m_det)*((T_victoria/T_ref)^n_det)  "correction factor of the pressure and temperature ratios [-]"
m_det =0.7               "pressure exponent (charge-air-cooled engine) [-]"
n_det = 1.2              "temperature exponent (charge-air-cooled engine) [-]"

rho_air_su_victoria = density(air, T=T_victoria-273.15, P = P_victoria)  "site intake air density [kg/m^3]"
m_dot_fuel_victoria = f*m_dot_air_victoria  "site fuel mass flow rate [kg/s]"
m_dot_air_victoria =epsilon_v* i*n_s*pi*d^2/4*L*N/60*rho_air_su_victoria  "site intake air mass flow rate [kg/s]"
m_dot_CO2_victoria = m_dot_fuel_victoria*MolarMass(CO2)/(12*MolarMass(C)+26*MolarMass(H))*1000 "site CO2 mass flow rate [g/s] (molar masses of the fuel species C and H)"

emission_CO2 = m_dot_CO2_victoria/(25*1.852/3600)  "CO2 emissions per distance [g/km] (ship speed 25 knots; as in the original)"
