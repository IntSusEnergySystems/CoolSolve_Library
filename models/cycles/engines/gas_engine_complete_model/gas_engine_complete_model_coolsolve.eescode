{=============================================================================
  Complete gas engine: throttle, carburettor, intake pressure drop, adiabatic
  combustion chamber, expansion, cooling water circuit and two recovery heat
  exchangers (exercises 1 to 5 of the original file)
  CoolSolve Library model CSL-0149, runnable CoolSolve VARIANT
 -----------------------------------------------------------------------------
  Same model as the native CSL-0149 file (see it and README.md); details of
  the two changes in the status line below.
  Source  : ULiege MSTh repetition TP 08 Ex 1-5 - J. Lebrun, V. Lemort,
            S. Bertagnolio (ULiege), MIT - ~/Nextcloud/thermo_models/
            machines et systemes thermiques/MSTh - Repetitions/TP 08/SB/
            MSTH-SB-R8-EX1-2-3-4-5.EES (TM-0136)
  Units   : SI - temperatures in C, pressures in Pa, energies in J
  Status  : runnable VARIANT of the native CSL-0149 file; only changes (all
            else identical, incl. variable names): 1. INTERPOLATE in
            CoolSolve positional form (CoolSolve-only syntax, CS-GAP-INTERP-EES),
            2. the two cpbar calls in the valid-EES CALL form (CoolSolve
            refuses the function form with the five-output PROCEDURE).
            Verified against the stored EES solution - see README.md.
 =============================================================================}
{--- Library functions copied from CSL-0005 (cpbar_combustion_products) ---
  Copied verbatim (P. Ngendakumana, ULiege 2003) until
  $INCLUDE library:cpbar_combustion_products is available (CS-FEAT-IMPORT).
  The original calls cpbar in function position; the library routine is the
  five-output PROCEDURE, called with CALL as in CSL-0034.}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2,T=T_p2))*MM_CO2
h_CO = (enthalpy(CO,T=T_p1)-enthalpy(CO,T=T_p2))*MM_CO
h_H2O =(enthalpy(H2O,T=T_p1)-enthalpy(H2O,T=T_p2))*MM_H2O
h_N2 = (enthalpy(N2,T=T_p1)-enthalpy(N2,T=T_p2))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_p1-T_p2)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2, T=T_p2))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_p1)-enthalpy(H2O, T=T_p2))*MM_H2O
hp_3 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
hp_4 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_p1-T_p2)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
ha_2 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_p1-T_p2)
ENDIF

END

{--- End of the library functions copied from CSL-0005 ---}

"New parameters"
AU_gw=83.8           "jacket conductance product (gas to cooling water) [W/K]"
AU_wenv=127.4        "water-to-environment conductance product [W/K]"
A_soupapes=0.001477  "total valve area, in V_dot_3 = A_soupapes*C_3 [m^2]"
eta_in_actif=0.3282  "actual indicated efficiency [-]"
T_m=39.79            "friction torque [N.m]"

"!Stand-by regime (exercise 1): throttling pressure drop read in the engine
 map lookup_1 (DELTAP_throttling vs W_dot_sh) at W_dot_sh = 0. Other operating
 points of the original, kept as inactive strings: DELTAP_throttling =
 DELTAP_throttling_stb (stand-by operation). At the maximum-power point below
 the throttle is wide open, DELTAP_throttling = 0."
DELTAP_throttling_stb=INTERPOLATE('lookup_1','W_dot_sh','DELTAP_throttling',0)   "CoolSolve positional form; native EES form:
 DELTAP_throttling_stb=INTERPOLATE('lookup_1','DELTAP_throttling','W_dot_sh',W_dot_sh=0) (CS-GAP-INTERP-EES)"

"!Maximum-power operating point (exercises 2 to 5)"
i=1/2                "working cycles per revolution (1/2: four-stroke) [-]"
ncV_s=5E-3           "engine displacement [m^3]"
f=0.055              "fuel-air ratio [kg/kg]"
M_dot_f=f*M_dot_a    "fuel mass flow rate [kg/s]"
P_atm=101325         "atmospheric pressure [Pa]"
rpm=2400             "engine speed [rpm] (inactive alternative in the original: rpm=500)"
N=rpm/60             "rotation rate [1/s]"
M_dot_w=0.9          "cooling water mass flow rate [kg/s]"
T_w_su=60            "cooling water supply temperature [C]"
M_dot_f=M_dot_f_kgh/3600   "fuel mass flow rate [kg/s] (inactive alternative
 in the original: M_dot_f_kgh=22, a fuel consumption imposed instead of f)"
LHV_f=50E6           "fuel lower heating value [J/kg]"
"Inactive alternatives of the original (other test points): W_dot_sh=90E3,
 Q_dot_gw=90E3, W_dot_m=10E3, Q_dot_wenv=8E3, T_1=0"

"!Model"
T_1=20               "ambient air temperature [C]"
P_1=P_atm            "ambient pressure [Pa]"

"1) Butterfly valve - charge control"
P_2=P_1-DELTAP_throttling  "pressure after the throttle [Pa]"
DELTAP_throttling=0        "full load: wide-open throttle, as in the original"

"2) Carburettor: air-fuel mixture"
M_dot_p=M_dot_a+M_dot_f    "charge (mixture) mass flow rate [kg/s]"
T_2=T_1                    "the fuel evaporates at the air temperature, as in the original"

"3) Pressure drop 2-3"
c_p_23*(T_2-T_3)=C_3^2/2   "kinetic-energy balance at the valve [J/kg]"
T_3=TEMPERATURE(Air,s=s_2,P=P_3)  "temperature at state 3, isentropic path from state 2 [C]"
s_2=ENTROPY(Air,T=T_2,P=P_2)      "specific entropy of the charge at state 2 [J/kg-K]"
c_p_23=CP(Air,T=T_23)             "mean specific heat of the charge [J/kg-K]"
T_23=(T_2+T_3)/2                  "mean temperature of states 2 and 3 [C]"
V_dot_3=M_dot_p*v_3               "volume flow rate at state 3 [m^3/s]"
v_3=VOLUME(Air,T=T_3,P=P_3)       "specific volume at state 3 [m^3/kg]"
V_dot_3=A_soupapes*C_3            "gives the velocity C_3 at the valves [m/s]"

"4) Cylinder inlet"
P_4=P_3                    "pressure at state 4 [Pa]"
V_dot_4=M_dot_p*v_4        "volume flow rate at state 4 [m^3/s]"
V_dot_4=V_dot_s            "equal to the swept volume flow rate [m^3/s]"
V_dot_s=i*N*ncV_s          "swept volume flow rate of the engine [m^3/s]"
v_4=VOLUME(Air,T=T_4,P=P_4)  "specific volume at state 4 [m^3/kg]"
T_4=T_2                    "temperature at state 4 [C]"

"5) Adiabatic combustion chamber"
Q_dot_1+Q_dot_2+Q_dot_3+Q_dot_4+Q_dot_5=0   "energy balance of the chamber [W]"
T_ref=25                  "reference temperature of the combustion [C]"
Q_dot_1=M_dot_a*cp_a*(T_ref-T_5)   "heat received by the air [W]"
cp_a=CP(Air,T=T_5)                 "specific heat of the air [J/kg-K]"
Q_dot_2=M_dot_f*cp_f*(T_ref-T_5)   "heat received by the fuel [W]"
cp_f=CP(CH4,T=T_5)                 "specific heat of the fuel [J/kg-K]"
T_5=T_4                  "temperature at state 5 [C]"
Q_dot_3=-M_dot_f*LHV_f   "power released by the fuel [W]"
Q_dot_4=0                "unburned-CO loss [W] (air excess, as in the original)"
Q_dot_5=M_dot_p*cp_p*(T_6-T_ref)   "enthalpy of the combustion products [W]"
CALL cpbar(m_f,n_f,f,T_ref,T_6:cp_p,Q_4_a,x_a,e_min_a,e_a)  "mean specific heat
 of the products between 25 C and the flame temperature t_6 [J/kg-K]"
m_f=1                    "C of the CmHn fuel [-]"
n_f=4                    "H of the CmHn fuel [-]"
P_6=P_4                  "pressure at state 6 [Pa]"

"6) Energy converter"
W_dot_sh=M_dot_p*cp_p_67*(T_6-T_7)  "shaft power from the expansion of the products [W]"
CALL cpbar(m_f,n_f,f,T_6,T_7:cp_p_67,Q_4_67,x_67,e_min_67,e_67)  "mean specific heat
 of the products between t_6 and t_7 [J/kg-K]"
W_dot_in=W_dot_sh+W_dot_m+W_dot_pumping  "indicated power [W]"
W_dot_pumping=V_dot_s*(P_1-P_4)          "pumping power [W]"
"As in the original: approximate pumping power of exercise 3 (unused here),
 W_dot_pumping_bis = W_dot_pumping_ref*(N/N_ref)^3 with W_dot_pumping_ref = 269.1 W"
W_dot_pumping_bis=W_dot_pumping_ref*(N/N_ref)^3
N_ref=2400/60           "reference rotation rate [1/s]"
W_dot_pumping_ref=269.1 "reference pumping power [W]"
W_dot_m=2*PI*N*T_m      "friction power [W]"
eta_in_actif=W_dot_in/Q_dot_c  "indicated efficiency (balance, = input) [-]"
eta_sh=W_dot_sh/Q_dot_c        "shaft efficiency [-]"
Q_dot_c=M_dot_f*LHV_f   "fuel power [W]"
sfc=M_dot_f/W_dot_sh*1E7  "specific fuel consumption, as defined in the original"

"7) Gas-to-water (jacket) exchanger"
Q_dot_gw=M_dot_p*cp_p_78*(T_7-T_8)  "power given up by the products [W]"
"cp_p_78=cpbar(m_f,n_f,f,T_7,T_8) is present as an inactive comment in the
 original; cp_p_78 keeps its provisional constant value, as in the original"
cp_p_78=1300            "mean specific heat of the products, provisional value [J/kg-K]"
Q_dot_gw=M_dot_w*cp_w_gw*(T_w_ex-T_w_su)  "same power, water side [W]"
T_w_gw_m=(T_w_ex+T_w_su)/2   "mean water temperature in the jacket [C]"
cp_w_gw=4187            "specific heat of the water, provisional value [J/kg-K]"
Q_dot_gw=epsilon_gw*C_dot_min_gw*(T_7-T_w_su)  "eps-NTU definition of the jacket [W]"
C_dot_min_gw=min(C_dot_w_gw,C_dot_p_78)  "minimum heat capacity rate [W/K]"
C_dot_w_gw=M_dot_w*cp_w_gw   "heat capacity rate of the water [W/K]"
C_dot_p_78=M_dot_p*cp_p_78   "heat capacity rate of the products [W/K]"
epsilon_gw=(1-exp(-NTU_gw*(1-omega_gw)))/(1-omega_gw*exp(-NTU_gw*(1-omega_gw)))
                            "cross-flow effectiveness, as in the original [-]"
omega_gw=C_dot_min_gw/C_dot_max_gw  "heat capacity rate ratio [-]"
C_dot_max_gw=max(C_dot_p_78,C_dot_w_gw)  "maximum heat capacity rate [W/K]"
NTU_gw=AU_gw/C_dot_min_gw   "number of transfer units of the jacket [-]"

"8) Water-to-ambient exchanger"
Q_dot_wenv=M_dot_w*cp_w_wenv*(T_w_ex-T_w_ex_1)  "power lost by the water [W]"
cp_w_wenv=CP(Water,T=T_w_wenv_m,P=P_atm)  "specific heat of the water [J/kg-K]"
T_w_wenv_m=(T_w_ex+T_w_ex_1)/2  "mean water temperature in the exchanger [C]"
Q_dot_wenv=epsilon_wenv*C_dot_min_wenv*(T_w_ex-T_env)  "eps-NTU definition [W]"
T_env=20                "ambient temperature [C]"
epsilon_wenv=1-exp(-NTU_wenv)  "effectiveness (one fluid at constant temperature) [-]"
C_dot_min_wenv=M_dot_w*cp_w_wenv  "heat capacity rate of the water [W/K]"
NTU_wenv=AU_wenv/C_dot_min_wenv   "number of transfer units [-]"

"!Exercise 5"
"9) First recovery exchanger: water-water"
"Original comment: the return temperature T_w_recup_su is kept (cf. table);
 the original notes numerical instabilities and proceeds this way"
M_dot_w_recup=3.16      "recovery water mass flow rate [kg/s]"
Q_dot_recup_1=M_dot_w_recup*cp_w*(T_w_recup_ex_1-T_w_recup_su)  "power received
 by the recovery water [W]"
cp_w=4187               "specific heat of the water [J/kg-K]"
Q_dot_recup_1=epsilon_recup*C_dot_min_recup_1*(T_w_ex_1-T_w_recup_su)  "eps-NTU
 definition, hot side the jacket water [W]"
Q_dot_recup_1=M_dot_w*cp_w*(T_w_ex_1-T_w_ex_2)  "same power, cooled jacket water [W]"
epsilon_recup=0.75      "effectiveness of the recovery exchangers [-]"
C_dot_min_recup_1=min(C_dot_recup,(M_dot_w*cp_w))  "minimum heat capacity rate [W/K]"
C_dot_recup=M_dot_w_recup*cp_w  "heat capacity rate of the recovery water [W/K]"

"10) Second recovery exchanger: water-gas"
T_w_recup_ex_2=80       "target temperature of the recovery water [C]"
Q_dot_recup_2=M_dot_w_recup*cp_w*(T_w_recup_ex_2-T_w_recup_ex_1)  "power received
 by the recovery water [W]"
Q_dot_recup_2=epsilon_recup*C_dot_min_recup_2*(T_8-T_w_recup_ex_1)  "eps-NTU
 definition, hot side the products [W]"
C_dot_min_recup_2=min(C_dot_recup,(M_dot_p*cp_p_78))  "minimum heat capacity rate [W/K]"

Q_dot_recup_1+Q_dot_recup_2=Q_dot_recup  "total recovered power [W]"
