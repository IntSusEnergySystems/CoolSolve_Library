{=============================================================================
  R22 heat pump with a semi-hermetic compressor model
  CoolSolve Library model CSL-0033
 -----------------------------------------------------------------------------
  Heat pump (R22) whose compressor is a semi-hermetic (enclosed) reciprocating
  machine. As in the original, the machine is described by:
    - a volumetric efficiency with a clearance factor:
        epsilon_v = 1 - C*(r_v - 1)   with r_v = v_su/v_ex the volume ratio of the
      isentropic compression, and V_dot_su = epsilon_v*V_dot_s, the swept
      volume flow rate V_dot_s being a catalogue value;
    - a semi-hermetic energy balance: the electromechanical losses
        W_dot_loss = W_dot_loss_0 + alpha*W_dot_in
      do not leave the machine but reheat the incoming fresh charge, so the
      refrigerant enters the compression at h_su_1 instead of h_su;
    - an isentropic internal compression from that state to the condensing
      pressure, giving the electrical power
        W_dot = W_dot_loss + W_dot_in = W_dot_loss_0 + (1 + alpha)*W_dot_in.
  The evaporator and the condenser are semi-isothermal (isothermal on the
  refrigerant side) heat exchangers rated by the effectiveness-NTU method
  against a water flow rate, with prescribed overall conductances AU_ev and
  AU_cd; the cycle closes on the saturation pressures of T_ev and T_cd, on
  5 K of superheat at the evaporator outlet, 3 K of subcooling at the
  condenser outlet and an isenthalpic expansion.

  Inputs : W_dot_loss_0, alpha, C, V_dot_s (compressor);
           AU_ev, AU_cd, M_dot_w_ev, M_dot_w_cd, T_w_ev_ex, T_w_cd_su,
           DELTAT_oh, DELTAT_sc (secondary circuits)
  Outputs: COP, Q_dot_ev (= Q_dot_u), Q_dot_cd, W_dot_cp (= Q_dot_c),
           M_dot_r, T_ev, T_cd, epsilon_s (global isentropic efficiency)
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, course "Machines et systèmes thermiques", exercise session 10,
           exercise 1 (EES file MSTH-SB-R10-EX1.EES, SB solution) - see README.md
=============================================================================}

"Compressor data"
W_dot_loss_0 = 1294              "constant electromechanical losses of the machine [W]"
alpha = 0.228                   "loss factor proportional to the internal power [-]"
C = 0.125                       "clearance factor (dead volume) [-]"
V_dot_s = 0.0233                "swept volume flow rate of the compressor [m^3/s]"

"Heat exchanger and secondary circuit data"
AU_ev = 7000                    "overall conductance of the evaporator [W/K]"
AU_cd = 15000                   "overall conductance of the condenser [W/K]"
M_dot_w_ev = 2.4                "water flow rate of the evaporator [kg/s]"
M_dot_w_cd = 2.2                "water flow rate of the condenser [kg/s]"
T_w_ev_ex = 10                  "evaporator water outlet temperature [°C]"
DELTAT_oh = 5                   "superheating at the evaporator outlet [K]"
T_w_cd_su = 40                  "condenser water inlet temperature [°C]"
DELTAT_sc = 3                   "subcooling at the condenser outlet [K]"

"Results (as in the original)"
Q_dot_u = Q_dot_ev              "useful heat output = evaporator duty [W]"
Q_dot_c = W_dot_cp              "power consumed by the compressor [W]"
COP = Q_dot_u/Q_dot_c           "coefficient of performance [-]"

"!Energy balance of the machine"
Q_dot_ev + W_dot_cp = Q_dot_cd  "refrigeration energy balance: cooling + power = heat delivered"

P_ev = PRESSURE(R22, T=T_ev, x=0.5)   "evaporation pressure (phase-change plateau) [Pa]"
P_cd = PRESSURE(R22, T=T_cd, x=0.5)   "condensation pressure (phase-change plateau) [Pa]"

h_1 = ENTHALPY(R22, T=T_ev+DELTAT_oh, x=1)  "evaporator outlet, saturated vapour [J/kg]"
h_3 = ENTHALPY(R22, T=T_cd-DELTAT_sc, x=0)  "condenser outlet, subcooled liquid [J/kg]"
h_4 = h_3                              "isenthalpic expansion (throttling valve)"
Q_dot_ev = M_dot_r*(h_1 - h_4)         "evaporator duty on the refrigerant side [W]"

"!Compressor model (semi-hermetic: the losses reheat the fresh charge)"
W_dot_loss = Q_dot_rech         "the losses of the machine heat the incoming refrigerant"
Q_dot_rech = M_dot_r*(h_su_cp_1 - h_su_cp)
h_su_cp = ENTHALPY(R22, T=T_su_cp, P=P_su_cp)   "compressor inlet, before the losses [J/kg]"

{Alternative written by the author but not solved in the original:
 constant specific heat of the vapour for the reheat:
 Q_dot_rech=M_dot_r*cp_r*(T_su_cp_1-T_su_cp)
 cp_r=CP(R22,T=T_su_cp,x=1)}

r_v_1 = v_su_1/v_ex_1                    "volume ratio of the isentropic compression [-]"
v_su_1 = VOLUME(R22, T=T_su_cp_1, P=P_su_cp)   "specific volume at the compressor inlet [m^3/kg]"
v_ex_1 = VOLUME(R22, h=h_ex_cp_s_1, P=P_ex_cp)  "specific volume at the isentropic exhaust [m^3/kg]"
epsilon_v_1 = 1 - C*(r_v_1 - 1)          "volumetric efficiency (definition) [-]"

epsilon_v_1 = V_dot_su_1/V_dot_s         "volumetric efficiency (definition) [-]"
V_dot_su_1 = M_dot_r*v_su_1              "flow rate actually drawn at the compressor inlet [m^3/s]"

W_dot_cp = W_dot_loss + W_dot_in         "electrical power consumption [W]"
W_dot_loss = W_dot_loss_0 + alpha*W_dot_in   "loss model of the machine [W]"

W_dot_in = M_dot_r*(h_ex_cp_s_1 - h_su_cp_1)   "isentropic compression power [W]"
h_su_cp_1 = ENTHALPY(R22, T=T_su_cp_1, P=P_su_cp)   "compressor inlet, after the reheat [J/kg]"
h_ex_cp_s_1 = ENTHALPY(R22, s=s_su_1, P=P_cd)       "isentropic compressor exhaust [J/kg]"
s_su_1 = ENTROPY(R22, T=T_su_cp_1, P=P_su_cp)       "suction state after the reheat [J/kg-K]"

T_su_cp = T_ev+DELTAT_oh   "suction temperature = evaporation temperature + superheat [°C]"
P_su_cp = P_ev            "suction pressure = evaporation pressure [Pa]"
P_ex_cp = P_cd            "exhaust pressure = condensation pressure [Pa]"

{Alternative of the original (commented out there as well): compressor model
 without the semi-hermetic design, i.e. the fresh charge is not reheated and
 the machine is adiabatic. Kept as in the original:
 epsilon_v=1-C*(r_v-1)
 r_v=v_su/v_ex
 v_su=VOLUME(R22,T=T_su_cp,P=P_su_cp)
 v_ex=VOLUME(R22,h=h_ex_cp_s,P=P_ex_cp)
 epsilon_v=V_dot_su/V_dot_s
 V_dot_su=M_dot_r*v_su
 W_dot_cp=W_dot_loss+W_dot_in
 W_dot_loss=W_dot_loss_0+alpha*W_dot_in
 W_dot_in=M_dot_r*(h_ex_cp_s-h_su_cp)
 h_su_cp=h_1
 h_ex_cp_s=ENTHALPY(R22,s=s_su,P=P_cd)
 s_su=ENTROPY(R22,T=T_su_cp,x=1)}

"!Evaporator (semi-isothermal: the refrigerant side is isothermal)"
Q_dot_ev = M_dot_w_ev*cp_w_ev*(T_w_ev_su - T_w_ev_ex)   "duty on the water side [W]"
cp_w_ev = CP(Water, T=T_w_ev_m, P=P_atm)                "water specific heat at the mean temperature [J/kg-K]"
T_w_ev_m = (T_w_ev_su+T_w_ev_ex)/2                      "mean water temperature of the evaporator [°C]"
P_atm = 101325                                          "atmospheric pressure of the secondary circuits [Pa]"

Q_dot_ev = epsilon_ev*C_dot_min_ev*(T_w_ev_su - T_ev)   "semi-isothermal exchanger: isothermal on the refrigerant side, infinite cp there"
C_dot_min_ev = M_dot_w_ev*cp_w_ev                       "water capacity rate (minimum side) [W/K]"
epsilon_ev = 1 - exp(-NTU_ev)                           "effectiveness of the evaporator [-]"
NTU_ev = AU_ev/C_dot_min_ev                             "number of transfer units of the evaporator [-]"

"!Condenser (semi-isothermal: the refrigerant side is isothermal)"
Q_dot_cd = M_dot_w_cd*cp_w_cd*(T_w_cd_ex - T_w_cd_su)   "duty on the water side [W]"
cp_w_cd = CP(Water, T=T_w_cd_m, P=P_atm)                "water specific heat at the mean temperature [J/kg-K]"
T_w_cd_m = (T_w_cd_su+T_w_cd_ex)/2                      "mean water temperature of the condenser [°C]"

Q_dot_cd = epsilon_cd*C_dot_min_cd*(T_cd - T_w_cd_su)   "semi-isothermal exchanger: isothermal on the refrigerant side, infinite cp there"
C_dot_min_cd = M_dot_w_cd*cp_w_cd                       "water capacity rate (minimum side) [W/K]"
epsilon_cd = 1 - exp(-NTU_cd)                           "effectiveness of the condenser [-]"
NTU_cd = AU_cd/C_dot_min_cd                             "number of transfer units of the condenser [-]"

"!Global isentropic efficiency of the compressor (result of interest)"
{Added from the companion questions file of the same exercise (thermo_models
 TM-0160, "R10 - SB - Ex 1.EES", where it reads h_ex_s/h_su/s_su); it has no
 effect on the results above. h_su is the compressor inlet before the losses.}
epsilon_s = M_dot_r*(h_ex_s - h_su)/W_dot_cp           "global isentropic efficiency [-]"
h_su = h_1                                             "compressor inlet before the losses (= evaporator outlet) [J/kg]"
h_ex_s = ENTHALPY(R22, s=s_su, P=P_cd)                  "isentropic exhaust from the evaporator outlet [J/kg]"
s_su = ENTROPY(R22, h=h_1, P=P_ev)                      "entropy at the evaporator outlet [J/kg-K]"

"!State points for the thermodynamic diagrams (post-processing, no effect on the results)"
{1: evaporator outlet, 2: compressor outlet (after the semi-hermetic reheat and
 the isentropic compression), 3: condenser outlet, 4: evaporator inlet.
 Use the arrays h[i]/P[i] or s[i]/T[i] with the "Overlay array path" option of
 the CoolSolve Diagram tab. Point 2 is also the state the reheat leads to
 (h_su_cp_1 at P_su_cp) before the compression.}
P[1] = P_ev
h[1] = h_1
T[1] = T_ev+DELTAT_oh
s[1] = s_su
P[2] = P_cd
h[2] = h_ex_cp_s_1
T[2] = TEMPERATURE(R22, h=h[2], P=P[2])
s[2] = s_su_1
P[3] = P_cd
h[3] = h_3
T[3] = T_cd-DELTAT_sc
s[3] = ENTROPY(R22, T=T[3], x=0)
P[4] = P_ev
h[4] = h_4
T[4] = TEMPERATURE(R22, h=h[4], P=P_ev)
s[4] = ENTROPY(R22, h=h[4], P=P_ev)