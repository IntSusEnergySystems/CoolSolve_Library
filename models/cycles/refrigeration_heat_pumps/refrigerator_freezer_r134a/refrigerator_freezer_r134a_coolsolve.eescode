{=============================================================================
  Domestic refrigerator-freezer on R134a: sizing of a two-evaporator cycle
  CoolSolve Library model CSL-0061
  -----------------------------------------------------------------------------
  Sizing of a domestic fridge-freezer running on R134a: 1.5 kW of refrigeration
  delivered at two evaporation temperatures (+3 °C and -20 °C), the useful
  effect split between the two compartments (2/3 for the freezer, 1/3 for the
  fridge), condensation at 35 °C. The cycle described in the original has one
  high pressure and two low pressures, hence two expansion valves and two
  evaporators, in six steps:
  1-2 compression in the compressor,
  2-3 condensation in the condenser,
  3-4 first expansion through a throttling valve,
  4-5 evaporation in the first evaporator (first useful effect, cools the fridge),
  5-6 second expansion through a throttling valve,
  6-1 second evaporation in the second evaporator (second useful effect, cools
      the freezer).
  The two low pressures give two phase-change temperatures and therefore two
  different useful effects (fridge + freezer). The thermodynamic states are
  numbered as in the original:
  1 compressor inlet, 2 condenser inlet, 3 condenser outlet,
  4 first evaporator inlet, 5 first evaporator outlet, 6 second evaporator inlet.
  As in the original, the fluid is assumed saturated vapour (x=1) at the
  compressor inlet and saturated liquid (x=0) at the condenser outlet, since
  the statement gives no superheat or subcooling.

  Inputs : Q_dot_cool, T_fridge, T_freezer, T_cd, eta_is_cp
  Outputs: T_ex_cp, m_dot_r, W_dot_cp, Q_dot_cd, V_dot_3, V_dot_5
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, course "Thermodynamique appliquée" (MECA0002), repetition
           session 8, exercise 3 (EES file R08_E03_2022.EES) - see README.md
  Variant: runnable transcription of refrigerator_freezer_r134a.eescode, which
           is blocked by CS-GAP-PROP-TH. The only change is the input pair of the
           three property calls of state 4: the original writes them with the
           (T,H) pair (T[4] known, h[4] isenthalpic), which CoolProp does not
           support; they are written here with the (P,H) pair, p[4] = P_sat(T[4])
           being the saturation pressure of the same state. No equation, no
           variable name and no input value is changed otherwise, and the file is
           still valid EES. See the README conversion log.
=============================================================================}

"!Data"
fluid$ = 'R134a'                "working fluid"
T_freezer = -20                "evaporation temperature of the 2nd (freezer) evaporator [°C]"
T_fridge = 3                   "evaporation temperature of the 1st (fridge) evaporator [°C]"
Q_dot_cool = 1500              "required refrigeration capacity [W] (1.5 kW in the original)"
Q_dot_freezer = Q_dot_cool/3*2 "useful effect of the freezer evaporator [W] (2/3 of the total)"
Q_dot_fridge = Q_dot_cool-Q_dot_freezer "useful effect of the fridge evaporator [W] (1/3 of the total)"
T_cd = 35                      "condensation temperature [°C]"
eta_is_cp = 0.75               "isentropic efficiency of the compressor [-]"

"!State 1: compressor inlet"
T[1] = T_freezer              "temperature [°C]"
x[1] = 1                      "quality [-] (assumption as in the original)"
h[1] = enthalpy(fluid$,T=T[1],x=x[1])  "specific enthalpy [J/kg]"
p[1] = pressure(fluid$,T=T[1],x=x[1])  "pressure [Pa]"
v[1] = volume(fluid$,T=T[1],x=x[1])    "specific volume [m^3/kg]"
s[1] = entropy(fluid$,T=T[1],x=x[1])   "specific entropy [J/kg-K]"

"!State 2: compressor outlet, condenser inlet"
"!The condensation temperature is known, hence also the condensation pressure."
p[2] = P_sat(fluid$,T=T_cd)  "condensing pressure [Pa] (887.5 kPa in the original)"

"!With the isentropic efficiency of the compressor, h[2] is determined."
h_2_is = enthalpy(fluid$,p=p[2],s=s[1])  "isentropic compression enthalpy at p[2] [J/kg]"
eta_is_cp = (h_2_is-h[1])/(h[2]-h[1])    "isentropic efficiency [-] (the same equation as in the native file)"

T[2] = temperature(fluid$,P=P[2],H=h[2]) "temperature [°C]"
v[2] = volume(fluid$,P=P[2],H=h[2])      "specific volume [m^3/kg]"
s[2] = entropy(fluid$,P=P[2],H=h[2])     "specific entropy [J/kg-K]"

"!State 3: condenser outlet"
p[3] = p[2]  "pressure [Pa] (assumption as in the original: no pressure drop in the condenser)"
x[3] = 0     "quality [-] (assumption as in the original)"
T[3] = T_cd  "temperature [°C] (assumption as in the original)"
h[3] = enthalpy(fluid$,T=T[3],x=x[3])    "specific enthalpy [J/kg]"
v[3] = volume(fluid$,T=T[3],x=x[3])      "specific volume [m^3/kg]"
s[3] = entropy(fluid$,T=T[3],x=x[3])     "specific entropy [J/kg-K]"

"!State 4: first evaporator inlet"
h[4] = h[3]  "isenthalpic expansion valve (first law, open system, no work and no heat transfer) [J/kg]"
T[4] = T_fridge "temperature [°C]"
p[4] = P_sat(fluid$,T=T[4])  "pressure [Pa] (326.2 kPa in the original): isobaric evaporator, pure fluid (the pressure depends on the temperature under the saturation dome)"

x[4] = quality(fluid$,P=p[4],H=h[4])  "quality [-] (input pair P,H: see the header)"
s[4] = entropy(fluid$,P=p[4],H=h[4])  "specific entropy [J/kg-K] (input pair P,H; see the header)"
v[4] = volume(fluid$,P=p[4],H=h[4])    "specific volume [m^3/kg] (input pair P,H; see the header)"

"!State 5: first evaporator outlet"
"!State 5 is set by the power ratio between the fridge compartment and the freezer:"
"!Q_dot_fridge = m_dot_r*(h[5]-h[4]) = Q_dot_cool*1/3 = m_dot_r*(h[1]-h[4])*1/3"
h[5] = h[4] + (h[1]-h[4])*1/3  "specific enthalpy [J/kg]"
p[5] = p[4]  "pressure [Pa] (isobaric evaporator)"
T[5] = temperature(fluid$,H=h[5],P=P[5]) "temperature [°C]"
x[5] = quality(fluid$,H=h[5],P=P[5])    "quality [-]"
s[5] = entropy(fluid$,H=h[5],P=P[5])    "specific entropy [J/kg-K]"
v[5] = volume(fluid$,H=h[5],P=P[5])     "specific volume [m^3/kg]"

"!State 6: second evaporator inlet"
T[6] = T[1]  "temperature [°C] (saturated liquid at the outlet, pure fluid)"
p[6] = p[1]  "pressure [Pa] (isobaric)"
h[6] = h[5]  "isenthalpic expansion valve [J/kg]"
x[6] = quality(fluid$,H=h[6],P=P[6]) "quality [-]"
s[6] = entropy(fluid$,H=h[6],P=P[6]) "specific entropy [J/kg-K]"
v[6] = volume(fluid$,H=h[6],P=P[6])  "specific volume [m^3/kg]"

"!Refrigerant flow rate"
m_dot_r = Q_dot_cool/(h[1]-h[4])  "kg/s (both evaporators lie between states 1 and 4; the only other elements are the isenthalpic expansion valves)"

W_dot_cp = m_dot_r*(h[2]-h[1])  "compressor power [W] (first law, open system, adiabatic compressor; positive since it is received by the system)"

Q_dot_cd = m_dot_r*(h[3]-h[2])  "condenser duty [W] (first law, open system, no work; negative since it is rejected by the system)"

"!Volumetric flow rates entering the two expansion valves"
V_dot_3 = m_dot_r*v[3]  "inlet of the first expansion valve (3->4) [m^3/s] (9.34 L/s in the original)"
V_dot_5 = m_dot_r*v[5]  "inlet of the second expansion valve (5->6) [m^3/s] (319.5 L/s in the original)"

T_ex_cp = T[2]  "temperature of the gas leaving the compressor [°C]"

"!State 7: state 1 repeated (cycle closure)"
T[7] = T[1]
p[7] = p[1]
h[7] = h[1]
x[7] = x[1]
s[7] = s[1]
v[7] = v[1]