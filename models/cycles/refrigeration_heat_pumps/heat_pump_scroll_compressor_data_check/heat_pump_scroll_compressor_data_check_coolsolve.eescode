{=============================================================================
  Scroll-compressor heat pump on R407C: data consistency check
  CoolSolve Library model CSL-0068
  -----------------------------------------------------------------------------
  A manufacturer of scroll compressors for heat pumps announces the performance
  of one operating point of its compressor (EES exercise of the ULiège
  repetition session 8): evaporation at 0 °C with 5 K of superheat at the
  suction, condensation at 50 °C with 4 K of subcooling, heating capacity
  6.30 kW, electrical power 1.81 kW, refrigerating capacity 4.60 kW, mass flow
  rate 30.9 g/s, swept volume 5.92 m3/h, refrigerant R407C. The model checks
  that these data are consistent and computes the global isentropic efficiency
  of the compressor.

  States, numbered as in the original:
  1 compressor inlet, 2 condenser inlet = compressor outlet, 3 condenser outlet,
  4 evaporator inlet.

  As in the original, the announced capacities and powers are the data of the
  exercise, while the mass flow rate M_dot, the swept volume V_dot_m3h and the
  compressor duties are computed from them: that is what makes the consistency
  check. The three lines in braces are the values announced by the
  manufacturer; EES does not count them as equations (its solution report
  numbers 38 equations, the braces among them not) and neither does CoolSolve.

  Inputs : T_ev, T_cd, DELTA_T_oh, DELTA_T_sc, Q_dot_cd, Q_dot_ev, W_dot_el
  Outputs: COP, M_dot, V_dot, V_dot_m3h, W_dot, W_dot_s, eta_el, epsilon_s_cp,
           epsilon_s_cp_glob, T_2, P_4, P[i], h[i], T[i], s[i]
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, "Machines et systèmes thermiques", repetition session 8,
           exercise 5 (header VL050415) - see README.md
  Variant: runnable transcription of heat_pump_scroll_compressor_data_check.eescode,
           which is blocked by CS-GAP-PROP-TH (CoolProp does not support the
           (T,H) input pair). The single change is the pressure of state 4: the
           native file asks for it with the (T,H) pair (T_ev known, h_4 known),
           which CoolProp rejects; here the same state is obtained with the
           (P,H) pair and the temperature, T_4 = TEMPERATURE(R407C,P=P_4,h=h_4),
           combined with T_4 = T_ev - one extra line and one extra (redundant,
           T_4 = 0 °C) variable. Every other equation, variable name and input
           value is unchanged and the file is still valid EES (no CoolSolve-only
           syntax). See the README conversion log.
=============================================================================}

"!Manufacturer data"
T_ev = 0                     "evaporation temperature [°C]"
T_cd = 50                    "condensation temperature [°C]"
Q_dot_cd = 6.3E3             "heating capacity announced by the manufacturer [W]"
Q_dot_ev = 4.6E3             "refrigerating capacity announced by the manufacturer [W]"
W_dot_el = 1.81E3            "electrical power input [W]"
DELTA_T_oh = 5               "superheat at the suction [K]"
DELTA_T_sc = 4               "subcooling at the condenser outlet [K]"
{COP = 3.48}                 "COP announced by the manufacturer [-]"
{M_dot = 30.9E-3}            "mass flow rate announced by the manufacturer [kg/s]: the original notes that one can choose to recompute the predicted flow rate and the swept volume V_dot_m3h"
{V_dot_m3h = 5.92}           "swept volume announced by the manufacturer [m3/h]"
COP = Q_dot_cd/W_dot_el      "the COP announced by the manufacturer is recovered at once"

"!Compressor inlet"
T_1 = T_ev+DELTA_T_oh        "compressor inlet temperature [°C]"
P_1 = PRESSURE(R407C,T=T_ev,x=1)   "pressure at the evaporation temperature, saturated vapour [Pa]"
s_1 = entropy(R407C,P=P_1,T=T_1)   "specific entropy at the compressor inlet [J/(kg*K)]"
rho_1 = density(R407C,P=P_1,T=T_1) "density at the compressor inlet [kg/m3]"

"!Condenser inlet = compressor outlet"
P_2 = PRESSURE(R407C,T=T_cd,x=1)   "pressure at the condensation temperature, saturated vapour [Pa]"
Q_dot_cd = M_dot*(h_2-h_3)         "condenser duty [W]"
T_2 = temperature(R407C,P=P_2,h=h_2) "compressor outlet temperature [°C]"
h_2_s = enthalpy(R407C,P=P_2,s=s_1)  "isentropic compressor outlet enthalpy [J/kg]"
h_3 = enthalpy(R407C,P=P_3,T=T_3)    "condenser outlet enthalpy [J/kg]"

epsilon_s_cp = (h_2_s-h_1)/(h_2-h_1) "isentropic efficiency of the compressor [-]"
W_dot = M_dot*(h_2-h_1)              "power delivered to the refrigerant by the compressor [W]"
W_dot_s = M_dot*(h_2_s-h_1)          "isentropic power of the compressor [W]"
eta_el = W_dot/W_dot_el               "electrical efficiency of the machine, fluid power over electrical power [-]"
epsilon_s_cp_glob = W_dot_s/W_dot_el  "global isentropic efficiency of the machine [-]"

"!Condenser outlet"
T_3 = T_cd-DELTA_T_sc           "condenser outlet temperature [°C]"
P_3 = PRESSURE(R407C,T=T_cd,x=0) "pressure at the condensation temperature, saturated liquid [Pa]"

"!Evaporator inlet"
h_4 = h_3                       "enthalpy at the evaporator inlet, unchanged from the condenser outlet [J/kg]"
h_1 = enthalpy(R407C,P=P_1,T=T_1) "enthalpy at the compressor inlet [J/kg]"
T_4 = TEMPERATURE(R407C,P=P_4,h=h_4) "temperature of the state of enthalpy h_4 at P_4 [°C] (replaces the (T,H) call of the native file)"
T_4 = T_ev                      "state 4 is the state of enthalpy h_4 at the evaporation temperature [°C]"
Q_dot_ev{_bis} = M_dot*(h_1-h_4)  "refrigerating capacity [W]"

"!Displacement (swept volume) calculation"
M_dot = V_dot*rho_1 "[kg/s]" "the compressor is a volumetric machine: at a given speed it always draws the same volumetric flow rate V_dot"
V_dot_m3h = 3600*V_dot "[m3/h]"

"!State points for the thermodynamic diagrams (library convention; T[i] and s[i] added on import)"
P[1] = P_1
h[1] = h_1
T[1] = T_1
s[1] = s_1

P[2] = P_2
h[2] = h_2
T[2] = T_2
s[2] = entropy(R407C,P=P_2,h=h_2)

P[3] = P_3
h[3] = h_3
T[3] = T_3
s[3] = entropy(R407C,P=P_3,T=T_3)

P[4] = P_4
h[4] = h_4
T[4] = T_ev
s[4] = entropy(R407C,P=P_4,h=h_4)