{=============================================================================
  Two-shaft gas turbine with a compressor map: runnable transcription
  CoolSolve Library model CSL-0011 - variant of
  two_shaft_gas_turbine_compressor_map.eescode
 -----------------------------------------------------------------------------
  The main file keeps the native EES syntax and does not run in CoolSolve. This
  transcription is identical to it, with three changes. This file is
  CoolSolve-only: it is not meant to be run in EES, because of change 1.

    1. the three INTERPOLATE calls are written in CoolSolve's positional form
       (x column, y column, abscissa) instead of the native EES form with a
       named argument - gap CS-GAP-INTERP-EES. This positional form is
       CoolSolve-only syntax and is not valid EES;
    2. the two calls of the cpbar PROCEDURE are written as CALL statements
       (this form is also valid EES), because CoolSolve does not accept the
       5-output cpbar of CSL-0005 inside an expression ("cannot be called as a
       function"). Only c_bar_p (the first output) is used by the model; the
       other outputs (Q_4 = 0, x = 1, e_min = 0, e) are diagnostics;
    3. the cpbar PROCEDURE and the gamma FUNCTION are copied from the library
       model CSL-0005 (gap CS-GAP-INCLUDE, until CS-FEAT-IMPORT provides
       $INCLUDE library:cpbar_combustion_products).

  No equation of the model itself was changed; the results reproduce the stored
  solution of the original EES file. See README.md.

  Inputs : p_1, t_1, N_design, t_1_design, N, LHV, the map lookup_1,
           M_r_exp1, M_r_exp2
  Outputs: M_dot_1, r_p, epsilon_s_cp, t_2, t_ex_burner, f, epsilon_s_exp1,
           t_4, p_4, w_cp, w_exp1
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, course "Machines et systèmes thermiques" (MECA0006), revision
           exercises of 2005-12-23 (JL), file "Revision JL051223-02.EES"
           - see README.md
  Status : VERIFIED against the EES stored solution of the source file
           (CoolSolve 0.3.0+fix/library-gaps)
=============================================================================}

{--- Library functions copied from CSL-0005 (cpbar_combustion_products) ---
  The block is closed after the gamma function; replace it by
  $INCLUDE library:cpbar_combustion_products once CS-FEAT-IMPORT is available.
  Only cpbar (PROCEDURE) and gamma (FUNCTION) are needed by this model.}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2,T=T_p2))*MM_CO2
h_CO = (enthalpy(CO,T=T_p1)-enthalpy(CO,T=T_p2))*MM_CO
h_H2O =(enthalpy(H2O,T=T_p1)-enthalpy(H2O,T=T_p2))*MM_H2O
h_N2 = (enthalpy(N2,T=T_p1)-enthalpy(N2,T=T_p2))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_p1-T_p2)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2, T=T_p2))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_p1)-enthalpy(H2O, T=T_p2))*MM_H2O
hp_3 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
hp_4 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_p1-T_p2)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
ha_2 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_p1-T_p2)
ENDIF

END

FUNCTION gamma (m,n,f,T_p1,T_p2)

{GAMMA  function returns the specific heats ratio of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of
fuel (m and n), the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2)
in °C.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the function returns the specific heats for pure air if f=0 (whatever m and n).

When using this function, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
If (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
IF (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2); MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)


IF (f>0) Then

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
MM_prod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2,T=T_p2))*MM_CO2
h_CO = (enthalpy(CO,T=T_p1)-enthalpy(CO,T=T_p2))*MM_CO
h_H2O =(enthalpy(H2O,T=T_p1)-enthalpy(H2O,T=T_p2))*MM_H2O
h_N2 = (enthalpy(N2,T=T_p1)-enthalpy(N2,T=T_p2))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/MM_prod)/(T_p1-T_p2)
gamma = c_bar_p/(c_bar_p-R_u/MM_prod)

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy, specific heat and gamma of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_p1)-enthalpy(CO2, T=T_p2))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_p1)-enthalpy(H2O, T=T_p2))*MM_H2O
hp_3 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
hp_4 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
cpbar  = hp/(T_p1-T_p2)
gamma = cpbar/(cpbar-R_u/MM_prod)
ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_p1)-enthalpy(O2, T=T_p2))*MM_O2
ha_2 = (enthalpy(N2,T=T_p1)-enthalpy(N2, T=T_p2))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
cpbar  = ha/(T_p1-T_p2)
gamma = cpbar/(cpbar-R_u/MM_a)
ENDIF

END

{--- End of the library functions copied from CSL-0005 ---}


"Revision JL051223-02"
"Two-shaft gas turbine: back to nominal speed (values given by the exercise)"
N = N_design                   "rotational speed: nominal [rev/s]"
M_r_exp1 = 205.8               "reduced flow of expander 1, given by the exercise [(kg/s)*sqrt(K)/bar]"
M_r_exp2 = 385.3               "reduced flow of expander 2, given by the exercise [(kg/s)*sqrt(K)/bar]"

"!Ambient conditions and design data"
p_1 = 1E5                      "compressor inlet pressure [Pa] (1 bar)"
t_1 = 15                       "compressor inlet temperature [°C]"
N_design = 10000/60            "design rotational speed [rev/s] (10000 rpm)"
t_1_design = 15                "design inlet temperature used to define the reduced speed [°C]"

"!Reduced properties"
N_r = N/sqrt(t_1+273)          "reduced rotational speed [rev/s/sqrt(K)]"
N_r_design = N_design/sqrt(t_1_design+273)
N_rN = N_r/N_r_design          "ratio of the reduced speeds [-]"
M_r_cp = M_dot_1*sqrt(t_1+273)/(p_1/1E5)   "reduced flow of the compressor [(kg/s)*sqrt(K)/bar]"

"Provisional value"
"p_2 = 5E5"

"The machine is run at 95 % of its nominal speed in revision part 1"
"N = N_design*0.95"

"!Compressor map (embedded table lookup_1: N_rN, M_r_cp, r_p, epsilon_s_cp)"
M_r_cp = INTERPOLATE('lookup_1','N_rN','M_r_cp',0.95)   "native EES form: INTERPOLATE('lookup_1','M_r_cp','N_rN',N_rN=0.95), CoolSolve-only positional form here (CS-GAP-INTERP-EES)"
r_p = INTERPOLATE('lookup_1','N_rN','r_p',0.95)
epsilon_s_cp = INTERPOLATE('lookup_1','N_rN','epsilon_s_cp',0.95)

"!Compressor balance"
w_cp = w_s_cp/epsilon_s_cp     "specific work consumed by the compressor [J/kg]"
w_s_cp = h_2s-h_1              "isentropic specific compression work [J/kg]"
h_1 = ENTHALPY(Air,T=T_1)      "compressor inlet enthalpy [J/kg]"
h_2s = ENTHALPY(Air,p=p_2,s=s_1)   "isentropic compression end enthalpy [J/kg]"
p_2 = p_1*r_p                  "compressor discharge pressure [Pa]"
s_1 = ENTROPY(Air,T=T_1,P=P_1) "compressor inlet entropy [J/kg-K]"
h_2 = h_1+w_cp                 "compressor discharge enthalpy [J/kg]"
t_2 = TEMPERATURE(Air,h=h_2)  "compressor discharge temperature [°C]"

"!Combustion chamber (natural gas assumed to arrive at 25 °C)"
q_1 = c_p_a*(25-t_2)           "sensible enthalpy of the compressor discharge air relative to 25 °C, sign reversed (balance term) [J/kg]"
CALL cpbar(1,4,0,25,T_2 : c_p_a, Q_4_a, x_a, e_min_a, e_a)   "mean specific heat of the air between 25 °C and t_2 [J/kg-K]"
q_2 = 0                        "heat loss of the combustion chamber: none (adiabatic) [J/kg]"
q_3 = -f*LHV                   "heat released by the combustion of the natural gas (negative: released) [J/kg]"
LHV = 50E6                     "lower heating value of the natural gas [J/kg]"
q_4 = 0                        "energy loss by unburned CO: none (complete combustion) [J/kg]"
q_5 = c_p_p_burner*(t_ex_burner-25)   "sensible enthalpy of the combustion products at t_ex_burner relative to 25 °C [J/kg]"
"c_p_p = 1100"                 "not used: replaced by the cpbar routine below"
CALL cpbar(1,4,f,25,T_ex_burner : c_p_p_burner, Q_4_p, x_p, e_min_p, e_p)   "mean specific heat of the products [J/kg-K]"
"t_ex_burner = 802"            "given in revision part 1, solved here"
q_1+q_2+q_3+q_4+q_5 = 0        "energy balance of the combustion chamber, sensible enthalpies counted from 25 °C [J/kg]"

"!Expander 1 (drives the compressor): reduced flow and power balance"
M_r_exp1 = M_dot_p*sqrt(t_3+273)/(p_3/1E5)    "reduced flow of expander 1 [(kg/s)*sqrt(K)/bar]"
t_3 = t_ex_burner              "expander 1 inlet temperature [°C]"
p_3 = p_2                      "expander 1 inlet pressure [Pa]"
M_dot_p = M_dot_a*(1+f)        "flow of combustion products [kg/s]"
M_dot_a = M_dot_1              "air flow [kg/s]"
M_dot_p*w_exp1 = M_dot_a*w_cp  "power balance of expander 1 [W]"
w_exp1 = epsilon_s_exp1*w_s_exp1   "specific work delivered by expander 1 [J/kg]"
"epsilon_s_exp1 = 0.85"        "given in revision part 1, solved here"
"(missing data)"
w_exp1 = c_p_p_exp1*(t_3-t_4)  "specific work delivered by expander 1, enthalpy drop [J/kg]"
c_p_p_exp1 = c_p_p_burner      "mean specific heat of the products [J/kg-K]"

"!Expander 1 isentropic end state and expander 2"
w_s_exp1 = c_p_p_exp1*(t_3-t_4s)   "isentropic specific work of expander 1 [J/kg]"
(t_4s+273)/(t_3+273) = (p_4/p_3)^((gamma-1)/gamma)   "isentropic relation of the products [-]"
"gamma = 1.35"                 "not used: replaced by the gamma routine below"
gamma = gamma (1,4,f,T_3,T_4)  "ratio of the specific heats of the products [-]"
M_r_exp2 = M_dot_p*sqrt(t_4+273)/(p_4/1E5)    "reduced flow of expander 2 [(kg/s)*sqrt(K)/bar]"
