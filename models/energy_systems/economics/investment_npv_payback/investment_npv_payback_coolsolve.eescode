{=============================================================================
  Economic evaluation of an energy-saving investment: net present value and
  simple payback time - CoolSolve Library model CSL-0154
  Runnable variant of the blocked native file investment_npv_payback.eescode
 -----------------------------------------------------------------------------
  Cash flow of an energy-saving measure over its lifetime, year by year: the
  discounted cash flow method, where each year's net cash flow is discounted at
  the rate k and accumulated in the net present value NPV_1[i] (it becomes
  positive in the discounted payback year), and the simple payback method, where
  the undiscounted cash flow is accumulated in NPV_2[i] (the year it crosses
  zero is the simple payback time, also given in closed form by PBT_2).

  Inputs : INV (initial investment), inflow_1 (1st-year benefit), outflow_1
           (1st-year cost), T_lifetime [year], j_fuel, j_el, k
  Outputs: NPV_1[i], DPV_1[i] (discounted), NPV_2[i], DPV_2[i]
           (undiscounted cumulative), PBT_2 [year]
  Units  : currencies in euro (€), times in year, rates dimensionless
  Source : S. Bertagnolio, ULiège Thermodynamics Laboratory, 2008-01-08,
           EES 7.888 - see README.md
  Variant: the only change forced by CS-BUG-DUPLICATE-INDEX-EXPR is that the
           two cumulative recurrences DPV_1[i] = DPV_1[i-1] + ... and
           DPV_2[i] = DPV_2[i-1] + ... are written out with explicit indices
           1..20; every other equation is unchanged (valid EES, no
           CoolSolve-only syntax). Every change is logged in README.md
=============================================================================}

"!1. INPUTS"
"Investment, first-year benefit and first-year cost"
INV = 20000 [€]
inflow_1 = 4000 [€]
outflow_1 = 2000 [€]

"!2. PARAMETERS"
"Economical rentability period of the measure"
T_lifetime = 20 [year]
"Mean values; as in the original, j_fuel is usually between 3 and 6 %/year
 for fossil fuel and between 5 and 10 %/year for biomass fuel, j_el between
 1 and 3 %/year"
j_fuel = 0.045 [-]
j_el = 0.03 [-]
"Capital cost / discount rate"
k = 0.08 [-]

"!3. EQUATIONS"

"!3.1 Discounted cash flow method"
"Initial values, year 0"
year[0] = 0
B[0] = 0
C[0] = 0
CF[0] = B[0] - C[0]
DPV_1[0] = CF[0]
NPV_1[0] = -INV + DPV_1[0]
"1st year"
year[1] = 1
C[1] = outflow_1
B[1] = inflow_1
CF[1] = B[1] - C[1]
DPV_1[1] = DPV_1[0] + (CF[1])*1/(1+k)
NPV_1[1] = -INV + DPV_1[1]
"Years 2 to T_lifetime: benefit and cost escalation, net cash flow"
duplicate i = 2, T_lifetime
  year[i] = i
  B[i] = B[1]*(1+j_fuel)^(i-1)
  C[i] = C[1]*(1+j_el)^(i-1)
  CF[i] = B[i] - C[i]
  NPV_1[i] = -INV + DPV_1[i]
end
"Discounted present value: the recursion of the native file,
 DPV_1[i] = DPV_1[i-1] + (CF[i])*1/(1+k)^i, written out with explicit indices
 for T_lifetime = 20 years (the default value of the model)"
DPV_1[2] = DPV_1[1] + (CF[2])*1/(1+k)^2
DPV_1[3] = DPV_1[2] + (CF[3])*1/(1+k)^3
DPV_1[4] = DPV_1[3] + (CF[4])*1/(1+k)^4
DPV_1[5] = DPV_1[4] + (CF[5])*1/(1+k)^5
DPV_1[6] = DPV_1[5] + (CF[6])*1/(1+k)^6
DPV_1[7] = DPV_1[6] + (CF[7])*1/(1+k)^7
DPV_1[8] = DPV_1[7] + (CF[8])*1/(1+k)^8
DPV_1[9] = DPV_1[8] + (CF[9])*1/(1+k)^9
DPV_1[10] = DPV_1[9] + (CF[10])*1/(1+k)^10
DPV_1[11] = DPV_1[10] + (CF[11])*1/(1+k)^11
DPV_1[12] = DPV_1[11] + (CF[12])*1/(1+k)^12
DPV_1[13] = DPV_1[12] + (CF[13])*1/(1+k)^13
DPV_1[14] = DPV_1[13] + (CF[14])*1/(1+k)^14
DPV_1[15] = DPV_1[14] + (CF[15])*1/(1+k)^15
DPV_1[16] = DPV_1[15] + (CF[16])*1/(1+k)^16
DPV_1[17] = DPV_1[16] + (CF[17])*1/(1+k)^17
DPV_1[18] = DPV_1[17] + (CF[18])*1/(1+k)^18
DPV_1[19] = DPV_1[18] + (CF[19])*1/(1+k)^19
DPV_1[20] = DPV_1[19] + (CF[20])*1/(1+k)^20

"!3.2 Pay-back time method (undiscounted accumulation)"
PBT_2 = INV/(B[1] - C[1])
DPV_2[0] = 0
NPV_2[0] = -INV + DPV_2[0]
"the recursion of the native file, DPV_2[i] = DPV_2[i-1] + (B[1] - C[1]),
 written out with explicit indices for T_lifetime = 20 years"
DPV_2[1] = DPV_2[0] + (B[1] - C[1])
NPV_2[1] = -INV + DPV_2[1]
DPV_2[2] = DPV_2[1] + (B[1] - C[1])
NPV_2[2] = -INV + DPV_2[2]
DPV_2[3] = DPV_2[2] + (B[1] - C[1])
NPV_2[3] = -INV + DPV_2[3]
DPV_2[4] = DPV_2[3] + (B[1] - C[1])
NPV_2[4] = -INV + DPV_2[4]
DPV_2[5] = DPV_2[4] + (B[1] - C[1])
NPV_2[5] = -INV + DPV_2[5]
DPV_2[6] = DPV_2[5] + (B[1] - C[1])
NPV_2[6] = -INV + DPV_2[6]
DPV_2[7] = DPV_2[6] + (B[1] - C[1])
NPV_2[7] = -INV + DPV_2[7]
DPV_2[8] = DPV_2[7] + (B[1] - C[1])
NPV_2[8] = -INV + DPV_2[8]
DPV_2[9] = DPV_2[8] + (B[1] - C[1])
NPV_2[9] = -INV + DPV_2[9]
DPV_2[10] = DPV_2[9] + (B[1] - C[1])
NPV_2[10] = -INV + DPV_2[10]
DPV_2[11] = DPV_2[10] + (B[1] - C[1])
NPV_2[11] = -INV + DPV_2[11]
DPV_2[12] = DPV_2[11] + (B[1] - C[1])
NPV_2[12] = -INV + DPV_2[12]
DPV_2[13] = DPV_2[12] + (B[1] - C[1])
NPV_2[13] = -INV + DPV_2[13]
DPV_2[14] = DPV_2[13] + (B[1] - C[1])
NPV_2[14] = -INV + DPV_2[14]
DPV_2[15] = DPV_2[14] + (B[1] - C[1])
NPV_2[15] = -INV + DPV_2[15]
DPV_2[16] = DPV_2[15] + (B[1] - C[1])
NPV_2[16] = -INV + DPV_2[16]
DPV_2[17] = DPV_2[16] + (B[1] - C[1])
NPV_2[17] = -INV + DPV_2[17]
DPV_2[18] = DPV_2[17] + (B[1] - C[1])
NPV_2[18] = -INV + DPV_2[18]
DPV_2[19] = DPV_2[18] + (B[1] - C[1])
NPV_2[19] = -INV + DPV_2[19]
DPV_2[20] = DPV_2[19] + (B[1] - C[1])
NPV_2[20] = -INV + DPV_2[20]
