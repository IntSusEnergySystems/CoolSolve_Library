{=============================================================================
   Classical fuel-oil heating boiler: parameter identification from the
   nominal point (CoolSolve Library model CSL-0265)
  -----------------------------------------------------------------------------
   Companion of the ON/OFF boiler simulation reference model: the three
   boiler parameters (gas-water conductance AU_gw, envelope conductance
   AU_wenv and fuel mass flow M_dot_f) are the unknowns of a square system
   closed by the nominal-point data (efficiency, useful power, water flow,
   supply temperature) and one stand-by measurement (OFF-regime losses).
   Combustion products via the mean specific heat procedure cpbar (copied
   from CSL-0005); gas-water and water-environment exchangers eps-NTU.
   Source : ULiege model bank 2008-02-12, BOILER_PARAM_IDENTIFICATION_EES_
   MODEL_SBJL080212.EES (inside CLASSICALBOILER_PARAM_IDENTIFICATION_MODEL_
   SBJL080212.zip) - authors S. Bertagnolio & J. Lebrun - see README.md
   Licence: MIT (lab disclaimer of the original: freely distributed, may
   not be sold, cite origin)
   Status : verified vs the EES stored solution (66 common variables, max
   rel. diff 1.84e-3); diagram-window inputs restored - see README.md
 =============================================================================}

{--- Library functions copied from CSL-0005 (cpbar_combustion_products) ---
  Copied as in CSL-0006 (P. Ngendakumana, ULiege 2003; 0/0 guard included)
  until $INCLUDE library:cpbar_combustion_products is available
  (CS-FEAT-IMPORT). Only the cpbar PROCEDURE is needed by this model.}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Removable singularity: for T_p1 = T_p2 the mean specific heat is 0/0 (its limit is cp(T)).
Below 0.01 K the mean is taken over a 0.01 K window centred on the mean temperature."
IF (ABS(T_p1-T_p2)<0.01) THEN
  T_hi = (T_p1+T_p2)/2+0.005
  T_lo = (T_p1+T_p2)/2-0.005
ELSE
  T_hi = T_p1
  T_lo = T_p2
ENDIF

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2,T=T_lo))*MM_CO2
h_CO = (enthalpy(CO,T=T_hi)-enthalpy(CO,T=T_lo))*MM_CO
h_H2O =(enthalpy(H2O,T=T_hi)-enthalpy(H2O,T=T_lo))*MM_H2O
h_N2 = (enthalpy(N2,T=T_hi)-enthalpy(N2,T=T_lo))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_hi-T_lo)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2, T=T_lo))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_hi)-enthalpy(H2O, T=T_lo))*MM_H2O
hp_3 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
hp_4 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_hi-T_lo)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
ha_2 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_hi-T_lo)
ENDIF

END

{--- End of the library functions copied from CSL-0005 ---}

"!Inputs (fuel oil)"

f=6E-2 [-]                 "fuel-air ratio [kg fuel / kg air]"
y_C=86.9E-2 [-]            "carbon mass fraction of the fuel [-]"
y_H=13.1E-2 [-]            "hydrogen mass fraction of the fuel [-]"

"!Nominal-point data (operating point of the last EES run, stored in the
 file; the quoted values of the original comments are a 1.15 MW nominal
 point that the author replaced before the last calculation)"

t_w_su_N=60 [C]            "water supply temperature at the nominal point [C] (70 C in the original comments)"
eta_N=0.91 [-]             "nominal boiler efficiency [-] (0.892 in the original comments)"
Q_dot_u_n_ON=50556 [W]     "nominal useful power in the ON regime [W] (1.15E6 W in the original comments)"
V_dot_w_l\h_n=2150 [l/h]   "water volume flow rate through the boiler [l/h] (1800 in the original comments)"
Q_dot_wenv_n_OFF=639 [W]   "stand-by heat loss to the environment in the OFF regime [W] (320 W in the original comments)"

"!Constants (supplied by the EES diagram window of the original file;
 values of the stored run, as in the original comments)"

t_f=25 [C]                 "fuel supply temperature [C]"
t_env=25 [C]               "environment temperature [C]"
t_a=25 [C]                 "combustion air supply temperature [C]"
c_w=4187 [J/kg-K]          "water specific heat [J/kg-K]"
rho_w=1000 [kg/m^3]        "water density [kg/m^3]"
c_f=1.8E3 [J/kg-K]         "fuel specific heat [J/kg-K]"
LHV=43E6 [J/kg]            "fuel lower heating value [J/kg]"
c_p_a=1005 [J/kg-K]        "air specific heat [J/kg-K]"

"!Control set point (as in the original)"

theta_N=1 [-]              "duty fraction at the nominal point [-]"

"!Link to the nominal-point data (as in the original)"

t_w_su=t_w_su_N            "water supply temperature [C]"
eta_ON=eta_N               "efficiency in the ON regime [-]"
theta=theta_N              "duty fraction [-]"
Q_dot_u_ON=Q_dot_u_N_ON    "useful power in the ON regime [W]"
V_dot_w_l\h=V_dot_w_l\h_n  "water volume flow rate [l/h]"

"!Stand-by identification (OFF regime, as in the original)"

Q_dot_u_n_OFF=0 [W]        "no combustion in the OFF regime [W]"
Q_dot_wenv_OFF=Q_dot_wenv_n_OFF  "stand-by losses = measured value [W]"
Q_dot_wenv_OFF=epsilon_wenv*C_dot_w*(t_w_su-t_env)  "epsilon-NTU form: identifies AU_wenv"
Q_dot_wenv_OFF=C_dot_w*(t_w_su-t_w_ex_OFF)          "water cools down to t_w_ex_OFF [C]"

"!Water circuit (as in the original)"

M_dot_w=V_dot_w_l\h/3600*rho_w/1000   "water mass flow rate [kg/s] from l/h"
C_dot_w=M_dot_w*c_w                   "water capacity rate [W/K]"

"!ON/OFF control (as in the original)"

t_w_ex=theta*t_w_ex_ON+(1-theta)*t_w_ex_OFF   "mixed water exhaust temperature [C]"

"!Efficiency and fuel flow (identifies M_dot_f, as in the original)"

Q_dot_c_ON=M_dot_f*LHV              "consumed power [W]"
eta_ON=Q_dot_u_ON/Q_dot_c_ON        "efficiency definition [-]"

"!Combustion reference model (as in the original)"

y_C=12/(12+n)                       "carbon mass fraction from the CmHn formula (m=1)"
1/f_st=((1+n/4)/0.21)*(MMa/(12+n))  "stoichiometric fuel-air ratio [-]"
MMa=MolarMass(Air)                  "molar mass of air [kg/kmol]"
1/f=(1/f_st)*(1+e)                  "excess air e from the fuel-air ratio [-]"
Q_dot_1+Q_dot_2+Q_dot_3+Q_dot_4+Q_dot_5=0  "adiabatic combustor energy balance [W]"
Q_dot_1=M_dot_a*c_p_a*(25-t_a)      "air enthalpy stream [W] (25 C reference)"
M_dot_a=M_dot_f/f                   "air mass flow rate [kg/s]"
Q_dot_2=M_dot_f*c_f*(25-t_f)        "fuel enthalpy stream [W] (25 C reference)"
Q_dot_3=-M_dot_f*LHV                "fuel combustion heat release [W]"
Q_dot_4=0                           "complete combustion (as in the original)"
Q_dot_5=M_dot_p*c_p_p*(t_adiab-25)  "products enthalpy stream [W] (25 C reference)"
M_dot_p=M_dot_a+M_dot_f             "product mass flow rate [kg/s]"
CALL cpbar(1,n,f,25,t_adiab:c_p_p,Q_41,x1,e_min1,e1)  "mean c_p of the products 25 C -> t_adiab [J/kg-K]"

"!Gas-water heat exchanger (as in the original)"

Q_dot_gw=C_dot_min*epsilon_gw*(t_g_su-t_w_su)   "epsilon-NTU duty [W]"
C_dot_min=min(C_dot_g,C_dot_w)                   "minimum capacity rate [W/K]"
C_dot_g=M_dot_p*c_p_g                            "product gas capacity rate [W/K]"
epsilon_gw=(1-exp(-NTU_gw*(1-omega)))/(1-omega*exp(-NTU_gw*(1-omega)))  "epsilon from NTU and omega [-] (as in the original)"
NTU_gw=AU_gw/C_dot_min                           "number of transfer units: identifies AU_gw [W/K]"
omega=C_dot_min/C_dot_max                        "capacity-rate ratio [-]"
C_dot_max=max(C_dot_g,C_dot_w)                   "maximum capacity rate [W/K]"
Q_dot_gw=C_dot_w*(t_w_ex_1-t_w_su)               "water-side duty [W]"
Q_dot_gw=C_dot_g*(t_g_su-t_g_ex)                 "gas-side duty [W]"
t_g_su=t_adiab                                   "gas inlet = adiabatic flame temperature [C]"
CALL cpbar(1,n,f,t_g_ex,t_adiab:c_p_g,Q_42,x2,e_min2,e2)  "mean c_p of the products over the exchanger [J/kg-K]"

"!Water-environment heat exchanger (envelope losses, as in the original)"

Q_dot_wenv=C_dot_w*epsilon_wenv*(t_w_ex_1-t_env)  "epsilon-NTU envelope loss [W]"
epsilon_wenv=1-exp(-NTU_wenv)                      "single-stream epsilon [-]"
NTU_wenv=AU_wenv/C_dot_w                           "number of transfer units: identifies AU_wenv [W/K]"
Q_dot_wenv=C_dot_w*(t_w_ex_1-t_w_ex_ON)            "water-side envelope loss [W]"
Q_dot_u_ON=C_dot_w*(t_w_ex_ON-t_w_su)              "useful power from the temperature rise [W]"
