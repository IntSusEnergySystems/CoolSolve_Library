{=============================================================================
  Full-load boiler with a combustion chamber
  CoolSolve Library model CSL-0219
 -----------------------------------------------------------------------------
  Exercise (MSTh R7, exercise 4). Fuel oil burns in an adiabatic chamber.
  Fictitious exchangers bring the reactants to 25 °C. A gas-water exchanger
  and a fictitious water-ambient exchanger follow. Water flow and gas-water
  AU are scaled from a previous exercise in proportion to the fuel flow, as
  the original states. Stand-by and a third regime at one tenth of the useful
  heat are in the same window. The product specific heat cp_p_2 stays 1300.
  cp_p is the copied cpbar procedure, called with CALL.

  Inputs : T_su, T_env, P_su, T_w_su, f, LHV_f, y_h, V_dot_f, cp_f
  Outputs: Q_dot_utile, eta, T_g, T_w_ex_1, T_w_ex_2, T_w_ex_off, eta_m
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : Stéphane Bertagnolio, ULiège MSTh repetition R7, exercise 4
           - see README.md
  Status : verified against the EES stored solution (see README.md)
=============================================================================}

{--- PROCEDURE cpbar copied from gas_turbine_part_load ---
  The equation window calls cpbar and does not define it. Copied from that
  file. FUNCTION gamma is not copied: this procedure does not call it.
  cpbar is a five-output procedure. The original writes it in function
  position; the call below is CALL (valid EES, same returned specific heat).}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Removable singularity: for T_p1 = T_p2 the mean specific heat is 0/0 (its limit is cp(T)).
Below 0.01 K the mean is taken over a 0.01 K window centred on the mean temperature."
IF (ABS(T_p1-T_p2)<0.01) THEN
  T_hi = (T_p1+T_p2)/2+0.005
  T_lo = (T_p1+T_p2)/2-0.005
ELSE
  T_hi = T_p1
  T_lo = T_p2
ENDIF

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2,T=T_lo))*MM_CO2
h_CO = (enthalpy(CO,T=T_hi)-enthalpy(CO,T=T_lo))*MM_CO
h_H2O =(enthalpy(H2O,T=T_hi)-enthalpy(H2O,T=T_lo))*MM_H2O
h_N2 = (enthalpy(N2,T=T_hi)-enthalpy(N2,T=T_lo))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_hi-T_lo)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2, T=T_lo))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_hi)-enthalpy(H2O, T=T_lo))*MM_H2O
hp_3 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
hp_4 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_hi-T_lo)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
ha_2 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_hi-T_lo)
ENDIF

END

"Nominal-regime data"
"Based on the previous exercise for two extra parameters (M_dot_w and AU_gw are assumed proportional to the fuel flow), as in the original."
AU_gw = 75.28*(3/5.813)                           "gas-water exchanger UA, scaled with the fuel flow [W/K]"
M_dot_w = 0.5961*(3/5.813)                        "water mass flow rate, scaled with the fuel flow [kg/s]"

T_su = 20                                         "supply temperature of air and fuel [C]"
T_env = 20                                        "ambient temperature [C]"
P_su = 101325                                     "supply pressure [Pa]"
T_w_su = 70                                       "water inlet temperature [C]"
f = 0.06                                          "fuel-air ratio [-]"
LHV_f = 43E6                                      "fuel lower heating value, a constant [J/kg]"
m = 1                                             "carbon atoms in the equivalent fuel CmHn [-]"
n = y_h*12/y_c                                    "hydrogen atoms in CmHn [-]"
y_h = 0.131                                       "hydrogen mass fraction of the fuel [-]"
y_c = 1-y_h                                       "carbon mass fraction of the fuel [-]"
cp_f = 1800                                       "fuel specific heat [J/kg-K]"
V_dot_f = 3E-3/3600                               "fuel volume flow, as written [m3/s]"
M_dot_f = 0.8*1000*V_dot_f                        "fuel mass flow rate [kg/s]"
M_dot_f = f*M_dot_a                               "air mass flow from the fuel-air ratio [kg/s]"

"!Full-load regime"
"!Combustion chamber"
Q_dot_1+Q_dot_2+Q_dot_3+Q_dot_4+Q_dot_5 = 0       "chamber energy balance [W]"
"Fictitious exchangers: reactants brought to 25 C, as in the original."
Q_dot_1 = M_dot_a*cp_a*(25-T_su)                  "air brought to 25 C [W]"
cp_a = CP(Air,T=T_m)                              "specific heat of air [J/kg-K]"
T_m = (T_su+25)/2                                 "temperature at which cp_a is evaluated [C]"

Q_dot_2 = M_dot_f*cp_f*(25-T_su)                  "fuel brought to 25 C [W]"

Q_dot_3 = -M_dot_f*LHV_f                          "fuel heating value [W]"

Q_dot_4 = 0                                       "zero if combustion is complete, as in the original [W]"

Q_dot_5 = M_dot_p*cp_p*(T_g-25)                   "products from 25 C to T_g [W]"
M_dot_p = M_dot_f+M_dot_a                         "product mass flow rate [kg/s]"
CALL cpbar(m,n,f,T_g,25:cp_p,Q_4_cb,x_cb,e_min_cb,e_cb)  "mean specific heat of the products [J/kg-K]"
"Provisional value in the original, a comment, not an equation:"
"cp_p=1300"

"!Gas-water exchanger"
T_g_su = T_g                                      "gas inlet temperature [C]"
"Gas side"
Q_dot_gw = M_dot_p*cp_p_2*(T_g_su-T_g_ex)         "gas-side heat rate [W]"
"Provisional cpbar call in the original, a comment, not an equation:"
"cp_p_2=cpbar(m,n,f,T_g_su,T_g_ex)"
"Provisional value in the original:"
cp_p_2 = 1300                                     "product specific heat on the gas side, as assigned [J/kg-K]"
"Water side"
Q_dot_gw = M_dot_w*cp_w_gw*(T_w_ex_1-T_w_su)      "water-side heat rate [W]"
cp_w_gw = CP(Water,T=T_m_gw,P=P_su)               "specific heat of water [J/kg-K]"
T_m_gw = (T_w_ex_1+T_w_su)/2                      "temperature at which cp_w_gw is evaluated [C]"
"Provisional value in the original, a comment, not an equation:"
"cp_w_gw=4187"
"Performance"
Q_dot_gw = epsilon_gw*C_dot_min_gw*(T_g_su-T_w_su)  "exchanger heat rate [W]"
epsilon_gw = (1-exp(-NTU_gw*(1-omega_gw)))/(1-omega_gw*exp(-NTU_gw*(1-omega_gw)))  "counterflow effectiveness [-]"
NTU_gw = AU_gw/C_dot_min_gw                       "number of transfer units [-]"
omega_gw = C_dot_min_gw/C_dot_max_gw              "capacity-ratio [-]"
C_dot_min_gw = min(C_dot_w_gw,C_dot_p_2)          "smaller capacity rate [W/K]"
C_dot_max_gw = max(C_dot_w_gw,C_dot_p_2)          "larger capacity rate [W/K]"
C_dot_w_gw = M_dot_w*cp_w_gw                      "water capacity rate [W/K]"
C_dot_p_2 = M_dot_p*cp_p_2                        "gas capacity rate [W/K]"

"!Fictitious water-ambient exchanger"
T_w_su_1 = T_w_ex_1                               "water inlet to the envelope exchanger [C]"
Q_dot_wenv = M_dot_w*cp_w_wenv*(T_w_su_1-T_w_ex_2)  "envelope loss [W]"
cp_w_wenv = CP(Water,T=T_m_wenv,P=P_su)           "specific heat of water [J/kg-K]"
T_m_wenv = (T_w_su_1+T_w_ex_2)/2                  "temperature at which cp_w_wenv is evaluated [C]"
"Provisional value in the original, a comment, not an equation:"
"cp_w_wenv=4187"
Q_dot_wenv = epsilon_wenv*C_dot_min_wenv*(T_w_su_1-T_env)  "envelope loss from effectiveness [W]"
C_dot_min_wenv = C_dot_w_wenv                     "capacity rate, water only [W/K]"
C_dot_w_wenv = M_dot_w*cp_w_wenv                  "water capacity rate [W/K]"
epsilon_wenv = 1-exp(-NTU_wenv)                   "effectiveness, as written [-]"
NTU_wenv = AU_wenv/C_dot_min_wenv                 "number of transfer units [-]"

"!Boiler efficiency"
eta = Q_dot_utile/Q_dot_conso                     "boiler efficiency [-]"
Q_dot_utile = Q_dot_gw-Q_dot_wenv                 "useful heat rate [W]"
Q_dot_conso = M_dot_f*LHV_f                       "fuel power [W]"

"!Stand-by regime"
T_w_ex_set = T_w_su                               "stand-by water outlet set equal to the inlet [C]"
T_w_ex_set = theta_stb*T_w_ex_on+(1-theta_stb)*T_w_ex_off  "on/off blend at stand-by [C]"
"Calculation of theta_stb, as in the original."
0.03E-3*0.8*1000/3600 = theta_stb*M_dot_f         "stand-by fuel flow, as written [kg/s]"

Q_dot_u_set = C_dot_w_set*(T_w_ex_set-T_w_su)     "stand-by useful heat rate [W]"
C_dot_w_set = M_dot_w*cp_w_set                    "water capacity rate at the set point [W/K]"
cp_w_set = CP(Water,T=T_m_set,P=P_su)             "specific heat of water [J/kg-K]"
T_m_set = (T_w_ex_set+T_w_su)/2                   "temperature at which cp_w_set is evaluated [C]"
"Provisional value in the original, a comment, not an equation:"
"cp_w_m_set=4187"

T_w_ex_on = T_w_ex_2                              "water outlet with the burner on [C]"

"Calculation of T_w_ex_off (burner OFF), as in the original."
Q_dot_wenv_off = M_dot_w*cp_w_wenv_off*(T_w_su-T_w_ex_off)  "envelope loss with the burner off [W]"
cp_w_wenv_off = CP(Water,T=T_m_wenv_off,P=P_su)   "specific heat of water [J/kg-K]"
T_m_wenv_off = (T_w_su+T_w_ex_off)/2              "temperature at which cp_w_wenv_off is evaluated [C]"
"Provisional value in the original, a comment, not an equation:"
"cp_w_wenv_off=4187"
Q_dot_wenv_off = epsilon_wenv_off*C_dot_min_wenv_off*(T_w_su-T_env)  "off-state loss from effectiveness [W]"
C_dot_min_wenv_off = C_dot_w_wenv_off             "capacity rate, water only [W/K]"
C_dot_w_wenv_off = M_dot_w*cp_w_wenv_off          "water capacity rate [W/K]"
epsilon_wenv_off = 1-exp(-NTU_wenv_off)           "effectiveness, as written [-]"
NTU_wenv_off = AU_wenv/C_dot_min_wenv_off         "number of transfer units [-]"

"!Third regime"
Q_dot_u_m = 0.1*Q_dot_utile                       "useful heat rate at one tenth of full load [W]"
Q_dot_u_m = M_dot_w*cp_w_m_3*(T_w_ex_3-T_w_su)    "water temperature rise at that heat rate [W]"
cp_w_m_3 = 4187                                   "specific heat of water, as assigned [J/kg-K]"
"Calculation of theta, as in the original."
T_w_ex_3 = theta*T_w_ex_on+(1-theta)*T_w_ex_off   "on/off blend, as in the original [C]"
"Calculation of the mean efficiency, as in the original."
eta_m = Q_dot_u_m/Q_dot_c_m                       "mean efficiency [-]"
Q_dot_c_m = theta*M_dot_f*LHV_f                   "mean fuel power [W]"
M_dot_f_m = theta*M_dot_f                         "mean fuel mass flow rate [kg/s]"
M_dot_f_lh_m = M_dot_f_m/(0.8*1000)*3600*1000     "mean fuel volume flow, as written [L/h]"
