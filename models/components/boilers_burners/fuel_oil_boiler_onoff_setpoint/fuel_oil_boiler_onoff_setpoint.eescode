{=============================================================================
  Fuel-oil boiler with on/off envelope losses and a set-point blend (theta)
  CoolSolve Library model CSL-0263
 -----------------------------------------------------------------------------
  Exercise (MSTh R7, exercise 3, suite). Fuel oil with carbon mass fraction
  0.869 burns at a given fuel-air ratio; the adiabatic flame temperature
  comes from a combustor balance with the mean specific heat of the products
  (cpbar, copied from CSL-0005). A gas-water exchanger (eps-NTU, gas-side
  cp assigned the constant 1300 J/kg-K) and a water-envelope exchanger with
  an ON and an OFF branch follow. The exercise-3 set-point outlet blends the
  ON and OFF outlets with a fraction theta (parametric table); here theta = 1.

  Inputs : M_dot_a, M_dot_f, M_dot_w, AU_gw, AU_wenv, T_w_su, T_env, theta
  Outputs: T_p_ad, T_gas_ex, T_w_ex_1, Q_dot_u, eta, eta_set
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège MSTh repetition R7 exercise 3 - see README.md
  Status : verified against the EES stored solution (50/51), see README.md
=============================================================================}

{--- PROCEDURE cpbar copied from CSL-0005 (cpbar_combustion_products) ---
  The equation window calls cpbar and does not define it. Copied from that
  file. FUNCTION gamma is not copied: this procedure does not call it.
  cpbar is a five-output procedure. The original writes it in function
  position; the call below is CALL (valid EES, same returned specific heat).}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Removable singularity: for T_p1 = T_p2 the mean specific heat is 0/0 (its limit is cp(T)).
Below 0.01 K the mean is taken over a 0.01 K window centred on the mean temperature."
IF (ABS(T_p1-T_p2)<0.01) THEN
  T_hi = (T_p1+T_p2)/2+0.005
  T_lo = (T_p1+T_p2)/2-0.005
ELSE
  T_hi = T_p1
  T_lo = T_p2
ENDIF

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2,T=T_lo))*MM_CO2
h_CO = (enthalpy(CO,T=T_hi)-enthalpy(CO,T=T_lo))*MM_CO
h_H2O =(enthalpy(H2O,T=T_hi)-enthalpy(H2O,T=T_lo))*MM_H2O
h_N2 = (enthalpy(N2,T=T_hi)-enthalpy(N2,T=T_lo))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_hi-T_lo)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2, T=T_lo))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_hi)-enthalpy(H2O, T=T_lo))*MM_H2O
hp_3 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
hp_4 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_hi-T_lo)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
ha_2 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_hi-T_lo)
ENDIF

END

{--- End of the library functions copied from CSL-0005 ---}

"Fuel-oil data"

y_c=0.869  "carbon mass fraction of the fuel [-]"
y_h=1-y_c  "hydrogen mass fraction of the fuel [-]"
c_f=1800 [J/kg-K]  "fuel specific heat [J/kg-K]"
LHV=4.3E7 [J/kg]  "lower heating value of the fuel [J/kg]"

{f=0.062}  "fuel-air ratio of the previous exercise, commented out in the original"
T_a_su=25  "air supply temperature [C]"
T_f_su=25  "fuel supply temperature [C]"
T_env=25  "environment temperature [C]"

T_w_su=70  "water return to the boiler [C]"
{T_w_ex=90}  "water outlet of the previous exercise, commented out in the original"
{T_gas_ex=220}  "flue gas outlet of the previous exercise, commented out in the original"
{Q_dot_u=50000}  "useful power of the previous exercise, commented out in the original"
{eta=0.9}  "efficiency of the previous exercise, commented out in the original"

"New data (exercise 2)"
M_dot_a=0.02084  "air mass flow rate [kg/s]"
M_dot_f=0.001292  "fuel mass flow rate [kg/s]"
M_dot_w=0.5972  "water mass flow rate [kg/s]"
AU_gw=73.73 [W/K]  "gas-to-water exchanger conductance [W/K]"
AU_wenv=9.59 [W/K]  "water-to-envelope conductance [W/K]"

"New data (exercise 3): T_w_ex_set = 80 in the statement (parametric table), replaced by the blend below"
T_w_ex_set=theta*T_w_ex_on+(1-theta)*T_w_ex_off  "set-point outlet temperature, blend of the ON and OFF outlets [C]"
theta=1  "blend weight of T_w_ex_on, parametric-table input at its default-run value (stored solution) [-]"

"Per kg of fuel there are y_c kg of C and y_h kg of H"
"Per kg of fuel there are y_c/12 kmol of C and y_h/1 kmol of H"
"For 1 mol of C there are y_h*12/y_c mol of H (the original says C: typo)"
m=1
n=y_h*12/y_c

"!Adiabatic boiler"
"adiabatic combustion temperature"
M_dot_f*LHV+M_dot_a*cp_a*(T_a_su-T_ref)+M_dot_f*c_f*(T_f_su-T_ref)=M_dot_p*cp_p*(T_p_ad-T_ref)  "combustor energy balance [W]"

M_dot_a=M_dot_f/f
T_ref=25  "reference temperature of the combustor balance [C]"
cp_a=cp(AIR,T=T_a_su)  "air specific heat [J/kg-K]"
"first approximation in the original: cp_p = 1300 (then update guesses and solve)"
CALL cpbar(m,n,f,T_p_ad,T_ref:cp_p,Q_4_ad,x_ad,e_min_ad,e_ad)  "mean specific heat of the products [J/kg-K]"
M_dot_p=M_dot_a+M_dot_f

"!Gas-water exchanger"
T_gas_su=T_p_ad
C_dot_p=M_dot_p*cp_p_hex
cp_p_hex=1300  "first estimate in the original [J/kg-K]"
C_dot_w=M_dot_w*cp_w
cp_w=4186  "water specific heat [J/kg-K]"
C_dot_min_1=min(C_dot_p,C_dot_w)
C_dot_max_1=max(C_dot_p,C_dot_w)

omega_1=C_dot_min_1/C_dot_max_1
epsilon_1=(1-exp(-NTU_1*(1-omega_1)))/(1-omega_1*exp(-NTU_1*(1-omega_1)))

NTU_1=AU_1/C_dot_min_1
AU_1=AU_gw
Q_dot_1=epsilon_1*C_dot_min_1*(T_gas_su-T_w_su)
Q_dot_1=C_dot_w*(T_w_ex_1-T_w_su)  "to compute T_w_ex_1"
Q_dot_1=C_dot_p*(T_gas_su-T_gas_ex)  "to compute the chimney gas temperature T_gas_ex"

"!Envelope: 2 ON"

AU_2=AU_wenv
NTU_2=AU_2/C_dot_w
epsilon_2=1-exp(-NTU_2)  "semi-isothermal exchanger, envelope metal at constant temperature T_env (as in the original)"
"A heat exchanger is semi-isothermal if:"
"- one of the two fluids is at rest (M_dot=0), e.g. radiator -> C_dot_min = 0"
"- one of the two fluids has infinite capacity, e.g. evaporator or condenser -> C_dot_max = infinity"
"hence omega_2=C_dot_min_2/C_dot_max_2=0"
"Here it is the 2nd case: whatever the heat rate exchanged, the temperature T_env stays constant"
Q_dot_2_on=epsilon_2*C_dot_w*(T_w_ex_1-T_env)
Q_dot_2_on=C_dot_w*(T_w_ex_1-T_w_ex_on)

"!Envelope: 2 OFF"

Q_dot_2_off=epsilon_2*C_dot_w*(T_w_su-T_env)  "here one enters with T_w_su and no longer with T_w_ex_1"
Q_dot_2_off=C_dot_w*(T_w_su-T_w_ex_off)

"!Balance"
Q_dot_u=Q_dot_1-Q_dot_2_on
eta=Q_dot_u/Q_dot_c
Q_dot_c=M_dot_f*LHV

"Mean efficiency"

Q_dot_u_set=C_dot_w*(T_w_ex_set-T_w_su)
Q_dot_c_set=theta*LHV*M_dot_f
eta_set=Q_dot_u_set/Q_dot_c_set
