{=============================================================================
  Centrifugal pump from manufacturer curves + similarity laws (mode P_N)
  CoolSolve Library model CSL-0125
-----------------------------------------------------------------------------
  Translation of the LaboThapPy component PumpCurveSimilarity into EES-language
  equations. The pump is described by four manufacturer curves at the rated
  speed (volumetric flow rate V_dot, head rise Delta_H, isentropic efficiency
  eta_is, required NPSH NPSH_r); the affinity (similarity) laws scale them to
  any other speed (V_dot ~ N, Delta_H ~ N^2, NPSH_r ~ N^2, eta_is unchanged).
  Mode P_N: suction pressure and temperature, discharge pressure and speed are
  given, the flow rate and the shaft power are computed. The linear
  interpolation of the Python source becomes lookup tables; the fluid is
  treated as incompressible for the head.

  Inputs : fluid$, P_su, T_su, P_ex, N_rot (pump speed), N_rot_rated
           (curves read from the table 'pump_curves', rated speed)
  Outputs: V_dot, m_dot, eta_is, NPSH_r, h_ex, T_ex, W_dot_hyd, W_dot_shaft
  Units  : SI - temperatures in °C, pressures in Pa, energies in J; curves in
           m3/h and m, speed in rpm (as in the original)
  Source : LaboThapPy, PumpCurveSimilarity by B. Chaudoir, E. Neven - see README.md
=============================================================================}

{--- Out-of-range indicator of the original V_dot_flag (linear interpolation
     outside the curve range is not possible on a lookup table) ---}
FUNCTION flow_outside_curve(q, q_min, q_max)
  flow_outside_curve = 0
  IF (q < q_min) THEN
    flow_outside_curve = 1
  ENDIF
  IF (q > q_max) THEN
    flow_outside_curve = 1
  ENDIF
END

"Inputs (default run = CO2 case of the original example, mode P_N)"
fluid$ = 'R744'               "pump fluid: CoolProp 'CO2' maps to EES 'R744', the real fluid; bare 'CO2' is the ideal-gas species in EES"
T_su = 9.19364983582685       "suction temperature: 283.34364983582685 K - 1 K - 273.15 K in the original [C]"
P_su = 4559550.900413511      "suction pressure [Pa]"
P_ex = 15254008.433412187     "discharge pressure [Pa]"
N_rot = 2900                  "pump rotational speed [rpm]"
N_rot_rated = 2900            "rated speed of the manufacturer curves [rpm]"
g = 9.81                      "gravitational acceleration, value of the original [m/s2]"

"!Manufacturer curves at the rated speed (lookup table 'pump_curves')"
V_dot_rated_min = LOOKUP('pump_curves', 1, 1)                "lowest flow rate of the curves [m3/h]"
V_dot_rated_max = LOOKUP('pump_curves', NLOOKUPROWS('pump_curves'), 1)  "highest flow rate of the curves [m3/h]"

"!Suction state (incompressible fluid approximation for the head, as in the original)"
rho_su = DENSITY(fluid$, T=T_su, P=P_su)   "suction density [kg/m3]"
h_su = ENTHALPY(fluid$, T=T_su, P=P_su)   "suction enthalpy [J/kg]"
s_su = ENTROPY(fluid$, T=T_su, P=P_su)    "suction entropy [J/kg-K]"

"!Similarity laws: speed ratio to the rated speed of the curves"
N_ratio = N_rot/N_rot_rated                "speed ratio [-]"

"!Head required by the pressure rise"
DP = P_ex - P_su                            "pressure rise [Pa]"
Delta_H = DP/(g*rho_su)                     "head rise [m]"

"!Flow rate: head curve inverted at the scaled head (V_dot ~ N), linear interpolation"
V_dot = N_ratio*INTERPOLATE('pump_curves', 'Delta_H_rated', 'V_dot_rated', Delta_H/N_ratio^2)   "volumetric flow rate [m3/h]"
m_dot = rho_su*V_dot/3600                  "mass flow rate [kg/s]"
V_dot_flag = flow_outside_curve(V_dot, N_ratio*V_dot_rated_min, N_ratio*V_dot_rated_max)   "1 if the flow rate is outside the curve range [-]"

"!Isentropic efficiency and required NPSH: curves of the rated speed read at the equivalent flow rate (NPSH_r ~ N^2)"
eta_is = INTERPOLATE('pump_curves', 'V_dot_rated', 'eta_is_rated', V_dot/N_ratio)    "isentropic efficiency [-]"
NPSH_r = N_ratio^2*INTERPOLATE('pump_curves', 'V_dot_rated', 'NPSH_r_rated', V_dot/N_ratio)  "required net positive suction head [m]"

"!Discharge state and powers"
h_ex_s = ENTHALPY(fluid$, P=P_ex, s=s_su)  "isentropic discharge enthalpy [J/kg]"
h_ex = h_su + (h_ex_s-h_su)/eta_is         "discharge enthalpy [J/kg]"
T_ex = TEMPERATURE(fluid$, h=h_ex, P=P_ex)  "discharge temperature [C]"
W_dot_hyd = g*Delta_H*m_dot                "ideal hydraulic power [W]"
W_dot_shaft = m_dot*(h_ex-h_su)            "shaft power [W]"

"!Pump path for the thermodynamic diagrams (post-processing, no effect on the results)"
{1: suction, 2: discharge. Use the arrays h[i]/P[i] or s[i]/T[i] with the
 "Overlay array path" option of the CoolSolve Diagram tab.}
P[1] = P_su
h[1] = h_su
T[1] = T_su
s[1] = s_su
P[2] = P_ex
h[2] = h_ex
T[2] = T_ex
s[2] = ENTROPY(fluid$, h=h_ex, P=P_ex)