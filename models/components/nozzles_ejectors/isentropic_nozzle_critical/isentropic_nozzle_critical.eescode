{=============================================================================
  Isentropic nozzle with critical pressure (choked / unchoked flow)
  CoolSolve Library model CSL-0310
 -----------------------------------------------------------------------------
  Steady isentropic flow of air through a nozzle throat: total enthalpy is
  conserved, the throat state is isentropic, and the throat pressure is the
  larger of the back pressure P_ex and the critical pressure P_crit
  (choked flow when P_ex < P_crit). gamma is not fixed (provisional 1.4 in
  the original) but solved from the isentropic relation with the real-gas
  throat temperature. Given (T_su, P_su, P_ex, M_dot) the model returns the
  throat state, velocity, volume flow and throat area A_thr.
  Inputs : T_su, P_su, P_ex (default run restored, see README), M_dot
  Outputs: P_thr, T_thr, h_thr_s, C_thr, V_dot_thr, A_thr, P_crit, gamma
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège, course "Machines et systèmes thermiques", repetition 1
           (EES file "Isentropic Noozle.EES") - see README.md
  Status : verified against the EES stored values and last-solution guesses
           (README.md)
=============================================================================}

"!Data"
T_su = 15          "supply (stagnation) temperature [°C]"
P_su = 1E5         "supply (stagnation) pressure [Pa]"
P_ex = 9E4         "back pressure [Pa]; 9E4 = EES default run, the original also used 0.8E5 (commented line)"
M_dot = 0.5        "mass flow rate [kg/s]"

"!Calculations"
h_thr_s + C_thr^2/2 = h_su                    "total enthalpy conservation (as in the original)"
h_thr_s = ENTHALPY(Air, P=P_thr, s=s_su)      "isentropic expansion to the throat"
h_su = ENTHALPY(Air, T=T_su)                  "supply enthalpy (ideal gas: pressure-independent, as in the original)"
s_su = ENTROPY(Air, T=T_su, P=P_su)           "supply entropy"

C_thr = V_dot_thr/A_thr            "A_thr = throat cross-section area [m^2]"
V_dot_thr = M_dot*v_thr            "volume flow at the throat [m^3/s]"
v_thr = VOLUME(Air, h=h_thr_s, s=s_su)
P_thr = max(P_ex, P_crit)          "throat pressure: the larger of the back pressure and the critical pressure (as in the original)"
P_crit = (2/(gamma+1))^(gamma/(gamma-1))*P_su    "critical pressure (choked flow when P_ex < P_crit)"

"(T_thr + 273) as in the original (0.15 K approximation of T in K); the original's provisional gamma = 1.4 is replaced by the real-gas value solved below"
(T_thr + 273)/(T_su + 273) = (P_thr/P_su)^((gamma - 1)/gamma)   "isentropic nozzle relation"
T_thr = TEMPERATURE(Air, s=s_su, P=P_thr)                       "throat temperature of the isentropic state"

DELTAP = P_su - P_ex   "extra variable of the original (for a plot) [Pa]"
