{=============================================================================
  Teaching exercise: turbocompressor optimal speed and flow at a new inlet
  CoolSolve Library model CSL-0231
 -----------------------------------------------------------------------------
  Teaching exercise (ULiege, Machines et systemes thermiques, repetition of
  2004-10-12, exercise 5 continued). The two constants of the optimal-regime
  similarity laws are given. Air is supplied at 0.9 bar and 50 C, and the
  discharge pressure is 2.5 bar. The file computes the optimal rotation
  speed and the suction volume flow at that new inlet state.

  The reduced groups keep t_su+273 and p_su/1E5, as written in the original.
  Mass flow follows from the reduced mass flow. The suction volume flow is
  that mass flow times the ideal-gas specific volume of Air.
  The previous operating point (2000 m3/h and 10000 rpm) stays a comment.

  Inputs : cste_1, cste_2, p_su, t_su, p_ex
  Outputs: rpm, V_dot_su, M_dot
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiege MSTh course - see README.md
=============================================================================}

"!New inlet state"
cste_1=0.02349                 "given constant of the optimal-regime laws, as in the original [s^2-bar^2/(kg^2-K)]"
cste_2=0.8615                  "given constant of the optimal-regime laws, as in the original [bar/(kg-K)]"
"Previous operating point, commented out in the original: V_dot_su = 2000/3600"
p_su=0.9E5                     "suction pressure [Pa]"
t_su=50                        "suction temperature [C]"
p_ex=2.5E5                     "discharge pressure [Pa]"
"Previous operating point, commented out in the original: rpm = 10000"
"!Reduced variables"
M_r=M_dot*sqrt(t_su+273)/(p_su/1E5)  "reduced mass flow; temperature in K and pressure in bar, as in the original [kg-K^0.5/(s-bar)]"
"temperature in K and pressure in bar, as in the original"
M_dot=V_dot_su/v_su            "mass flow rate [kg/s]"
v_su=VOLUME(Air,T=T_su,P=P_su) "suction specific volume [m3/kg]"
N_r=N/sqrt(t_su+273)           "reduced rotation speed; temperature in K, as in the original [1/(s-K^0.5)]"
N=rpm/60                       "rotation speed [rev/s]"
cste_1=r_p/M_r^2               "same constant written from the reduced variables, as in the original [s^2-bar^2/(kg^2-K)]"
r_p=p_ex/p_su                  "pressure ratio [-]"
cste_2=N_r/M_r                 "same constant written from the reduced variables, as in the original [bar/(kg-K)]"
