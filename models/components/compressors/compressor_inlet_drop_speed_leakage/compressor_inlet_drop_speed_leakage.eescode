{=============================================================================
  Compressor with inlet pressure drop and speed-dependent leakage
  CoolSolve Library model CSL-0217
 -----------------------------------------------------------------------------
  Teaching exercise, ULiège MSTh, repetition 3, exercise 2 (continuation).
  Equivalent nozzles stand for the inlet pressure drop and the internal
  leakage of a positive-displacement air compressor. Throat areas and the
  swept volume are the characteristics taken from the first part. The
  relative-flow hypothesis is removed: efficiency and the leakage ratio
  vary with rotational speed. The stored point is 6000 rpm. The commented
  lines rpm = 3000, epsilon_s = 0.75 and M_dot = 1 are not equations.

  Inputs : rpm, T_su, P_su, P_ex, A_thr_su, A_thr_leak, V_s
  Outputs: M_dot, M_dot_l, W_dot, epsilon_s, DELTAP_su
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : Stéphane Bertagnolio, ULiège MSTh - see README.md
=============================================================================}

"!Characteristics from the first part of the exercise, as in the original"
A_thr_leak = 0.0001368 [m^2]                  "leakage throat area [m^2]"
A_thr_su = 0.00578 [m^2]                      "inlet throat area [m^2]"
V_s = 0.02306 [m^3]                           "swept volume [m^3]"

"The equation window comments rpm = 3000. That line is not an equation."
"The unmodified extract is not square. The stored value is the input below."
rpm = 6000                                    "rotational speed [rpm], stored solution"
N = rpm/60                                    "rotational speed [1/s]"
T_su = 20                                     "suction temperature [°C]"
P_su = 1E5                                    "suction pressure [Pa]"
P_ex = 4E5                                    "discharge pressure [Pa]"

"Commented in the original, and not equations: epsilon_s = 0.75 and M_dot_l = 0.1*M_dot."
"In relative terms, the original also comments M_dot = 1. That hypothesis is removed."
"Efficiency and the ratio of M_dot_l to M_dot vary with rotational speed."

"!Overall compression"
epsilon_s = w_s/w                             "isentropic efficiency [-]"
w_s = h_ex_s - h_su                           "isentropic specific work [J/kg]"
h_ex_s = enthalpy(Air, s=s_su, P=P_ex)        "isentropic discharge enthalpy [J/kg]"
s_su = entropy(Air, T=T_su, P=P_su)           "suction entropy [J/kg-K]"
h_su = enthalpy(Air, T=T_su)                  "suction enthalpy [J/kg]"
W_dot = M_dot*w                               "shaft power from the fresh charge [W]"

"!Inlet pressure drop, state su_1"
C_thr^2/2 = h_su - h_thr                      "inlet throat kinetic energy [J/kg]"
h_su_1 = h_su                                 "enthalpy after the inlet nozzle [J/kg]"
h_thr = enthalpy(Air, s=s_su, P=P_thr)        "inlet throat enthalpy [J/kg]"
P_thr = max(P_su_1, P_crit)                   "inlet throat pressure [Pa]"
P_crit = (2/(gamma + 1))^(gamma/(gamma - 1))*P_su   "inlet critical pressure [Pa]"
"Provisional value in the original, and not an equation: gamma = 1.4."
(T_thr + 273)/(T_su + 273) = (P_thr/P_su)^((gamma - 1)/gamma)   "isentropic relation, +273 as written [-]"
T_thr = temperature(Air, h=h_thr)             "inlet throat temperature [°C]"

"!Equivalent section"
M_dot = V_dot_thr_su/v_thr_su                 "fresh-charge mass flow [kg/s]"
v_thr_su = volume(Air, T=T_thr, P=P_thr)      "inlet throat specific volume [m^3/kg]"
V_dot_thr_su = C_thr*A_thr_su                 "inlet throat volume flow [m^3/s]"
d_su^2/4 = A_thr_su/PI                        "inlet throat diameter [m]"

"Pressure drop"
DELTAP_su = P_su - P_su_2                     "inlet pressure drop [Pa]"

"!Internal isentropic compression"
W_dot = M_dot_in*(h_ex_2 - h_su_2)            "shaft power from the internal flow [W]"
h_ex_2 = enthalpy(Air, s=s_su_2, P=P_ex)      "internal discharge enthalpy [J/kg]"
s_su_2 = entropy(Air, h=h_su_2, P=P_su_2)     "entropy at the internal inlet [J/kg-K]"
P_su_2 = P_su_1                               "mixing is isobaric; the leak does not set the inlet pressure [Pa]"

"!Swept volume"
V_dot_su_2 = N*V_s                            "displacement volume flow [m^3/s]"
V_dot_su_2 = M_dot_in*v_su_2                  "internal inlet volume flow [m^3/s]"
v_su_2 = volume(Air, h=h_su_2, P=P_su_2)      "internal inlet specific volume [m^3/kg]"

"Without internal leakage the original comments, and does not solve, M_dot = M_dot_in and h_su_1 = h_su_2."

"!Internal leakage, mixing"
M_dot_in = M_dot_l + M_dot                    "internal mass flow [kg/s]"
h_su_1*M_dot + h_ex_2*M_dot_l = M_dot_in*h_su_2   "mixing energy balance [W]"

"!Equivalent leakage nozzle"
h_thr_l + C_thr_l^2/2 = h_ex_2                "leakage throat energy balance [J/kg]"
h_thr_l = enthalpy(Air, s=s_ex_2, P=P_thr_l)  "leakage throat enthalpy [J/kg]"
s_ex_2 = entropy(Air, T=T_ex_2, P=P_ex)       "internal discharge entropy [J/kg-K]"
P_thr_l = max(P_su_1, P_crit_l)               "leakage throat pressure [Pa]"
P_crit_l = (2/(gamma_l + 1))^(gamma_l/(gamma_l - 1))*P_ex   "leakage critical pressure [Pa]"
"Provisional value in the original, and not an equation: gamma_l = 1.4."
"The pressure ratio below is P_thr/P_ex, as written in the equation window."
(T_thr_l + 273)/(T_ex_2 + 273) = (P_thr/P_ex)^((gamma_l - 1)/gamma_l)   "isentropic relation, +273 as written [-]"
T_ex_2 = temperature(Air, h=h_ex_2)           "internal discharge temperature [°C]"
T_thr_l = temperature(Air, h=h_thr_l)         "leakage throat temperature [°C]"
T_su_2 = temperature(Air, h=h_su_2)           "internal inlet temperature [°C], indicative as in the original"

"!Equivalent leakage section"
M_dot_l = V_dot_thr_l/v_thr_l                 "leakage mass flow [kg/s]"
v_thr_l = volume(Air, T=T_thr_l, P=P_thr_l)   "leakage throat specific volume [m^3/kg]"
V_dot_thr_l = C_thr_l*A_thr_leak              "leakage throat volume flow [m^3/s]"

"The original comments a pressure drop that grows with speed and a leak whose"
"effect falls, and that an optimum can be determined. No sweep is stored."

"!Similarity variables"
delta_w_1 = W_dot/M_dot - W_dot/M_dot_in      "specific-work effect of the internal leak [J/kg]"
delta_w_2 = v_su*DELTAP_su                    "specific-work effect of the inlet pressure drop [J/kg]"
v_su = volume(Air, T=T_su, P=P_su)            "suction specific volume [m^3/kg]"
delta_loss = delta_w_1 + delta_w_2            "sum of the two specific-work effects [J/kg]"
