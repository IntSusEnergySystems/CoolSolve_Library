{=============================================================================
  Steam turbine with isentropic efficiency (Cengel 7-104)
  CoolSolve Library model CSL-0174
 -----------------------------------------------------------------------------
  Steam at 8 MPa and 500 °C expands to 30 kPa in a turbine. The mass flow
  rate is 3 kg/s and the isentropic efficiency is 90 %. The source computes
  the specific work and the power output. Textbook exercise Cengel 7-104.

  Inputs : p_1, T_1, M_dot, p_2, epsilon_s
  Outputs: W_dot_out, w, T_2, h_2
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : S. Quoilin, KU Leuven, thermo_models - see README.md
=============================================================================}

"!Inputs, as in the original"
p_1 = 8e6                                    "inlet pressure [Pa]"
T_1 = 500                                    "inlet temperature [°C]"
M_dot = 3                                    "mass flow rate [kg/s]"
p_2 = 30e3                                   "exit pressure [Pa]"
epsilon_s = 0.9                              "isentropic efficiency [-]"

"!State 1"
h_1 = enthalpy(Water, p=p_1, T=T_1)          "inlet enthalpy [J/kg]"
s_1 = entropy(Water, p=p_1, T=T_1)           "inlet entropy [J/kg-K]"

"!State 2s (fictitious, ideal case)"
s_2s = s_1                                   "entropy of the isentropic exit [J/kg-K]"
p_2s = p_2                                   "pressure of the isentropic exit [Pa]"
h_2s = enthalpy(Water, p=p_2s, s=s_2s)       "enthalpy of the isentropic exit [J/kg]"
w_s = h_1 - h_2s                             "isentropic work, the maximum that can be produced in the ideal case [J/kg]"

"!State 2 (real case)"
epsilon_s = w/w_s                            "isentropic efficiency, as in the original [-]"
w = h_1 - h_2                                "real work, as in the original [J/kg]"
T_2 = temperature(Water, p=p_2, h=h_2)       "real exit temperature [°C]"

W_dot_out = M_dot*(h_1 - h_2)                "power output [W]"

"!State points for the thermodynamic diagrams (post-processing, no effect on the results)"
{1: inlet. 2: isentropic exit. 3: real exit.}
P[1] = p_1                                   "inlet pressure [Pa]"
h[1] = h_1                                   "inlet enthalpy [J/kg]"
T[1] = T_1                                   "inlet temperature [°C]"
s[1] = s_1                                   "inlet entropy [J/kg-K]"
P[2] = p_2s                                  "isentropic-exit pressure [Pa]"
h[2] = h_2s                                  "isentropic-exit enthalpy [J/kg]"
T[2] = temperature(Water, p=p_2s, h=h_2s)    "isentropic-exit temperature [°C]"
s[2] = s_2s                                  "isentropic-exit entropy [J/kg-K]"
P[3] = p_2                                   "real-exit pressure [Pa]"
h[3] = h_2                                   "real-exit enthalpy [J/kg]"
T[3] = T_2                                   "real-exit temperature [°C]"
s[3] = entropy(Water, p=p_2, h=h_2)          "real-exit entropy [J/kg-K]"
