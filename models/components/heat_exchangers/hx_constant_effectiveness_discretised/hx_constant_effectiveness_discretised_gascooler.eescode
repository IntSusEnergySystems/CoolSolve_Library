{=============================================================================
  Discretised constant-effectiveness heat exchanger with a minimum pinch
  CoolSolve Library model CSL-0127
 -----------------------------------------------------------------------------
  Translation of the LaboThapPy component HexCstEffDisc (counterflow HX split
  into n_disc equal-enthalpy segments) into EES-language equations. The duty
  Q_dot = epsilon*Q_dot_max is limited by the user maximum effectiveness
  eta_max, by an external ideal-outlet maximum heat, by an internal zero-pinch
  limit and by a minimum segment temperature difference Pinch_min; the Python
  effectiveness loops (1 % steps, bisection) become simultaneous equations
  closed by two min-based complementarities, with DUPLICATE-array profiles.
  File for case GasCooler of the original example: n_disc = 100, Pinch_min = 10 K, DP_h = DP_c = 50 kPa.
  Inputs : fluid_H$, T_su_H, P_su_H, M_dot_H; fluid_C$, T_su_C, P_su_C, M_dot_C; eta_max, n_disc, Pinch_min, DP_h, DP_c
  Outputs: Q_dot, epsilon, DT_pinch, outlet states, segment profiles
  Units  : SI - temperatures in degC, pressures in Pa, energies in J
  Source : LaboThapPy HexCstEffDisc, B. Chaudoir and E. Neven et al. (ULiege), commit f03f7f47 - see README.md
  Status : verified vs the original Python example (the original reduces
           epsilon in 1 % steps; the pinch here is continuous) - README.md
=============================================================================}

"!Inputs (case GasCooler of hex_csteff_disc_example.py)"
fluid_H$ = 'R744'             "hot side: CO2 (CoolProp 'CO2' maps to the EES real fluid R744; bare CO2 is the ideal-gas species)"
T_su_H = 176.85000000000002      "hot supply temperature [C] (450 K in the original)"
P_su_H = 18000000.0         "hot supply pressure [Pa]"
M_dot_H = 0.16                "hot mass flow rate [kg/s]"
fluid_C$ = 'Water'            "cold side: Water of the original"
T_su_C = 15.0     "cold supply temperature [C] (288.15 K in the original)"
P_su_C = 1000000.0            "cold supply pressure [Pa]"
M_dot_C = 0.1                "cold mass flow rate [kg/s]"
eta_max = 0.95                "user maximum effectiveness [-]"
n_disc = 100               "number of enthalpy segments [-] (the DUPLICATE bounds below use the literals 101 and 100)"
Pinch_min = 10                "minimum temperature difference, held at every segment [K]"
DP_h = 50000.0              "hot-side pressure drop, equally distributed over the segments [Pa]"
DP_c = 50000.0                "cold-side pressure drop, equally distributed over the segments [Pa]"

"!Inlet states and external maximum heat (as in find_Q_dot_max of the original)"
h_su_H = ENTHALPY(fluid_H$, T=T_su_H, P=P_su_H)   "hot inlet enthalpy [J/kg]"
h_su_C = ENTHALPY(fluid_C$, T=T_su_C, P=P_su_C)   "cold inlet enthalpy [J/kg]"
h_H_id = ENTHALPY(fluid_H$, T=T_su_C, P=P_su_H)   "hot fluid cooled to the cold inlet temperature [J/kg]"
h_C_id = ENTHALPY(fluid_C$, T=T_su_H, P=P_su_C)   "cold fluid heated to the hot inlet temperature [J/kg]"
Q_max_h = M_dot_H*(h_su_H - h_H_id)               "hot-side ideal duty [W]"
Q_max_c = M_dot_C*(h_C_id - h_su_C)               "cold-side ideal duty [W]"
Q_max_ext = MIN(Q_max_h, Q_max_c)                 "external maximum heat [W]"

"!Segment pressures, index i = 1..101 counted from the hot-inlet (cold-outlet) end;"
"the hot side flows towards increasing i, the cold side (counterflow) the other way"
DUPLICATE i=1,101
  p_hot[i] = P_su_H - (i-1)*DP_h/n_disc            "hot-side pressure [Pa]"
  p_cold[i] = P_su_C - (101-i)*DP_c/n_disc      "cold-side pressure at the same exchanger position [Pa]"
END

"!Temperature profiles at the unknown duty Q_dot, as in counterflow_discretized;"
"equal enthalpy steps, so the profiles are linear in the segment index"
DUPLICATE i=1,101
  h_hot[i] = h_su_H - (i-1)*Q_dot/(n_disc*M_dot_H)   "hot-side enthalpy profile [J/kg]"
  T_hot[i] = TEMPERATURE(fluid_H$, h=h_hot[i], P=p_hot[i])   "hot-side temperature [C]"
  h_cold[i] = h_su_C + Q_dot/M_dot_C - (i-1)*Q_dot/(n_disc*M_dot_C)   "cold-side enthalpy profile [J/kg] (i=1 is the cold outlet, as in the original)"
  T_cold[i] = TEMPERATURE(fluid_C$, h=h_cold[i], P=p_cold[i])   "cold-side temperature [C]"
  DT[i] = T_hot[i] - T_cold[i]                       "local temperature difference [K]"
END
DT_min[1] = DT[1]                                    "running minimum of DT [K]"
DT_min[2] = MIN(DT_min[1], DT[2])
DT_min[3] = MIN(DT_min[2], DT[3])
DT_min[4] = MIN(DT_min[3], DT[4])
DT_min[5] = MIN(DT_min[4], DT[5])
DT_min[6] = MIN(DT_min[5], DT[6])
DT_min[7] = MIN(DT_min[6], DT[7])
DT_min[8] = MIN(DT_min[7], DT[8])
DT_min[9] = MIN(DT_min[8], DT[9])
DT_min[10] = MIN(DT_min[9], DT[10])
DT_min[11] = MIN(DT_min[10], DT[11])
DT_min[12] = MIN(DT_min[11], DT[12])
DT_min[13] = MIN(DT_min[12], DT[13])
DT_min[14] = MIN(DT_min[13], DT[14])
DT_min[15] = MIN(DT_min[14], DT[15])
DT_min[16] = MIN(DT_min[15], DT[16])
DT_min[17] = MIN(DT_min[16], DT[17])
DT_min[18] = MIN(DT_min[17], DT[18])
DT_min[19] = MIN(DT_min[18], DT[19])
DT_min[20] = MIN(DT_min[19], DT[20])
DT_min[21] = MIN(DT_min[20], DT[21])
DT_min[22] = MIN(DT_min[21], DT[22])
DT_min[23] = MIN(DT_min[22], DT[23])
DT_min[24] = MIN(DT_min[23], DT[24])
DT_min[25] = MIN(DT_min[24], DT[25])
DT_min[26] = MIN(DT_min[25], DT[26])
DT_min[27] = MIN(DT_min[26], DT[27])
DT_min[28] = MIN(DT_min[27], DT[28])
DT_min[29] = MIN(DT_min[28], DT[29])
DT_min[30] = MIN(DT_min[29], DT[30])
DT_min[31] = MIN(DT_min[30], DT[31])
DT_min[32] = MIN(DT_min[31], DT[32])
DT_min[33] = MIN(DT_min[32], DT[33])
DT_min[34] = MIN(DT_min[33], DT[34])
DT_min[35] = MIN(DT_min[34], DT[35])
DT_min[36] = MIN(DT_min[35], DT[36])
DT_min[37] = MIN(DT_min[36], DT[37])
DT_min[38] = MIN(DT_min[37], DT[38])
DT_min[39] = MIN(DT_min[38], DT[39])
DT_min[40] = MIN(DT_min[39], DT[40])
DT_min[41] = MIN(DT_min[40], DT[41])
DT_min[42] = MIN(DT_min[41], DT[42])
DT_min[43] = MIN(DT_min[42], DT[43])
DT_min[44] = MIN(DT_min[43], DT[44])
DT_min[45] = MIN(DT_min[44], DT[45])
DT_min[46] = MIN(DT_min[45], DT[46])
DT_min[47] = MIN(DT_min[46], DT[47])
DT_min[48] = MIN(DT_min[47], DT[48])
DT_min[49] = MIN(DT_min[48], DT[49])
DT_min[50] = MIN(DT_min[49], DT[50])
DT_min[51] = MIN(DT_min[50], DT[51])
DT_min[52] = MIN(DT_min[51], DT[52])
DT_min[53] = MIN(DT_min[52], DT[53])
DT_min[54] = MIN(DT_min[53], DT[54])
DT_min[55] = MIN(DT_min[54], DT[55])
DT_min[56] = MIN(DT_min[55], DT[56])
DT_min[57] = MIN(DT_min[56], DT[57])
DT_min[58] = MIN(DT_min[57], DT[58])
DT_min[59] = MIN(DT_min[58], DT[59])
DT_min[60] = MIN(DT_min[59], DT[60])
DT_min[61] = MIN(DT_min[60], DT[61])
DT_min[62] = MIN(DT_min[61], DT[62])
DT_min[63] = MIN(DT_min[62], DT[63])
DT_min[64] = MIN(DT_min[63], DT[64])
DT_min[65] = MIN(DT_min[64], DT[65])
DT_min[66] = MIN(DT_min[65], DT[66])
DT_min[67] = MIN(DT_min[66], DT[67])
DT_min[68] = MIN(DT_min[67], DT[68])
DT_min[69] = MIN(DT_min[68], DT[69])
DT_min[70] = MIN(DT_min[69], DT[70])
DT_min[71] = MIN(DT_min[70], DT[71])
DT_min[72] = MIN(DT_min[71], DT[72])
DT_min[73] = MIN(DT_min[72], DT[73])
DT_min[74] = MIN(DT_min[73], DT[74])
DT_min[75] = MIN(DT_min[74], DT[75])
DT_min[76] = MIN(DT_min[75], DT[76])
DT_min[77] = MIN(DT_min[76], DT[77])
DT_min[78] = MIN(DT_min[77], DT[78])
DT_min[79] = MIN(DT_min[78], DT[79])
DT_min[80] = MIN(DT_min[79], DT[80])
DT_min[81] = MIN(DT_min[80], DT[81])
DT_min[82] = MIN(DT_min[81], DT[82])
DT_min[83] = MIN(DT_min[82], DT[83])
DT_min[84] = MIN(DT_min[83], DT[84])
DT_min[85] = MIN(DT_min[84], DT[85])
DT_min[86] = MIN(DT_min[85], DT[86])
DT_min[87] = MIN(DT_min[86], DT[87])
DT_min[88] = MIN(DT_min[87], DT[88])
DT_min[89] = MIN(DT_min[88], DT[89])
DT_min[90] = MIN(DT_min[89], DT[90])
DT_min[91] = MIN(DT_min[90], DT[91])
DT_min[92] = MIN(DT_min[91], DT[92])
DT_min[93] = MIN(DT_min[92], DT[93])
DT_min[94] = MIN(DT_min[93], DT[94])
DT_min[95] = MIN(DT_min[94], DT[95])
DT_min[96] = MIN(DT_min[95], DT[96])
DT_min[97] = MIN(DT_min[96], DT[97])
DT_min[98] = MIN(DT_min[97], DT[98])
DT_min[99] = MIN(DT_min[98], DT[99])
DT_min[100] = MIN(DT_min[99], DT[100])
DT_min[101] = MIN(DT_min[100], DT[101])
DT_pinch = DT_min[101]                              "minimum temperature difference over the segments [K]"

"!Internal profiles at the unknown internal maximum heat Q_dot_max (the"
"fictive-effectiveness search of the original), same equations as above"
DUPLICATE i=1,101
  h2_hot[i] = h_su_H - (i-1)*Q_dot_max/(n_disc*M_dot_H)
  T2_hot[i] = TEMPERATURE(fluid_H$, h=h2_hot[i], P=p_hot[i])
  h2_cold[i] = h_su_C + Q_dot_max/M_dot_C - (i-1)*Q_dot_max/(n_disc*M_dot_C)
  T2_cold[i] = TEMPERATURE(fluid_C$, h=h2_cold[i], P=p_cold[i])
  DT2[i] = T2_hot[i] - T2_cold[i]                    "[K]"
END
DT2_min[1] = DT2[1]
DT2_min[2] = MIN(DT2_min[1], DT2[2])
DT2_min[3] = MIN(DT2_min[2], DT2[3])
DT2_min[4] = MIN(DT2_min[3], DT2[4])
DT2_min[5] = MIN(DT2_min[4], DT2[5])
DT2_min[6] = MIN(DT2_min[5], DT2[6])
DT2_min[7] = MIN(DT2_min[6], DT2[7])
DT2_min[8] = MIN(DT2_min[7], DT2[8])
DT2_min[9] = MIN(DT2_min[8], DT2[9])
DT2_min[10] = MIN(DT2_min[9], DT2[10])
DT2_min[11] = MIN(DT2_min[10], DT2[11])
DT2_min[12] = MIN(DT2_min[11], DT2[12])
DT2_min[13] = MIN(DT2_min[12], DT2[13])
DT2_min[14] = MIN(DT2_min[13], DT2[14])
DT2_min[15] = MIN(DT2_min[14], DT2[15])
DT2_min[16] = MIN(DT2_min[15], DT2[16])
DT2_min[17] = MIN(DT2_min[16], DT2[17])
DT2_min[18] = MIN(DT2_min[17], DT2[18])
DT2_min[19] = MIN(DT2_min[18], DT2[19])
DT2_min[20] = MIN(DT2_min[19], DT2[20])
DT2_min[21] = MIN(DT2_min[20], DT2[21])
DT2_min[22] = MIN(DT2_min[21], DT2[22])
DT2_min[23] = MIN(DT2_min[22], DT2[23])
DT2_min[24] = MIN(DT2_min[23], DT2[24])
DT2_min[25] = MIN(DT2_min[24], DT2[25])
DT2_min[26] = MIN(DT2_min[25], DT2[26])
DT2_min[27] = MIN(DT2_min[26], DT2[27])
DT2_min[28] = MIN(DT2_min[27], DT2[28])
DT2_min[29] = MIN(DT2_min[28], DT2[29])
DT2_min[30] = MIN(DT2_min[29], DT2[30])
DT2_min[31] = MIN(DT2_min[30], DT2[31])
DT2_min[32] = MIN(DT2_min[31], DT2[32])
DT2_min[33] = MIN(DT2_min[32], DT2[33])
DT2_min[34] = MIN(DT2_min[33], DT2[34])
DT2_min[35] = MIN(DT2_min[34], DT2[35])
DT2_min[36] = MIN(DT2_min[35], DT2[36])
DT2_min[37] = MIN(DT2_min[36], DT2[37])
DT2_min[38] = MIN(DT2_min[37], DT2[38])
DT2_min[39] = MIN(DT2_min[38], DT2[39])
DT2_min[40] = MIN(DT2_min[39], DT2[40])
DT2_min[41] = MIN(DT2_min[40], DT2[41])
DT2_min[42] = MIN(DT2_min[41], DT2[42])
DT2_min[43] = MIN(DT2_min[42], DT2[43])
DT2_min[44] = MIN(DT2_min[43], DT2[44])
DT2_min[45] = MIN(DT2_min[44], DT2[45])
DT2_min[46] = MIN(DT2_min[45], DT2[46])
DT2_min[47] = MIN(DT2_min[46], DT2[47])
DT2_min[48] = MIN(DT2_min[47], DT2[48])
DT2_min[49] = MIN(DT2_min[48], DT2[49])
DT2_min[50] = MIN(DT2_min[49], DT2[50])
DT2_min[51] = MIN(DT2_min[50], DT2[51])
DT2_min[52] = MIN(DT2_min[51], DT2[52])
DT2_min[53] = MIN(DT2_min[52], DT2[53])
DT2_min[54] = MIN(DT2_min[53], DT2[54])
DT2_min[55] = MIN(DT2_min[54], DT2[55])
DT2_min[56] = MIN(DT2_min[55], DT2[56])
DT2_min[57] = MIN(DT2_min[56], DT2[57])
DT2_min[58] = MIN(DT2_min[57], DT2[58])
DT2_min[59] = MIN(DT2_min[58], DT2[59])
DT2_min[60] = MIN(DT2_min[59], DT2[60])
DT2_min[61] = MIN(DT2_min[60], DT2[61])
DT2_min[62] = MIN(DT2_min[61], DT2[62])
DT2_min[63] = MIN(DT2_min[62], DT2[63])
DT2_min[64] = MIN(DT2_min[63], DT2[64])
DT2_min[65] = MIN(DT2_min[64], DT2[65])
DT2_min[66] = MIN(DT2_min[65], DT2[66])
DT2_min[67] = MIN(DT2_min[66], DT2[67])
DT2_min[68] = MIN(DT2_min[67], DT2[68])
DT2_min[69] = MIN(DT2_min[68], DT2[69])
DT2_min[70] = MIN(DT2_min[69], DT2[70])
DT2_min[71] = MIN(DT2_min[70], DT2[71])
DT2_min[72] = MIN(DT2_min[71], DT2[72])
DT2_min[73] = MIN(DT2_min[72], DT2[73])
DT2_min[74] = MIN(DT2_min[73], DT2[74])
DT2_min[75] = MIN(DT2_min[74], DT2[75])
DT2_min[76] = MIN(DT2_min[75], DT2[76])
DT2_min[77] = MIN(DT2_min[76], DT2[77])
DT2_min[78] = MIN(DT2_min[77], DT2[78])
DT2_min[79] = MIN(DT2_min[78], DT2[79])
DT2_min[80] = MIN(DT2_min[79], DT2[80])
DT2_min[81] = MIN(DT2_min[80], DT2[81])
DT2_min[82] = MIN(DT2_min[81], DT2[82])
DT2_min[83] = MIN(DT2_min[82], DT2[83])
DT2_min[84] = MIN(DT2_min[83], DT2[84])
DT2_min[85] = MIN(DT2_min[84], DT2[85])
DT2_min[86] = MIN(DT2_min[85], DT2[86])
DT2_min[87] = MIN(DT2_min[86], DT2[87])
DT2_min[88] = MIN(DT2_min[87], DT2[88])
DT2_min[89] = MIN(DT2_min[88], DT2[89])
DT2_min[90] = MIN(DT2_min[89], DT2[90])
DT2_min[91] = MIN(DT2_min[90], DT2[91])
DT2_min[92] = MIN(DT2_min[91], DT2[92])
DT2_min[93] = MIN(DT2_min[92], DT2[93])
DT2_min[94] = MIN(DT2_min[93], DT2[94])
DT2_min[95] = MIN(DT2_min[94], DT2[95])
DT2_min[96] = MIN(DT2_min[95], DT2[96])
DT2_min[97] = MIN(DT2_min[96], DT2[97])
DT2_min[98] = MIN(DT2_min[97], DT2[98])
DT2_min[99] = MIN(DT2_min[98], DT2[99])
DT2_min[100] = MIN(DT2_min[99], DT2[100])
DT2_min[101] = MIN(DT2_min[100], DT2[101])
DT2_pinch = DT2_min[101]                            "minimum difference of the zero-pinch profiles [K]"
cap = MIN(Q_max_ext - Q_dot_max, DT2_pinch)          "complementarity: Q_dot_max = smaller of external and zero-pinch heat [W]"
cap = 0

"!Final selection: the 1 % effectiveness loop of the original, recast as a"
"simultaneous constraint: Q_dot is the smaller of the heat whose minimum"
"segment difference equals Pinch_min and of the eta_max share of Q_dot_max"
comp = MIN(DT_pinch - Pinch_min, eta_max*Q_dot_max - Q_dot)   "complementarity closing Q_dot [W]"
comp = 0
epsilon = Q_dot/Q_dot_max                            "effectiveness finally used [-]"

"!Outlet states (as in update_connectors of the original)"
h_ex_C = h_su_C + Q_dot/M_dot_C                      "cold outlet enthalpy [J/kg]"
p_ex_C = P_su_C - DP_c                               "cold outlet pressure [Pa]"
T_ex_C = TEMPERATURE(fluid_C$, h=h_ex_C, P=p_ex_C)   "cold outlet temperature [C]"
h_ex_H = h_su_H - Q_dot/M_dot_H                      "hot outlet enthalpy [J/kg]"
p_ex_H = P_su_H - DP_h                               "hot outlet pressure [Pa]"
T_ex_H = TEMPERATURE(fluid_H$, h=h_ex_H, P=p_ex_H)   "hot outlet temperature [C]"

"!Diagnostics (no effect on the solution)"
DT_hot_end = T_su_H - T_ex_C                         "temperature difference at the hot-inlet end [K]"
DT_cold_end = T_ex_H - T_su_C                        "temperature difference at the cold-inlet end [K]"
