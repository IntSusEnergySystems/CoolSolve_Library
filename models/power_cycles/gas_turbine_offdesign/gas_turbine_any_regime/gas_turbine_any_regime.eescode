{=============================================================================
  Single-shaft gas turbine at any regime
  CoolSolve Library model CSL-0220
 -----------------------------------------------------------------------------
  Exercise (MSTh - SB - R9 - Exercice 2): one shaft, a compressor, an
  adiabatic combustor and an expander. Methane (m_f = 1, n_f = 4) in air.
  The compressor reduced flow and isentropic efficiency come from a
  three-row map versus the pressure ratio. The expander reduced flow and
  isentropic efficiency are constant, under the heading "any regime" in
  the original. The combustor has a 5 % pressure loss, as written.
  Mechanical losses are not in the window. Compressor work uses CP(Air).
  The products use the copied cpbar and gamma routines. The +273 in the
  isentropic relations is the one written in the original.

  Inputs : T_1, P_1, T_3, LHV_f, M_R_e, epsilon_s_e, map lookup_1, m_f, n_f
  Outputs: W_dot_sh, eta, r_p_c, M_dot_a, M_dot_f, epsilon_s_c, M_R_c
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège MSTh repetition R9, exercise 2, Stéphane Bertagnolio
           - see README.md
=============================================================================}

{--- PROCEDURE cpbar and FUNCTION gamma ---
  The equation window calls cpbar and gamma and does not define them.
  Copied from gas_turbine_part_load. cpbar is a five-output procedure;
  the original calls it in function position, transcribed here as CALL.
  That form is valid EES, so this is not a variant for that reason.
  gamma stays a function call.}

PROCEDURE cpbar(m,n,f,T_p1,T_p2:c_bar_p,Q_4,x,e_min,e)

{CPBAR procedure returns cp_bar (J/kg.K) of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of fuel (m and n),
the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2) in °C.

In the case of incomplete combustion (negative excess air value), the procedure
returns also : the energy losses by CO (Q_4 in J/kg of fuel), the fraction (x) of C
atoms oxidized into CO2 and the mininum excess air (e_min) to get x>0.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the procedure returns the specific heat for pure air if f=0 (whatever m and n).

When using this procedure, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
IF (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
If (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Default values (in the case of complete combustion)"
Q_4 = 0
x = 1
e_min = 0
e = 0

"Removable singularity: for T_p1 = T_p2 the mean specific heat is 0/0 (its limit is cp(T)).
Below 0.01 K the mean is taken over a 0.01 K window centred on the mean temperature."
IF (ABS(T_p1-T_p2)<0.01) THEN
  T_hi = (T_p1+T_p2)/2+0.005
  T_lo = (T_p1+T_p2)/2-0.005
ELSE
  T_hi = T_p1
  T_lo = T_p2
ENDIF

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2) ; MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)

IF (f>0) Then "combustion products (not pure air)"

"f  stoichiometric, excess air and f"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then "air deficiency"

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
e_min = -m/(2*parfuel) "to ensure x>0"
f_max = f_st/(1+e_min)

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
mmprod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2,T=T_lo))*MM_CO2
h_CO = (enthalpy(CO,T=T_hi)-enthalpy(CO,T=T_lo))*MM_CO
h_H2O =(enthalpy(H2O,T=T_hi)-enthalpy(H2O,T=T_lo))*MM_H2O
h_N2 = (enthalpy(N2,T=T_hi)-enthalpy(N2,T=T_lo))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/mmprod)/(T_hi-T_lo)

"Unburned-CO losses per kmol of fuel"
T_ref = 25
LHV_CO_mol = enthalpy(CO,T=T_ref)*MM_CO+0.5*enthalpy(O2,T=T_ref)*MM_O2-ENTHALPY(CO2,T=T_ref)*MM_CO2
LHV_CO_mas = LHV_CO_mol/MM_CO
Q_4 = LHV_CO_mol*b

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy and mean specific heat of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2, T=T_lo))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_hi)-enthalpy(H2O, T=T_lo))*MM_H2O
hp_3 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
hp_4 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
c_bar_p  = hp/(T_hi-T_lo)

ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
ha_2 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
c_bar_p  = ha/(T_hi-T_lo)
ENDIF

END


FUNCTION gamma (m,n,f,T_p1,T_p2)

{GAMMA  function returns the specific heats ratio of the combustion products of a CmHn
hydrocarbon between two temperatures. The inputs are : the type of
fuel (m and n), the fuel-air ratio (f) and  the two temperatures (T_p1 and T_p2)
in °C.

Simplified air is used. In the case of incomplete combustion, it is also assumed that
there is no O2 in the combustion products.

Moreover, the function returns the specific heats for pure air if f=0 (whatever m and n).

When using this function, don't forget to set mass basis calculation in the unit system
settings.}

"Check of the units setting"
If (unitsystem('K')=1)  THEN CALL error('Please, set °C for temperature units!')
IF (unitsystem('Molar')=1)  then CALL error('Please, set Mass basis!')

"Removable singularity: for T_p1 = T_p2 the mean specific heat is 0/0 (its limit is cp(T)).
Below 0.01 K the mean is taken over a 0.01 K window centred on the mean temperature."
IF (ABS(T_p1-T_p2)<0.01) THEN
  T_hi = (T_p1+T_p2)/2+0.005
  T_lo = (T_p1+T_p2)/2-0.005
ELSE
  T_hi = T_p1
  T_lo = T_p2
ENDIF

"Composition of simplified air"
x_air_N2 = 0.79 ; x_air_O2= 0.21

"Universal gas constant"
R_u = 8314 "J/kmol.K"

"Molar masses of the species"
MM_CO = molarmass(CO) ; MM_N2 = molarmass(N2); MM_O2 = molarmass(O2)
MM_CO2 = molarmass(CO2) ; MM_H2O = molarmass(H2O)


IF (f>0) Then

"Stoichiometric combustion : CmHn+(m+n/4)*(O2+(79/21)*N2"
parfuel = m+n/4
MM_f = 12*m+1*n
f_st = MM_f/(parfuel*(MM_O2+(x_air_N2/x_air_O2)*MM_N2))
e = (f_st/f)-1

IF (f>f_st) Then

"Assumption : enough air to oxidize H to H2O and no O2 in the flue gases"
"Hence : CmHn+(m+n/4)*(O2+(79/21)*N2)*(1+e) = a*CO2+b*CO+c*H2O+g*N2"
g = parfuel*(1+e)*(79/21)
c = n/2
x=2*(e*parfuel+m/2)/m
a = m*x "x is the fraction of the C atoms oxidized into CO2"
b = m*(1-x)
"Molar fractions of the constituents"
nkmoltot = a+ b + c +g
x_CO2 = a/nkmoltot
x_CO = b/nkmoltot
x_H2O = c/nkmoltot
x_N2 = g/nkmoltot
MM_prod = x_CO2*MM_CO2+x_CO*MM_CO+x_H2O*MM_H2O+x_N2*MM_N2
"!Mean c_p of combustion products"
h_CO2 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2,T=T_lo))*MM_CO2
h_CO = (enthalpy(CO,T=T_hi)-enthalpy(CO,T=T_lo))*MM_CO
h_H2O =(enthalpy(H2O,T=T_hi)-enthalpy(H2O,T=T_lo))*MM_H2O
h_N2 = (enthalpy(N2,T=T_hi)-enthalpy(N2,T=T_lo))*MM_N2
c_bar_p = ((x_CO2*h_CO2+x_CO*h_CO+x_H2O*h_H2O+x_N2*h_N2)/MM_prod)/(T_hi-T_lo)
gamma = c_bar_p/(c_bar_p-R_u/MM_prod)

ELSE

"Molar fractions of the constituents"
nkmoltot = m+ n/2 + parfuel*(e+(1+e)*(x_air_N2/x_air_O2))
x_CO2 = m/nkmoltot
x_H2O = (n/2)/nkmoltot
x_O2 = parfuel*e/nkmoltot
x_N2 = parfuel*(1+e)*(x_air_N2/x_air_O2)/nkmoltot

"Molar mass of combustion products"
MM_prod = x_CO2*MM_CO2+x_H2O*MM_H2O+x_O2*MM_O2+x_N2*MM_N2

"Enthalpy, specific heat and gamma of combustion products [per kg of products]"
hp_1 = (enthalpy(CO2,T=T_hi)-enthalpy(CO2, T=T_lo))*MM_CO2
hp_2 = (enthalpy(H2O,T=T_hi)-enthalpy(H2O, T=T_lo))*MM_H2O
hp_3 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
hp_4 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
hp = (x_CO2*hp_1+x_H2O*hp_2+x_O2*hp_3+x_N2*hp_4)/MM_prod
cpbar  = hp/(T_hi-T_lo)
gamma = cpbar/(cpbar-R_u/MM_prod)
ENDIF

ELSE

"Pure air case"
MM_a = x_air_O2*MM_O2+x_air_N2*MM_N2
ha_1 = (enthalpy(O2,T=T_hi)-enthalpy(O2, T=T_lo))*MM_O2
ha_2 = (enthalpy(N2,T=T_hi)-enthalpy(N2, T=T_lo))*MM_N2
ha = (x_air_O2*ha_1+x_air_N2*ha_2)/MM_a
cpbar  = ha/(T_hi-T_lo)
gamma = cpbar/(cpbar-R_u/MM_a)
ENDIF

END

"MSTh - SB - R9 - Exercice 2"

"Data, as in the original."
T_1 = 15                                      "inlet temperature [C]"
P_1 = 1.01E5                                  "inlet pressure [Pa]"
LHV_f = 50E6                                  "fuel lower heating value [J/kg]"

"Reduced quantities, as in the original."
"N_R = N/sqrt(T_1+273) is a comment in the original, not an equation."
M_R_c = M_dot_a*sqrt(T_1+273)/(P_1/100000)    "compressor reduced mass flow [(kg/s)*sqrt(K)/bar]"
r_p_c = P_2/P_1                               "compressor pressure ratio [-]"
M_R_e = M_dot_p*sqrt(T_3+273)/(P_3/100000)    "expander reduced mass flow [(kg/s)*sqrt(K)/bar]"

"Nominal regime: the three rows of parametric Table 1, shipped as lookup_1."
"The window writes INTERPOLATE('M_R_c','r_p_c',r_p_c=r_p_c) and the same for epsilon_s_c."
M_R_c = INTERPOLATE('lookup_1','M_R_c','r_p_c',r_p_c=r_p_c)           "reduced flow from the map [(kg/s)*sqrt(K)/bar]"
epsilon_s_c = INTERPOLATE('lookup_1','epsilon_s_c','r_p_c',r_p_c=r_p_c)  "compressor isentropic efficiency from the map [-]"

"Any regime, as in the original."
M_R_e = 14.2                                  "expander reduced mass flow, constant [(kg/s)*sqrt(K)/bar]"
epsilon_s_e = 0.85                            "expander isentropic efficiency, constant [-]"

"Single-shaft turbine, as in the original."
"Operating point used."
"Provisional value (see the table), kept as an equation, as in the original."
T_3 = 850                                     "turbine inlet temperature [C]"

f = M_dot_f/M_dot_a                           "fuel-air ratio [-]"
M_dot_f+M_dot_a = M_dot_p                     "product mass flow rate [kg/s]"

"Compressor."
(T_2_s+273)/(T_1+273) = (P_2/P_1)^((gamma_c-1)/gamma_c)  "isentropic compression; +273 as in the original [-]"
gamma_c = gamma(m_f,n_f,0,T_1,T_2)           "ratio of specific heats of air (f = 0) [-]"
m_f = 1                                       "carbon atoms in CmHn [-]"
n_f = 4                                       "hydrogen atoms in CmHn [-]"
"Provisional value in the original, a comment, not an equation: gamma_c = 1.4."
epsilon_s_c*(T_2-T_1) = (T_2_s-T_1)           "as in the original [-]"

w_c = cp_a_c*(T_2-T_1)                        "compressor specific work [J/kg]"
cp_a_c = CP(Air,T=T_m_c)                      "mean specific heat of air [J/kg-K]"
T_m_c = (T_2+T_1)/2                           "temperature at which cp_a_c is evaluated [C]"

"Adiabatic combustion chamber."
q_1+q_2+q_3+q_4+q_5 = 0                       "combustor energy balance [J/kg-air]"
T_ref = 25                                    "reference temperature [C]"
q_1 = cp_a_1*(T_ref-T_2)                      "air from the compressor exit to 25 C [J/kg-air]"
cp_a_1 = CP(Air,T=((T_ref+T_2)/2))            "specific heat of air [J/kg-K]"
q_2 = cp_g*(T_ref-T_1)                        "as in the original [J/kg-air]"
cp_g = CP(CH4,T=((T_ref+T_1)/2))              "specific heat of methane [J/kg-K]"
q_3 = -f*LHV_f                                "fuel heating value [J/kg-air]"
q_4 = 0                                       "as in the original [J/kg-air]"
q_5 = (1+f)*cp_p_23*(T_3-T_ref)               "products from 25 C to T_3 [J/kg-air]"
CALL cpbar(m_f,n_f,f,T_ref,T_3:cp_p_23,Q_4_23,x_23,e_min_23,e_23)  "mean specific heat of the products [J/kg-K]"
"Provisional value in the original, a comment, not an equation: cp_p_23 = 1200."
P_3 = 0.95*P_2                                "5 % pressure loss, as in the original [Pa]"

"Expander."
P_4 = P_1                                     "expander exit pressure [Pa]"
(T_4_s+273)/(T_3+273) = (P_4/P_3)^((gamma_e-1)/gamma_e)  "isentropic expansion; +273 as in the original [-]"
gamma_e = gamma(m_f,n_f,f,T_3,T_4)           "ratio of specific heats of the products [-]"
"Provisional value in the original, a comment, not an equation: gamma_e = 1.4."
epsilon_s_e*(T_3-T_4_s) = (T_3-T_4)           "as in the original [-]"

w_e = cp_p_34*(T_3-T_4)                       "expander specific work [J/kg]"
CALL cpbar(m_f,n_f,f,T_3,T_4:cp_p_34,Q_4_34,x_34,e_min_34,e_34)  "mean specific heat over the expansion [J/kg-K]"
"Provisional value in the original, a comment, not an equation: cp_p_34 = 1200."

"Power."
W_dot_sh = M_dot_a*w                          "shaft power [W]"
w = (1+f)*w_e-w_c                             "net specific work per kg of air [J/kg]"
eta = W_dot_sh/Q_dot_c                        "as in the original [-]"
Q_dot_c = M_dot_f*LHV_f                       "fuel power [W]"
