{===========================================================================
  SEGS solar thermal power plant (TESPy validation model)
  CoolSolve Library model CSL-0147
 ---------------------------------------------------------------------------
  Steady-state SEGS VI-type parabolic-trough solar power plant from the
  TESPy-Ebsilon validation study of Witte et al. (2022): a Therminol VP-1
  solar field with HTF pump feeding the steam generator (superheater,
  evaporator with drum, economiser) and the reheater, a regenerative Rankine
  cycle with 7 turbine stages and 5 feedwater preheaters with subcoolers,
  a condenser with a wet cooling tower, and the generator/motor power chain.
  States are named after the TESPy connection labels (m_1, p_1, h_1, T_1 =
  connection "1"), so every equation maps 1:1 to the source. Units: SI,
  temperatures in degC, pressures in Pa, energies in J. Therminol VP-1 is
  evaluated with the correlations of library model CSL-0121 (the CoolProp
  incompressible fluid INCOMP::TVP1 of the source is unavailable).
  Source: TESPy tests/test_models/test_solar_energy_generating_system.py,
  commit 19425523 (F. Witte, I. Tuschy et al., MIT) - see README.md.
  Status: verified vs the re-run of the source (see README.md).
 ===========================================================================}

"!HTF properties (Therminol VP-1, correlations of CSL-0121: fit of the HEDH
heat-transfer-fluid data sheet HTF-VP1; CoolProp fluid of the source: INCOMP::TVP1)"
FUNCTION h_htf(T)
  h_htf = 1000*(1.498*T + 0.001207*T^2 + 1.9863667E-6*T^3 - 7.46975E-9*T^4 + 8.8344E-12*T^5) "specific enthalpy, cp of CSL-0121 integrated from 0 degC [J/kg]"
END
FUNCTION rho_htf(T)
  rho_htf = 1083.25 - 0.90797*T + 0.00078116*T^2 - 2.367E-6*T^3 "density [kg/m^3]"
END

"!Fixed data (TESPy test setup; bars converted to Pa)"
pamb = 1.013E5                            "ambient pressure [Pa]"
p_79 = 41.024E5                           "HTF at the solar field inlet [Pa]"
T_70 = 390                                "HTF at the solar field outlet [degC]"
p_70 = 23.304E5                           "HTF pressure at the solar field outlet [Pa]"
p_73 = 22.753E5                           "HTF at the superheater outlet [Pa]"
p_74 = 21.167E5                           "HTF at the evaporator outlet [Pa]"
p_78 = 20.34E5                            "HTF at the HTF pump inlet [Pa]"
p_1 = 100E5                               "live steam pressure [Pa]"
T_1 = 371                                 "live steam temperature [degC]"
p_3 = 33.61E5                             "HP turbine 1 exhaust [Pa]"
m_3 = 38.969                              "main steam mass flow [kg/s]"
p_5 = 18.58E5                             "HP turbine 2 exhaust [Pa]"
p_7 = 17.1E5                              "reheat pressure [Pa]"
T_7 = 371                                 "reheat temperature [degC]"
p_8 = 7.98E5                              "LP turbine 1 exhaust [Pa]"
p_10 = 2.73E5                             "LP turbine 2 exhaust [Pa]"
p_12 = 0.96E5                             "LP turbine 3 exhaust [Pa]"
p_14 = 0.29E5                             "LP turbine 4 exhaust [Pa]"
p_16 = 0.08E5                             "LP turbine 5 exhaust / condenser pressure [Pa]"
p_19 = 14.755E5                           "condensate at the condenser pump outlet [Pa]"
p_21 = 9.9975E5                           "feedwater at low pressure preheater 1 outlet [Pa]"
p_23 = 8.7012E5                           "feedwater at low pressure preheater 2 outlet [Pa]"
p_27 = 125E5                              "feedwater at the feedwater pump outlet [Pa]"
p_29 = 112E5                              "feedwater at high pressure preheater 1 outlet [Pa]"
p_31 = 103.56E5                           "feedwater at the economiser inlet [Pa]"
p_35 = 103.42E5                           "drum pressure [Pa]"
p_62 = pamb                               "cooling water at the cooling tower outlet [Pa]"
T_62 = 30                                 "cooling water at the cooling tower outlet [degC]"
p_64 = pamb                               "ambient air at the fan inlet [Pa]"
T_64 = 25                                 "ambient air at the fan inlet [degC]"
p_65 = pamb + 50                          "air at the fan outlet (pamb + 0.0005 bar) [Pa]"
p_66 = pamb                               "air at the cooling tower outlet [Pa]"
T_66 = 30                                 "air at the cooling tower outlet [degC]"
eta_hpt1 = 0.8376                         "isentropic efficiency HP turbine 1 [-]"
eta_hpt2 = 0.8463                         "isentropic efficiency HP turbine 2 [-]"
eta_lpt1 = 0.8623                         "isentropic efficiency LP turbine 1 [-]"
eta_lpt2 = 0.917                          "isentropic efficiency LP turbine 2 [-]"
eta_lpt3 = 0.9352                         "isentropic efficiency LP turbine 3 [-]"
eta_lpt4 = 0.88                           "isentropic efficiency LP turbine 4 [-]"
eta_lpt5 = 0.6445                         "isentropic efficiency LP turbine 5 [-]"
eta_ptpump = 0.6                          "isentropic efficiency HTF pump [-]"
eta_condpump = 0.7                        "isentropic efficiency condenser pump [-]"
eta_fwp = 0.7                             "isentropic efficiency feedwater pump [-]"
eta_cwp = 0.7                             "isentropic efficiency cooling water pump [-]"
eta_fan = 0.6                             "isentropic efficiency cooling tower fan [-]"
eta_gen = 0.97                            "generator efficiency [-]"
eta_mot = 0.95                            "motor efficiency [-]"
ttd_eva = 5                               "terminal temperature difference at the evaporator cold inlet [K]"
ttd_cond = 5                              "terminal temperature difference at the condenser cold outlet [K]"
ttd_fwh = 5                               "terminal temperature difference at each preheater hot inlet [K]"
ttd_sub = 10                              "terminal temperature difference at each subcooler hot outlet [K]"
td_bubble = 2                             "subcooling of the economiser outlet [K]"
x_34 = 0.5                                "vapour quality at the evaporator outlet [-]"
ratio_reh = 0.1284                        "HTF mass flow fraction to the reheater [-]"

"!Solar field and HTF loop (fluid INCOMP::TVP1 in the source; h from the cp of CSL-0121)"
m_76 = ratio_reh*m_70                     "HTF flow to the reheater [kg/s]"
m_72 + m_76 = m_71                        "HTF splitter 7 [kg/s]"
m_73 = m_72                               "superheater hot side [kg/s]"
m_74 = m_73                               "evaporator hot side [kg/s]"
m_75 = m_74                               "economiser hot side [kg/s]"
m_77 = m_76                               "reheater hot side [kg/s]"
m_78 = m_75 + m_77                        "HTF merge 5 [kg/s]"
m_79 = m_78                               "HTF pump [kg/s]"
m_70 = m_79                               "solar field mass balance [kg/s]"
h_70 = h_htf(T_70)                        "HTF at the solar field outlet [J/kg]"
h_71 = h_70                               "cycle closer of the HTF loop [J/kg]"
h_72 = h_71                               "HTF splitter 7 [J/kg]"
h_76 = h_71                               "HTF splitter 7 [J/kg]"
p_71 = p_70                               "cycle closer of the HTF loop [Pa]"
p_72 = p_71                               "HTF splitter 7 [Pa]"
p_76 = p_71                               "HTF splitter 7 [Pa]"
h_79 = h_htf(T_79)                        "HTF at the solar field inlet [J/kg]"
h_79s = h_78 + (p_79 - p_78)/rho_htf(T_78) "isentropic pump outlet, incompressible liquid [J/kg]"
h_79s - h_78 = eta_ptpump*(h_79 - h_78)   "HTF pump isentropic efficiency [-]"
P_ptpump = m_79*(h_79 - h_78)             "HTF pump power [W]"
Q_sol = m_70*(h_70 - h_79)                "solar heat delivered to the HTF loop [W]"

"!Steam generator: superheater, evaporator with drum, economiser (hot side HTF)"
h_73 = h_htf(T_73)                        "HTF at the superheater outlet [J/kg]"
h_74 = h_htf(T_74)                        "HTF at the evaporator outlet [J/kg]"
h_75 = h_htf(T_75)                        "HTF at the economiser outlet [J/kg]"
h_77 = h_htf(T_77)                        "HTF at the reheater outlet [J/kg]"
h_78 = h_htf(T_78)                        "HTF at the HTF pump inlet [J/kg]"
m_72*(h_72 - h_73) = m_35*(h_1 - h_35)    "superheater energy balance [W]"
m_73*(h_73 - h_74) = m_33*(h_34 - h_33)   "evaporator energy balance [W]"
T_74 = T_33 + ttd_eva                     "evaporator terminal temperature difference [K]"
m_74*(h_74 - h_75) = m_32*(h_32 - h_31)   "economiser energy balance [W]"
m_76*(h_76 - h_77) = m_6*(h_7 - h_6)      "reheater energy balance [W]"
m_75*h_75 + m_77*h_77 = m_78*h_78         "HTF merge 5 energy balance [J/kg]"
p_75 = p_78                               "HTF merge 5 pressure equality [Pa]"
p_77 = p_78                               "HTF merge 5 pressure equality [Pa]"

"!Drum (in1 = economiser outlet, in2 = evaporator outlet, out1 = saturated liquid,
 out2 = saturated vapour, all ports at the drum pressure)"
h_33 = ENTHALPY(Water, P=p_33, x=0)       "drum liquid outlet on the saturation line [J/kg]"
h_35 = ENTHALPY(Water, P=p_35, x=1)       "drum vapour outlet on the saturation line [J/kg]"
h_34 = ENTHALPY(Water, P=p_34, x=x_34)    "evaporator outlet [J/kg]"
p_32 = p_35                               "drum pressure equality [Pa]"
p_33 = p_35                               "drum pressure equality [Pa]"
p_34 = p_35                               "drum pressure equality [Pa]"
m_32 + m_34 = m_33 + m_35                 "drum mass balance [kg/s]"
m_32*h_32 + m_34*h_34 = m_33*h_33 + m_35*h_35 "drum energy balance [W]"
m_33 = m_34                               "evaporator cold side mass balance [kg/s]"
m_32 = m_31                               "economiser cold side mass balance [kg/s]"
T_33 = TEMPERATURE(Water, P=p_33, x=0)    "saturation temperature in the drum [degC]"
T_32 = T_33 - td_bubble                   "economiser outlet subcooling [K]"
h_32 = ENTHALPY(Water, P=p_32, T=T_32)    "economiser outlet enthalpy [J/kg]"

"!Turbines and extractions (isentropic efficiency; fixed exhaust pressures)"
h_2 = h_1                                 "cycle closer of the power cycle [J/kg]"
p_2 = p_1                                 "cycle closer of the power cycle [Pa]"
m_1 = m_35                                "main steam mass flow [kg/s]"
h_1 = ENTHALPY(Water, P=p_1, T=T_1)       "live steam [J/kg]"
h_7 = ENTHALPY(Water, P=p_7, T=T_7)       "reheated steam [J/kg]"
m_4 + m_36 = m_3                          "splitter 1 mass balance [kg/s]"
m_3 = m_2                                 "HP turbine 1 mass balance [kg/s]"
h_4 = h_3                                 "splitter 1 [J/kg]"
h_36 = h_3                                "splitter 1 [J/kg]"
p_4 = p_3                                 "splitter 1 [Pa]"
p_36 = p_3                                "splitter 1 [Pa]"
m_6 + m_40 = m_5                          "splitter 2 mass balance [kg/s]"
h_6 = h_5                                 "splitter 2 [J/kg]"
h_40 = h_5                                "splitter 2 [J/kg]"
p_6 = p_5                                 "splitter 2 [Pa]"
p_40 = p_5                                "splitter 2 [Pa]"
m_9 + m_45 = m_8                          "splitter 3 mass balance [kg/s]"
m_8 = m_7                                 "LP turbine 1 mass balance [kg/s]"
h_9 = h_8                                 "splitter 3 [J/kg]"
h_45 = h_8                                "splitter 3 [J/kg]"
p_9 = p_8                                 "splitter 3 [Pa]"
p_45 = p_8                                "splitter 3 [Pa]"
m_11 + m_46 = m_10                        "splitter 4 mass balance [kg/s]"
m_10 = m_9                                "LP turbine 2 mass balance [kg/s]"
h_11 = h_10                               "splitter 4 [J/kg]"
h_46 = h_10                               "splitter 4 [J/kg]"
p_11 = p_10                               "splitter 4 [Pa]"
p_46 = p_10                               "splitter 4 [Pa]"
m_13 + m_50 = m_12                        "splitter 5 mass balance [kg/s]"
m_12 = m_11                               "LP turbine 3 mass balance [kg/s]"
h_13 = h_12                               "splitter 5 [J/kg]"
h_50 = h_12                               "splitter 5 [J/kg]"
p_13 = p_12                               "splitter 5 [Pa]"
p_50 = p_12                               "splitter 5 [Pa]"
m_15 + m_55 = m_14                        "splitter 6 mass balance [kg/s]"
m_14 = m_13                               "LP turbine 4 mass balance [kg/s]"
h_15 = h_14                               "splitter 6 [J/kg]"
h_55 = h_14                               "splitter 6 [J/kg]"
p_15 = p_14                               "splitter 6 [Pa]"
p_55 = p_14                               "splitter 6 [Pa]"
m_5 = m_4                                 "HP turbine 2 mass flow [kg/s]"
m_7 = m_6                                 "LP turbine 1 mass flow [kg/s]"
m_16 = m_15                               "LP turbine 5 mass flow [kg/s]"
s_2 = ENTROPY(Water, P=p_2, h=h_2)        "HP turbine 1 inlet entropy [J/kg-K]"
h_3s = ENTHALPY(Water, P=p_3, s=s_2)      "HP turbine 1 isentropic exhaust [J/kg]"
eta_hpt1*(h_2 - h_3s) = h_2 - h_3         "HP turbine 1 efficiency [-]"
P_hpt1 = m_2*(h_2 - h_3)                  "HP turbine 1 power [W]"
s_4 = ENTROPY(Water, P=p_4, h=h_4)        "HP turbine 2 inlet entropy [J/kg-K]"
h_5s = ENTHALPY(Water, P=p_5, s=s_4)      "HP turbine 2 isentropic exhaust [J/kg]"
eta_hpt2*(h_4 - h_5s) = h_4 - h_5         "HP turbine 2 efficiency [-]"
P_hpt2 = m_4*(h_4 - h_5)                  "HP turbine 2 power [W]"
s_7 = ENTROPY(Water, P=p_7, h=h_7)        "LP turbine 1 inlet entropy [J/kg-K]"
h_8s = ENTHALPY(Water, P=p_8, s=s_7)      "LP turbine 1 isentropic exhaust [J/kg]"
eta_lpt1*(h_7 - h_8s) = h_7 - h_8         "LP turbine 1 efficiency [-]"
P_lpt1 = m_7*(h_7 - h_8)                  "LP turbine 1 power [W]"
s_9 = ENTROPY(Water, P=p_9, h=h_9)        "LP turbine 2 inlet entropy [J/kg-K]"
h_10s = ENTHALPY(Water, P=p_10, s=s_9)    "LP turbine 2 isentropic exhaust [J/kg]"
eta_lpt2*(h_9 - h_10s) = h_9 - h_10       "LP turbine 2 efficiency [-]"
P_lpt2 = m_9*(h_9 - h_10)                 "LP turbine 2 power [W]"
s_11 = ENTROPY(Water, P=p_11, h=h_11)     "LP turbine 3 inlet entropy [J/kg-K]"
h_12s = ENTHALPY(Water, P=p_12, s=s_11)   "LP turbine 3 isentropic exhaust [J/kg]"
eta_lpt3*(h_11 - h_12s) = h_11 - h_12     "LP turbine 3 efficiency [-]"
P_lpt3 = m_11*(h_11 - h_12)               "LP turbine 3 power [W]"
s_13 = ENTROPY(Water, P=p_13, h=h_13)     "LP turbine 4 inlet entropy [J/kg-K]"
h_14s = ENTHALPY(Water, P=p_14, s=s_13)   "LP turbine 4 isentropic exhaust [J/kg]"
eta_lpt4*(h_13 - h_14s) = h_13 - h_14     "LP turbine 4 efficiency [-]"
P_lpt4 = m_13*(h_13 - h_14)               "LP turbine 4 power [W]"
s_15 = ENTROPY(Water, P=p_15, h=h_15)     "LP turbine 5 inlet entropy [J/kg-K]"
h_16s = ENTHALPY(Water, P=p_16, s=s_15)   "LP turbine 5 isentropic exhaust [J/kg]"
eta_lpt5*(h_15 - h_16s) = h_15 - h_16     "LP turbine 5 efficiency [-]"
P_lpt5 = m_15*(h_15 - h_16)               "LP turbine 5 power [W]"

"!Feedwater tank (deaerator, 3-inlet merge) and feedwater pump"
m_25 + m_44 + m_45 = m_26                 "feedwater tank mass balance [kg/s]"
m_25*h_25 + m_44*h_44 + m_45*h_45 = m_26*h_26 "feedwater tank energy balance [W]"
p_25 = p_26                               "feedwater tank pressure equality [Pa]"
p_44 = p_26                               "feedwater tank pressure equality [Pa]"
p_45 = p_26                               "feedwater tank pressure equality [Pa]"
h_26 = ENTHALPY(Water, P=p_26, x=0)       "feedwater tank outlet: saturated liquid [J/kg]"
s_26 = ENTROPY(Water, P=p_26, h=h_26)     "feedwater pump inlet entropy [J/kg-K]"
h_27s = ENTHALPY(Water, P=p_27, s=s_26)   "feedwater pump isentropic outlet [J/kg]"
h_27s - h_26 = eta_fwp*(h_27 - h_26)      "feedwater pump efficiency [-]"
P_fwp = m_26*(h_27 - h_26)                "feedwater pump power [W]"
m_27 = m_26                               "feedwater pump mass balance [kg/s]"
T_27 = TEMPERATURE(Water, P=p_27, h=h_27) "feedwater pump outlet temperature [degC]"

"!High pressure preheaters 1 and 2 with subcoolers (water flows 27 to 31)"
m_28 = m_27                               "subcooler 1 cold side mass balance [kg/s]"
p_28 = p_27                               "subcooler 1 cold side pressure (pr2 = 1) [Pa]"
m_29 = m_28                               "HP preheater 1 cold side mass balance [kg/s]"
m_42 = m_41                               "HP preheater 1 hot side mass balance [kg/s]"
m_43 = m_42                               "subcooler 1 hot side mass balance [kg/s]"
p_42 = p_41                               "HP preheater 1 hot side pressure (pr1 = 1) [Pa]"
p_43 = p_42                               "subcooler 1 hot side pressure (pr1 = 1) [Pa]"
T_29 = T_sat_p41 - ttd_fwh                "HP preheater 1 terminal temperature difference [K]"
h_29 = ENTHALPY(Water, P=p_29, T=T_29)    "HP preheater 1 cold outlet [J/kg]"
m_41*(h_41 - h_42) = m_28*(h_29 - h_28)   "HP preheater 1 energy balance [W]"
T_43 = T_27 + ttd_sub                     "subcooler 1 terminal temperature difference [K]"
h_43 = ENTHALPY(Water, P=p_43, T=T_43)    "subcooler 1 hot outlet [J/kg]"
m_42*(h_42 - h_43) = m_27*(h_28 - h_27)   "subcooler 1 energy balance [W]"
h_37 = ENTHALPY(Water, P=p_37, x=0)       "HP preheater 2 drain: saturated liquid (TESPy subcooling = False) [J/kg]"
h_42 = ENTHALPY(Water, P=p_42, x=0)       "HP preheater 1 drain: saturated liquid (TESPy subcooling = False) [J/kg]"
h_44 = h_43                               "drain valve 2 isenthalpic [J/kg]"
m_44 = m_43                               "drain valve 2 mass balance [kg/s]"
m_30 = m_29                               "subcooler 2 cold side mass balance [kg/s]"
p_30 = p_29                               "subcooler 2 cold side pressure (pr2 = 1) [Pa]"
m_31 = m_30                               "HP preheater 2 cold side mass balance [kg/s]"
m_37 = m_36                               "HP preheater 2 hot side mass balance [kg/s]"
m_38 = m_37                               "subcooler 2 hot side mass balance [kg/s]"
p_37 = p_36                               "HP preheater 2 hot side pressure (pr1 = 1) [Pa]"
p_38 = p_37                               "subcooler 2 hot side pressure (pr1 = 1) [Pa]"
T_31 = T_sat_p36 - ttd_fwh                "HP preheater 2 terminal temperature difference [K]"
h_31 = ENTHALPY(Water, P=p_31, T=T_31)    "HP preheater 2 cold outlet [J/kg]"
m_36*(h_36 - h_37) = m_30*(h_31 - h_30)   "HP preheater 2 energy balance [W]"
T_38 = T_29 + ttd_sub                     "subcooler 2 terminal temperature difference [K]"
h_38 = ENTHALPY(Water, P=p_38, T=T_38)    "subcooler 2 hot outlet [J/kg]"
m_37*(h_37 - h_38) = m_29*(h_30 - h_29)   "subcooler 2 energy balance [W]"
h_39 = h_38                               "drain valve 1 isenthalpic [J/kg]"
m_39 = m_38                               "drain valve 1 mass balance [kg/s]"
p_39 = p_40                               "merge 2 pressure equality [Pa]"
p_41 = p_40                               "merge 2 pressure equality [Pa]"
m_39 + m_40 = m_41                        "merge 2 mass balance [kg/s]"
m_39*h_39 + m_40*h_40 = m_41*h_41         "merge 2 energy balance [W]"

"!Merge 1 into the condenser and the condenser (condensate saturated liquid)"
p_59 = p_16                               "merge 1 pressure equality [Pa]"
p_17 = p_16                               "condenser pressure (pr1 = 1) [Pa]"
m_16 + m_59 = m_17                        "merge 1 mass balance [kg/s]"
m_16*h_16 + m_59*h_59 = m_17*h_17         "merge 1 energy balance [W]"
m_18 = m_17                               "condenser hot side mass balance [kg/s]"
p_18 = p_17                               "condenser hot side pressure (pr1 = 1) [Pa]"
h_18 = ENTHALPY(Water, P=p_18, x=0)       "condenser outlet: saturated liquid (TESPy subcooling = False) [J/kg]"
m_60 = m_63                               "condenser cold side mass balance [kg/s]"
p_60 = 0.9*p_63                           "condenser cold side pressure (pr2 = 0.9) [Pa]"
T_60 = T_sat_p17 - ttd_cond               "condenser terminal temperature difference [K]"
h_60 = ENTHALPY(Water, P=p_60, T=T_60)    "cooling water at the condenser outlet [J/kg]"
m_17*(h_17 - h_18) = m_63*(h_60 - h_63)   "condenser energy balance [W]"

"!Low pressure preheaters 3, 2 and 1 with subcoolers (water flows 19 to 25)"
s_18 = ENTROPY(Water, P=p_18, h=h_18)     "condensate pump inlet entropy [J/kg-K]"
h_19s = ENTHALPY(Water, P=p_19, s=s_18)   "condensate pump isentropic outlet [J/kg]"
h_19s - h_18 = eta_condpump*(h_19 - h_18) "condensate pump efficiency [-]"
P_condpump = m_19*(h_19 - h_18)           "condensate pump power [W]"
m_19 = m_18                               "condensate pump mass balance [kg/s]"
T_19 = TEMPERATURE(Water, P=p_19, h=h_19) "condensate pump outlet temperature [degC]"
m_20 = m_19                               "subcooler 3 cold side mass balance [kg/s]"
p_20 = p_19                               "subcooler 3 cold side pressure (pr2 = 1) [Pa]"
m_21 = m_20                               "LP preheater 1 cold side mass balance [kg/s]"
m_57 = m_56                               "LP preheater 1 hot side mass balance [kg/s]"
m_58 = m_57                               "subcooler 3 hot side mass balance [kg/s]"
p_57 = p_56                               "LP preheater 1 hot side pressure (pr1 = 1) [Pa]"
p_58 = p_57                               "subcooler 3 hot side pressure (pr1 = 1) [Pa]"
T_21 = T_sat_p56 - ttd_fwh                "LP preheater 1 terminal temperature difference [K]"
h_21 = ENTHALPY(Water, P=p_21, T=T_21)    "LP preheater 1 cold outlet [J/kg]"
m_56*(h_56 - h_57) = m_20*(h_21 - h_20)   "LP preheater 1 energy balance [W]"
T_58 = T_19 + ttd_sub                     "subcooler 3 terminal temperature difference [K]"
h_58 = ENTHALPY(Water, P=p_58, T=T_58)    "subcooler 3 hot outlet [J/kg]"
m_57*(h_57 - h_58) = m_19*(h_20 - h_19)   "subcooler 3 energy balance [W]"
h_47 = ENTHALPY(Water, P=p_47, x=0)       "LP preheater 3 drain: saturated liquid (TESPy subcooling = False) [J/kg]"
h_52 = ENTHALPY(Water, P=p_52, x=0)       "LP preheater 2 drain: saturated liquid (TESPy subcooling = False) [J/kg]"
h_57 = ENTHALPY(Water, P=p_57, x=0)       "LP preheater 1 drain: saturated liquid (TESPy subcooling = False) [J/kg]"
h_59 = h_58                               "drain valve 5 isenthalpic [J/kg]"
m_59 = m_58                               "drain valve 5 mass balance [kg/s]"
m_22 = m_21                               "subcooler 4 cold side mass balance [kg/s]"
p_22 = p_21                               "subcooler 4 cold side pressure (pr2 = 1) [Pa]"
m_23 = m_22                               "LP preheater 2 cold side mass balance [kg/s]"
m_52 = m_51                               "LP preheater 2 hot side mass balance [kg/s]"
m_53 = m_52                               "subcooler 4 hot side mass balance [kg/s]"
p_52 = p_51                               "LP preheater 2 hot side pressure (pr1 = 1) [Pa]"
p_53 = p_52                               "subcooler 4 hot side pressure (pr1 = 1) [Pa]"
T_23 = T_sat_p51 - ttd_fwh                "LP preheater 2 terminal temperature difference [K]"
h_23 = ENTHALPY(Water, P=p_23, T=T_23)    "LP preheater 2 cold outlet [J/kg]"
m_51*(h_51 - h_52) = m_21*(h_23 - h_22)   "LP preheater 2 energy balance [W]"
T_53 = T_21 + ttd_sub                     "subcooler 4 terminal temperature difference [K]"
h_53 = ENTHALPY(Water, P=p_53, T=T_53)    "subcooler 4 hot outlet [J/kg]"
m_52*(h_52 - h_53) = m_20*(h_22 - h_21)   "subcooler 4 energy balance [W]"
h_54 = h_53                               "drain valve 4 isenthalpic [J/kg]"
m_54 = m_53                               "drain valve 4 mass balance [kg/s]"
m_24 = m_23                               "subcooler 5 cold side mass balance [kg/s]"
p_24 = p_23                               "subcooler 5 cold side pressure (pr2 = 1) [Pa]"
m_25 = m_24                               "LP preheater 3 cold side mass balance [kg/s]"
m_47 = m_46                               "LP preheater 3 hot side mass balance [kg/s]"
m_48 = m_47                               "subcooler 5 hot side mass balance [kg/s]"
p_47 = p_46                               "LP preheater 3 hot side pressure (pr1 = 1) [Pa]"
p_48 = p_47                               "subcooler 5 hot side pressure (pr1 = 1) [Pa]"
T_25 = T_sat_p46 - ttd_fwh                "LP preheater 3 terminal temperature difference [K]"
h_25 = ENTHALPY(Water, P=p_25, T=T_25)    "LP preheater 3 cold outlet [J/kg]"
m_46*(h_46 - h_47) = m_24*(h_25 - h_24)   "LP preheater 3 energy balance [W]"
T_48 = T_23 + ttd_sub                     "subcooler 5 terminal temperature difference [K]"
h_48 = ENTHALPY(Water, P=p_48, T=T_48)    "subcooler 5 hot outlet [J/kg]"
m_47*(h_47 - h_48) = m_23*(h_24 - h_23)   "subcooler 5 energy balance [W]"
h_49 = h_48                               "drain valve 3 isenthalpic [J/kg]"
m_49 = m_48                               "drain valve 3 mass balance [kg/s]"
p_49 = p_50                               "merge 3 pressure equality [Pa]"
p_51 = p_50                               "merge 3 pressure equality [Pa]"
m_49 + m_50 = m_51                        "merge 3 mass balance [kg/s]"
m_49*h_49 + m_50*h_50 = m_51*h_51         "merge 3 energy balance [W]"
p_54 = p_55                               "merge 4 pressure equality [Pa]"
p_56 = p_55                               "merge 4 pressure equality [Pa]"
m_54 + m_55 = m_56                        "merge 4 mass balance [kg/s]"
m_54*h_54 + m_55*h_55 = m_56*h_56         "merge 4 energy balance [W]"

"!Cooling water loop, cooling tower and fan"
h_61 = h_60                               "cycle closer of the cooling water loop [J/kg]"
p_61 = p_60                               "cycle closer of the cooling water loop [Pa]"
m_62 = m_61                               "cooling tower hot side mass balance [kg/s]"
p_62 = 0.95*p_61                          "cooling tower hot side pressure (pr1 = 0.95) [Pa]"
h_62 = ENTHALPY(Water, P=p_62, T=T_62)    "cooling water at the cooling tower outlet [J/kg]"
m_65 = m_66                               "cooling tower cold side mass balance [kg/s]"
m_61*(h_61 - h_62) = m_66*(h_66 - h_65)   "cooling tower energy balance [W]"
s_62 = ENTROPY(Water, P=p_62, h=h_62)     "cooling water pump inlet entropy [J/kg-K]"
h_63s = ENTHALPY(Water, P=p_63, s=s_62)   "cooling water pump isentropic outlet [J/kg]"
h_63s - h_62 = eta_cwp*(h_63 - h_62)      "cooling water pump efficiency [-]"
m_63 = m_62                               "cooling water pump mass balance [kg/s]"
P_cwp = m_63*(h_63 - h_62)                "cooling water pump power [W]"
h_64 = ENTHALPY(Air, T=T_64)              "ambient air at the fan inlet [J/kg]"
h_66 = ENTHALPY(Air, T=T_66)              "air at the cooling tower outlet [J/kg]"
s_64 = ENTROPY(Air, T=T_64, P=p_64)       "fan inlet entropy [J/kg-K]"
h_65s = ENTHALPY(Air, P=p_65, s=s_64)     "fan isentropic outlet [J/kg]"
h_65s - h_64 = eta_fan*(h_65 - h_64)      "fan efficiency [-]"
P_fan = m_64*(h_65 - h_64)                "fan power [W]"
m_65 = m_64                               "fan mass balance [kg/s]"

"!Power chain: generators, motors, distribution bus, grid"
e_1 = P_hpt1                              "generator 1 input [W]"
e_2 = eta_gen*e_1                         "generator 1 output [W]"
e_3 = P_hpt2                              "generator 2 input [W]"
e_4 = eta_gen*e_3                         "generator 2 output [W]"
e_5 = P_lpt1                              "generator 3 input [W]"
e_6 = eta_gen*e_5                         "generator 3 output [W]"
e_7 = P_lpt2                              "generator 4 input [W]"
e_8 = eta_gen*e_7                         "generator 4 output [W]"
e_9 = P_lpt3                              "generator 5 input [W]"
e_10 = eta_gen*e_9                        "generator 5 output [W]"
e_11 = P_lpt4                             "generator 6 input [W]"
e_12 = eta_gen*e_11                       "generator 6 output [W]"
e_13 = P_lpt5                             "generator 7 input [W]"
e_14 = eta_gen*e_13                       "generator 7 output [W]"
e_2 + e_4 + e_6 + e_8 + e_10 + e_12 + e_14 = e_15 + e_17 + e_19 + e_21 + e_23 + e_25 "distribution bus [W]"
e_16 = eta_mot*e_15                       "motor feedwater pump [W]"
e_16 = P_fwp                              "feedwater pump power [W]"
e_18 = eta_mot*e_17                       "motor condensate pump [W]"
e_18 = P_condpump                         "condensate pump power [W]"
e_20 = eta_mot*e_19                       "motor HTF pump [W]"
e_20 = P_ptpump                           "HTF pump power [W]"
e_22 = eta_mot*e_21                       "motor cooling water pump [W]"
e_22 = P_cwp                              "cooling water pump power [W]"
e_24 = eta_mot*e_23                       "motor cooling tower fan [W]"
e_24 = P_fan                              "fan power [W]"
P_net = e_25                              "net power to the grid [W]"

"!Saturation temperatures used by the terminal temperature differences"
T_sat_p17 = TEMPERATURE(Water, P=p_17, x=0) "saturation temperature at the condenser pressure [degC]"
T_sat_p36 = TEMPERATURE(Water, P=p_36, x=0) "saturation temperature at the HP preheater 2 pressure [degC]"
T_sat_p41 = TEMPERATURE(Water, P=p_41, x=0) "saturation temperature at the HP preheater 1 pressure [degC]"
T_sat_p46 = TEMPERATURE(Water, P=p_46, x=0) "saturation temperature at the LP preheater 3 pressure [degC]"
T_sat_p51 = TEMPERATURE(Water, P=p_51, x=0) "saturation temperature at the LP preheater 2 pressure [degC]"
T_sat_p56 = TEMPERATURE(Water, P=p_56, x=0) "saturation temperature at the LP preheater 1 pressure [degC]"

"!State points of the steam cycle for the thermodynamic diagrams (post-processing,
 no effect on the results; i = connection label of the main steam path)"
P[1] = p_1
h[1] = h_1
T[1] = T_1
s[1] = s_2
P[2] = p_3
h[2] = h_3
T[2] = TEMPERATURE(Water, P=p_3, h=h_3)
s[2] = ENTROPY(Water, P=p_3, h=h_3)
P[3] = p_5
h[3] = h_5
T[3] = TEMPERATURE(Water, P=p_5, h=h_5)
s[3] = s_4
P[4] = p_7
h[4] = h_7
T[4] = T_7
s[4] = s_7
P[5] = p_8
h[5] = h_8
T[5] = TEMPERATURE(Water, P=p_8, h=h_8)
s[5] = ENTROPY(Water, P=p_8, h=h_8)
P[6] = p_10
h[6] = h_10
T[6] = TEMPERATURE(Water, P=p_10, h=h_10)
s[6] = ENTROPY(Water, P=p_10, h=h_10)
P[7] = p_12
h[7] = h_12
T[7] = TEMPERATURE(Water, P=p_12, h=h_12)
s[7] = ENTROPY(Water, P=p_12, h=h_12)
P[8] = p_14
h[8] = h_14
T[8] = TEMPERATURE(Water, P=p_14, h=h_14)
s[8] = ENTROPY(Water, P=p_14, h=h_14)
P[9] = p_16
h[9] = h_16
T[9] = TEMPERATURE(Water, P=p_16, h=h_16)
s[9] = ENTROPY(Water, P=p_16, h=h_16)
P[10] = p_17
h[10] = h_17
T[10] = TEMPERATURE(Water, P=p_17, h=h_17)
s[10] = ENTROPY(Water, P=p_17, h=h_17)
P[11] = p_18
h[11] = h_18
T[11] = TEMPERATURE(Water, P=p_18, x=0)
s[11] = ENTROPY(Water, P=p_18, x=0)
P[12] = p_26
h[12] = h_26
T[12] = TEMPERATURE(Water, P=p_26, x=0)
s[12] = ENTROPY(Water, P=p_26, x=0)
P[13] = p_31
h[13] = h_31
T[13] = T_31
s[13] = ENTROPY(Water, P=p_31, h=h_31)
