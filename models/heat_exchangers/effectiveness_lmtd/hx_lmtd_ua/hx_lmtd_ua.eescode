{=============================================================================
  Counterflow heat exchanger rated by UA and a smoothed LMTD (TESPy)
  CoolSolve Library model CSL-0137
 -----------------------------------------------------------------------------
  Translation of the TESPy component class HeatExchanger (TSP-008) into
  EES-language equations, with the condensing variant Condenser (TSP-009) as
  hx_lmtd_ua_condenser.eescode. A counterflow exchanger transfers the duty
  Q = m_h*(h_h,ex - h_h,su) between two streams; the duty is closed either by
  the heat transfer coefficient UA through the smoothed LMTD (Quoilin 2011),
  by a terminal temperature difference (ttd_u, ttd_l, pinch) or by Q itself.
  Case 1 is the design case of the TESPy doctest (air/water, ttd_u = 5 K),
  case 2 its off-design run (UA = UA_design*f_UA from the characteristic lines).

  Source: TESPy, Witte & Tuschy (MIT, commit 19425523),
          src/tespy/components/heat_exchangers/base.py, src/tespy/data/char_lines.json
  Authors: Francesco Witte, Malte Fritz and the TESPy contributors; LMTD smoothing: Sylvain Quoilin
  License: MIT
  Status: verified against the TESPy HeatExchanger class doctest (README.md)
=============================================================================}

FUNCTION LMTD_smoothed(td_a, td_b)
{----------------------------------------------------------------------------
  Smoothed logarithmic mean temperature difference of a counterflow exchanger,
  as in tespy.components.heat_exchangers.base.smoothed_lmtd (commit 19425523),
  itself from S. Quoilin, "Study of cooling and heat pump systems", PhD thesis,
  University of Liege, 2011 (threshold 1 K and slope 1e4 there; TESPy lowers
  both for lower pinches and lower stiffness).
    dT_a, dT_b > eps : dT_log = (td_a - td_b)/LN(td_a/td_b), and (td_a+td_b)/2
                       when the two differences are equal to round-off
    td_a > eps      : linear extrapolation with the slope xi around eps
    otherwise       : the two-sided limit eps/((1-xi*(td_a-eps))*(1-xi*(td_b-eps)))
  Arguments td_a, td_b: terminal temperature differences [K]
  Returns          : smoothed logarithmic mean temperature difference [K]
----------------------------------------------------------------------------}
  eps = 0.001        "threshold of the smoothing [K] (_LMTD_SMOOTHING_EPS)"
  xi = 5             "slope of the extrapolation [1/K] (_LMTD_SMOOTHING_XI)"
  IF (td_a > eps AND td_b > eps) THEN
    IF (ABS(td_a - td_b) <= 1E-6) THEN
      LMTD_smoothed = (td_a + td_b)/2
    ELSE
      LMTD_smoothed = (td_a - td_b)/LN(td_a/td_b)
    ENDIF
  ELSE
    IF (td_a > eps) THEN
      LMTD_smoothed = (td_a - eps)/(LN(td_a/eps)*(1 - xi*(td_b - eps)))
    ELSE
      IF (td_b > eps) THEN
        LMTD_smoothed = (td_b - eps)/(LN(td_b/eps)*(1 - xi*(td_a - eps)))
      ELSE
        LMTD_smoothed = eps/((1 - xi*(td_a - eps))*(1 - xi*(td_b - eps)))
      ENDIF
    ENDIF
  ENDIF
END

"!Case 1 - design run of the TESPy HeatExchanger doctest (air on the hot side, water on the cold side)"
V_dot_h_1 = 0.1          "hot-side volumetric flow at the inlet [m3/s] (doctest v = 0.1)"
T_h_su_1 = 35            "hot supply temperature [C]"
P_h_ex_1 = 1E5           "hot outlet pressure [Pa] (doctest p = 1 bar)"
dp_1_1 = 2040.816        "hot-side pressure drop over the exchanger [Pa] (TESPy dp1 of the run)"
P_c_su_1 = 3E5           "cold supply pressure [Pa] (doctest p = 3 bar)"
T_c_su_1 = 10            "cold supply temperature [C]"
dp_2_1 = 6000            "cold-side pressure drop over the exchanger [Pa] (TESPy dp2 of the run)"
ttd_u_1 = 5              "upper terminal temperature difference, design specification [K]"

"!Case 2 - off-design run of the same doctest (air volumetric flow reduced to 0.075 m3/s)"
V_dot_h_2 = 0.075        "hot-side volumetric flow at the inlet [m3/s] (doctest v = 0.075)"
T_h_su_2 = 35            "hot supply temperature [C]"
P_h_ex_2 = 1E5           "hot outlet pressure [Pa]"
dp_1_2 = 1126.752        "hot-side pressure drop over the exchanger [Pa] (TESPy dp1 of the run)"
P_c_su_2 = 3E5           "cold supply pressure [Pa]"
T_c_su_2 = 10            "cold supply temperature [C]"
dp_2_2 = 5997.805        "cold-side pressure drop over the exchanger [Pa] (TESPy dp2 of the run)"
M_dot_c_2 = 0.024276570  "cold mass flow rate, held at its design value [kg/s] (TESPy offdesign ['m'])"
UA_design = 329.4968929  "design heat transfer coefficient of case 1 [W/K]"
M_dot_h_design = 0.11538841  "hot design mass flow rate of case 1 [kg/s] (value of the design run, as TESPy design_path)"
M_dot_c_design = 0.024276570 "cold design mass flow rate of case 1 [kg/s] (value of the design run, as TESPy design_path)"

"!Hot side of case 1: air, the supply pressure follows from the specified outlet pressure and dp1"
P_h_su_1 = P_h_ex_1 + dp_1_1                                  "hot supply pressure [Pa]"
h_h_su_1 = ENTHALPY(Air, T=T_h_su_1, P=P_h_su_1)              "hot supply enthalpy [J/kg]"
M_dot_h_1 = V_dot_h_1/VOLUME(Air, T=T_h_su_1, P=P_h_su_1)     "hot mass flow rate [kg/s]"
M_dot_h_1*(h_h_ex_1 - h_h_su_1) = Q_dot_1                     "heat transfer from the hot side [W]"
T_h_ex_1 = TEMPERATURE(Air, H=h_h_ex_1, P=P_h_ex_1)           "hot outlet temperature [C]"

"!Cold side of case 1: water; the outlet temperature closes the ttd_u specification"
T_c_ex_1 = T_h_su_1 - ttd_u_1                                 "cold outlet temperature [C]"
h_c_ex_1 = ENTHALPY(Water, T=T_c_ex_1, P=P_c_ex_1)            "cold outlet enthalpy [J/kg]"
P_c_ex_1 = P_c_su_1 - dp_2_1                                  "cold outlet pressure [Pa]"
h_c_su_1 = ENTHALPY(Water, T=T_c_su_1, P=P_c_su_1)            "cold supply enthalpy [J/kg]"
M_dot_c_1*(h_c_ex_1 - h_c_su_1) = -Q_dot_1                    "energy balance of the cold side [W]"

"!Rating of case 1: the design UA follows from the duty and the LMTD (TESPy UA_func: Q + UA*lmtd = 0)"
ttd_l_1 = T_h_ex_1 - T_c_su_1                                 "lower terminal temperature difference [K]"
lmtd_1 = LMTD_smoothed(ttd_u_1, ttd_l_1)                      "effective logarithmic mean temperature difference [K]"
UA_1 = -Q_dot_1/lmtd_1                                        "heat transfer coefficient considering the ttd's [W/K]"
ttd_min_1 = MIN(ttd_u_1, ttd_l_1)                             "minimum terminal temperature difference (pinch) [K]"
eff_hot_1 = (h_h_ex_1 - h_h_su_1)/(ENTHALPY(Air, T=T_c_su_1, P=P_h_ex_1) - h_h_su_1)  "hot-side effectiveness [-]"
eff_cold_1 = (h_c_ex_1 - h_c_su_1)/(ENTHALPY(Water, T=T_h_su_1, P=P_c_ex_1) - h_c_su_1) "cold-side effectiveness [-]"
eff_max_1 = MAX(eff_hot_1, eff_cold_1)                         "maximum effectiveness [-]"

"!Hot and cold side of case 2 (off design, air and water)"
P_h_su_2 = P_h_ex_2 + dp_1_2                                  "hot supply pressure [Pa]"
h_h_su_2 = ENTHALPY(Air, T=T_h_su_2, P=P_h_su_2)              "hot supply enthalpy [J/kg]"
M_dot_h_2 = V_dot_h_2/VOLUME(Air, T=T_h_su_2, P=P_h_su_2)     "hot mass flow rate [kg/s]"
M_dot_h_2*(h_h_ex_2 - h_h_su_2) = Q_dot_2                     "heat transfer from the hot side [W]"
T_h_ex_2 = TEMPERATURE(Air, H=h_h_ex_2, P=P_h_ex_2)           "hot outlet temperature [C]"
P_c_ex_2 = P_c_su_2 - dp_2_2                                  "cold outlet pressure [Pa]"
h_c_su_2 = ENTHALPY(Water, T=T_c_su_2, P=P_c_su_2)            "cold supply enthalpy [J/kg]"
h_c_ex_2 = h_c_su_2 - Q_dot_2/M_dot_c_2                       "cold outlet enthalpy [J/kg]"
T_c_ex_2 = TEMPERATURE(Water, H=h_c_ex_2, P=P_c_ex_2)         "cold outlet temperature [C]"

"!Off-design rating of case 2: UA = UA_design*f_UA, f_UA = 2/(1/f_1 + 1/f_2) (TESPy UA_char_func)"
m_ratio_h = M_dot_h_2/M_dot_h_design                            "hot-side mass flow ratio to the design value [-]"
m_ratio_c = M_dot_c_2/M_dot_c_design                            "cold-side mass flow ratio to the design value [-]"
f_1 = INTERPOLATE('uachar', 'm_hot_design', 'f_hot', m_ratio_h)  "hot-side UA factor [-]"
f_2 = INTERPOLATE('uachar', 'm_cold_design', 'f_cold', m_ratio_c) "cold-side UA factor [-]"
f_UA_2 = 2/(1/f_1 + 1/f_2)                                    "combined UA factor [-]"
UA_2 = UA_design*f_UA_2                                       "heat transfer coefficient off design [W/K]"
ttd_u_2 = T_h_su_2 - T_c_ex_2                                 "upper terminal temperature difference [K]"
ttd_l_2 = T_h_ex_2 - T_c_su_2                                 "lower terminal temperature difference [K]"
lmtd_2 = LMTD_smoothed(ttd_u_2, ttd_l_2)                      "effective logarithmic mean temperature difference [K]"
-Q_dot_2 - UA_2*lmtd_2 = 0                                     "heat transfer closed by the UA equation, Q + UA*lmtd = 0 [W]"
ttd_min_2 = MIN(ttd_u_2, ttd_l_2)                             "minimum terminal temperature difference (pinch) [K]"

"!Cold stream (water) of both cases, for the thermodynamic diagrams (no effect on the results)"
{1: cold inlet of case 1, 2: cold outlet of case 1, 3: cold inlet of case 2,
 4: cold outlet of case 2. Overlay the h/P or h/s arrays in the Diagram tab.}
P[1] = P_c_su_1
h[1] = h_c_su_1
T[1] = T_c_su_1
P[2] = P_c_ex_1
h[2] = h_c_ex_1
T[2] = T_c_ex_1
P[3] = P_c_su_2
h[3] = h_c_su_2
T[3] = T_c_su_2
P[4] = P_c_ex_2
h[4] = h_c_ex_2
T[4] = T_c_ex_2
s[4] = ENTROPY(Water, H=h_c_ex_2, P=P_c_ex_2)
s[4] = ENTROPY(Water, H=h_c_ex_2, P=P_c_ex_2)
