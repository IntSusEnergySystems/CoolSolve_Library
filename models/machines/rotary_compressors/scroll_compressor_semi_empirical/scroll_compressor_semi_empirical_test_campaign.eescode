{=============================================================================
  Semi-empirical scroll compressor - model vs. test campaign (R22, 28 points)
  Variant of CoolSolve Library model CSL-0007
  -----------------------------------------------------------------------------
  Identification file of the Winandy, Saavedra & Lebrun (2002) reference model
  (machine of 174 cm3, internal volume ratio 2.775; no leakage, no pressure
  drops). The compressor alone is driven by the measured supply state and
  discharge pressure of test point i of the companion table
  ..._test_campaign-lookup_1.csv (bar, degC, rpm, kg/s, W); the measured flow
  rate, power and discharge temperature are compared with the model (ERRm,
  ERRw, ERRtex_cp). Default i = 28 = last run stored in the EES file.
  Hand-converted from bar/kJ to Pa/J (see README.md).
  Authors : J. Lebrun (file JL080205); model of Winandy, Saavedra & Lebrun
  Source  : ~/Nextcloud/thermo_models/modeles/JL/new/scroll JL080205/
            3_3_1_Identification.EES (TM-0278)
  Licence : MIT
  Status  : runs; i = 28 verified against the EES stored solution
 =============================================================================}

{Reference:
 Winandy E., Saavedra C., Lebrun J., Experimental analysis and simplified
 modelling of a hermetic scroll refrigeration compressor, Applied Thermal
 Engineering, 2002.
 Winandy E., Contribution to reciprocating and scroll refrigeration
 compressors performance analysis, PhD Thesis, University of Concepcion,
 Chile, 1999.}

"!Test point"
i = 28                                       "row of the test table (1..28); 28 = last run stored in the EES file"

"!Compressor reference model (simplified: no leakage, no pressure drops)"
{Evolution of the refrigerant in six steps, as in the original: (i) no pressure
 drop (su = su1); (ii) heating-up (su1 - su2); (iii) isentropic compression
 (su2 - ad); (iv) compression at fixed volume (ad - ex2); (v) cooling-down
 (ex2 - ex1); (vi) no pressure drop (ex1 - ex).}

"1. First step: pressure drop from su to su1"
{Fixed-area obstacle (isentropic nozzle + isobaric diffusion); negligible for this
 hermetic scroll compressor: same equation with d_su = 1 m (very large).}
t_su1_cp = temperature( fluid$,h=h_su1_cp, p = p_su1_cp)
v_su1_cp = volume(fluid$,t=t_su1_cp,p=p_su1_cp)
h_su1_cp = h_su_cp                          "no pressure drop: su = su1"
p_su1_cp = p_su_cp - C_su_cp^2 / (2*v_su_cp)  "nozzle dynamic pressure drop [Pa] (/2000 = kPa-units leftover in the original)"
C_su_cp = V_dot_su_cp / A_su_cp             "supply velocity [m/s]"
A_su_cp = pi * d_su_cp^2 / 4                "supply nozzle area [m2]"
DELTAp_su1_cp = p_su_cp-p_su1_cp            "supply pressure drop [Pa]"

"Fluid definition"
v_su_cp = volume( fluid$, t = t_su_cp , p = p_su_cp )
h_su_cp = enthalpy( fluid$ , t = t_su_cp , p = p_su_cp )
s_su_cp = entropy( fluid$, t = t_su_cp , p = p_su_cp )
h_exs_cp = enthalpy( fluid$ , p = p_ex_cp , s = s_su_cp )   "isentropic exhaust state"

"2. Second step: heating-up from su1 to su2 (fictitious exchanger of wall temperature t_w)"
h_su2_cp - h_su1_cp = Q_dot_su1_cp / M_dot
Q_dot_su1_cp = epsilon_su1_cp*C_dot_su1_cp*( t_w_cp - t_su1_cp )
epsilon_su1_cp = 1 - exp(-NTU_su1_cp)
NTU_su1_cp = AU_su1_cp / C_dot_su1_cp
C_dot_su1_cp = M_dot * c_p_su1_cp            "capacity flow rate [W/K]"
c_p_su1_cp = specheat(fluid$,T=t_su1_cp,P=p_su1_cp)  "[J/kg-K]"
t_su2_cp = t_su1_cp+DELTAt_su12_cp           "supply heating-up [K]"
p_su2_cp = p_su1_cp

t_su2_cp = temperature( fluid$, h=h_su2_cp, p=p_su2_cp )
v_su2_cp = volume( fluid$, t = t_su2_cp , p = p_su2_cp )
s_su2_cp = entropy( fluid$, t = t_su2_cp , p = p_su2_cp )

"Wall balance"
W_dot - W_dot_in - Q_dot_su1_cp - Q_dot_ex2_cp + Q_dot_amb_cp = 0   "fictitious wall heat balance [W]"
Q_dot_amb_cp = AU_amb_cp * ( t_amb_cp - t_w_cp )   "ambient heat exchange [W]"

"3. Third step: suction"
M_dot = V_s_cp*N_cp/volume(fluid$,t=t_su2_cp,p=p_su2_cp)   "flow rate from the swept volume [kg/s]"
N_cp = N_nom_cp*(1-C_sd_cp*W_dot)            "rotational speed with motor sliding [rev/s]"

"The global volumetric effectiveness"
V_dot_su_cp = M_dot * v_su_cp
V_dot_su_cp = epsilon_v_cp * V_dot_s_cp
V_dot_s_cp = V_s_cp * N_cp                   "displaced volume flow rate [m3/s]"

"4. Fourth step: isentropic compression with a fixed internal volume ratio"
t_ex2_cp = temperature(fluid$,h=h_ex2_cp,p=p_ex2_cp)
h_ex2_cp = h_su2_cp+w_in                     "adiabatic compression from su2 to ex2"

{Adiabatic-reversible (isentropic) compression up to the adapted pressure, then
 adiabatic non-reversible compression at constant volume until the exhaust pressure.}
w_ad = ( enthalpy(fluid$,s=s_su2_cp,p=p_ad_cp) - enthalpy(fluid$,t=t_su2_cp,p=p_su2_cp) )   "isentropic part [J/kg]"
p_ad_cp = pressure(fluid$,s=s_su2_cp,v=v_fi_cp )   "adapted pressure [Pa]"
t_ad_cp = temperature(fluid$,s=s_su2_cp,v=v_fi_cp)
v_fi_cp = v_in_cp/R_v_i_cp                   "specific volume at the end of the isentropic part [m3/kg]"
v_in_cp = volume(fluid$,t=t_su2_cp,p=p_su2_cp)
w_nad = v_fi_cp * (p_ex2_cp-p_ad_cp)         "isochoric part [J/kg] (*1E+5/1E+3 = bar/kJ factor in the original)"
w_in = w_ad+w_nad                            "specific internal work [J/kg]"
W_dot_in = M_dot * w_in                      "internal (gas) power [W]"

"Compressor power split into several terms"
W_dot = W_dot_in+W_dot_loss                  "electrical power [W]"
W_dot_loss = W_dot_loss0+alpha_cp*W_dot_in   "electromechanical losses [W]"
IMEP_cp = W_dot_in/(V_s_cp*N_cp)             "indicated mean effective pressure [Pa]"
FMEP_cp = W_dot_loss/(V_s_cp*N_cp)           "losses mean effective pressure [Pa]"

"Calculation of the (electrical or shaft) power"
W_dot = M_dot * w
w = w_s / epsilon_s_cp
w_s = h_exs_cp-h_su_cp                       "isentropic specific work [J/kg]"

"5. Fifth step: cooling-down from ex2 to ex1"
t_ex1_cp = temperature(fluid$,h=h_ex1_cp,p=p_ex1_cp)
h_ex1_cp - h_ex2_cp = Q_dot_ex2_cp / M_dot
Q_dot_ex2_cp = epsilon_ex2_cp*C_dot_ex2_cp*( t_w_cp - t_ex2_cp )
epsilon_ex2_cp = 1 - exp(-NTU_ex2_cp)
NTU_ex2_cp = AU_ex2_cp / C_dot_ex2_cp
C_dot_ex2_cp = M_dot * c_p_ex2_cp            "capacity flow rate [W/K]"
c_p_ex2_cp = specheat(fluid$,T=t_ex2_cp,p=p_ex2_cp)   "[J/kg-K]"
t_ex2_cp = t_ex1_cp+DELTAt_ex12_cp           "exhaust cooling-down [K]"
p_ex1_cp = p_ex2_cp

"6. Sixth step: throttling from ex1 to ex"
p_ex_cp = p_ex1_cp - DELTAp_ex1_cp
h_ex_cp = h_ex1_cp                           "isenthalpic"
t_ex_cp = temperature( fluid$, h = h_ex_cp , p = p_ex_cp )

R_p_cp = p_ex_cp/p_su_cp                     "pressure ratio [-]"

"!Parameters"
{Parameters identified manually (iteratively) against the test table: first the swept
 volume fixed to its theoretical value, then the AU tuned for the pressure drops /
 heating-up / cooling-down, then the power-loss parameters (constant losses of the
 order of 100 W, alpha of the order of 0.2), finally the full iterative identification.}
V_s_cp = 174e-6                              "swept volume [m3/rev]"
N_nom_cp = 50                                "nominal rotational speed [rev/s]"
C_sd_cp = 4E-6                               "motor sliding [1/W] (0.04/10 = 0.04 per 10 kW in the original)"
d_su_cp = 1                                  "supply nozzle diameter [m] (very large: negligible supply drop)"
DELTAp_ex1_cp = 0                            "exhaust pressure drop [Pa]"
AU_su1_cp = 50*(M_dot/M_dot_ref)^0.8         "supply conductance [W/K] (0.05 kW/K in the original)"
AU_ex2_cp = 50                               "exhaust conductance [W/K] (0.05 kW/K in the original)"
AU_amb_cp = 10                               "ambient-loss conductance [W/K] (0.01 kW/K in the original)"
R_v_i_cp = 2.775                             "internal built-in volume ratio [-]"
W_dot_loss0 = 200                            "constant electromechanical losses [W] (0.2 kW in the original)"
alpha_cp = 0.315                             "loss factor proportional to the internal power [-]"

"General variables used for comparison between compressors"
FMEP_0_cp = W_dot_loss0/(N_0_cp*V_s_cp)      "losses mean effective pressure at nominal speed [Pa]"
AUDsu_cp = AU_su1_cp/(V_s_cp)^(2/3)          "normalized supply conductance [W/K-m2]"
AUDex_cp = AU_ex2_cp/(V_s_cp)^(2/3)          "normalized exhaust conductance [W/K-m2]"
AUDamb_cp = AU_amb_cp/(V_s_cp)^(2/3)         "normalized ambient conductance [W/K-m2]"
Madim = M_dot_mes/M_dot_ref                  "dimensionless measured mass flow rate [-]"
N_0_cp = 2900/60                             "reference speed [rev/s]"
M_dot_ref = 0.25                             "reference mass flow rate [kg/s]"

"!Inputs from the test table (columns: 1 P1 [bar], 2 DP1, 3 T1 [degC], 4 T1', 5 P2 [bar], 6 DP2, 7 T2, 8 T2', 9 Nrpm, 10 Mr [kg/s], 11 Wmot [W])"
fluid$ = 'R22'                               "refrigerant"
p_su_cp = lookup(i,1)*1E+5                   "measured supply pressure [Pa]"
t_su_cp = lookup(i,3)                        "measured supply temperature [degC]"
p_ex_cp = lookup(i,5)*1E+5                   "measured exhaust pressure [Pa]"
t_amb_cp = 30                                "ambient temperature [degC]"

"!Measured outputs"
t_su2_mes_cp = lookup(i,4)                   "measured temperature after heating-up [degC]"
DELTAp_su_mes_cp = lookup(i,2)               "measured supply pressure drop, unit not recovered from the EES file (not used by the model)"
t_ex_mes_cp = lookup(i,7)                    "measured exhaust temperature [degC]"
t_ex2_mes_cp = lookup(i,8)                   "measured temperature at the end of the compression [degC]"
DELTAp_ex_mes_cp = lookup(i,6)               "measured exhaust pressure drop, unit not recovered from the EES file (not used by the model)"
N_mes_cp = lookup(i,9)/60                    "measured rotational speed [rev/s]"
M_dot_mes = lookup(i,10)                     "measured mass flow rate [kg/s]"
W_dot_mes = lookup(i,11)                     "measured electrical power [W]"
"The ambient losses are computed closing the compressor heat balance"
Q_dot_amb_mes_cp = M_dot_mes*(enthalpy(fluid$,T=t_ex_mes_cp,P=p_ex_cp)-enthalpy(fluid$,t=t_su_cp,p=p_su_cp))-W_dot_mes   "[W]"

"!Comparison model - measurements"
ERRm = (M_dot_mes-M_dot)/M_dot_mes*100       "mass flow rate error [%]"
ERRw = (W_dot_mes-W_dot)/W_dot_mes*100       "electrical power error [%]"
ERRtex_cp = (t_ex_mes_cp - t_ex_cp)          "exhaust temperature error [K]"
