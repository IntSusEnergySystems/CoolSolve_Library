{=============================================================================
  Counterflow cooling tower, outlet water temperature
  CoolSolve Library model CSL-0179
 -----------------------------------------------------------------------------
  Teaching exercise: find the water temperature leaving a counterflow cooling
  tower. The tower is rated as a dry counterflow exchanger between the water
  and a fictitious fluid whose temperatures are the wet-bulb temperatures of
  the moist air (course equations, page 95). The outlet air is saturated.
  The dry overall heat-transfer coefficient, the two flow rates and the inlet
  water temperature are given.

  Inputs : AU, M_dot_w, M_dot_a, t_w_su, P, t_a_su, RH_su
  Outputs: t_w_ex, Q_dot, t_wb_su, t_wb_ex
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège MSTh, 2005-10-24, exercise 1 (MSTH051024exercice1.EES);
           file names no author - see README.md
=============================================================================}

"!Problem data (as in the original)"
"Counterflow. Dry overall heat-transfer coefficient 90 kW/K. Water and air"
"flow rates 50 and 60 kg/s. Inlet water 35 °C. Atmosphere 101325 Pa."
"Ambient air 25 °C, 70 % relative humidity. Outlet air taken as saturated."
AU = 90E3           "dry overall heat-transfer coefficient [W/K] (90 kW/K in the original)"
M_dot_w = 50        "water mass flow rate [kg/s]"
M_dot_a = 60        "air mass flow rate [kg/s]"
t_w_su = 35         "water inlet temperature [°C]"
P = 101325          "atmospheric pressure [Pa]"
t_a_su = 25         "ambient air dry-bulb temperature [°C]"
RH_su = 70E-2       "ambient air relative humidity [-]"

"!Rating (course equations, page 95)"
"The original left a commented provisional value c_p_f = 4000; it is not an equation."
Q_dot = epsilon_f*C_dot_min_f*(t_w_su - t_wb_su)   "heat rejected [W]"
epsilon_f = (1 - exp(-NTU_f*(1 - omega_f)))/(1 - omega_f*exp(-NTU_f*(1 - omega_f)))   "counterflow effectiveness [-]"
NTU_f = AU_f/C_dot_min_f                            "number of transfer units [-]"
AU_f = AU*c_p_f/c_p                                 "UA referred to the fictitious fluid [W/K]"
c_p_f = (h_a_ex - h_a_su)/(t_wb_ex - t_wb_su)       "fictitious specific heat of the moist air [J/kg-K]"
c_p = SPECHEAT(AirH2O,T=t_a_su,P=P,R=RH_su)         "inlet moist-air specific heat [J/kg-K]"
t_wb_su = WETBULB(AirH2O,T=t_a_su,P=P,R=RH_su)      "inlet air wet-bulb temperature [°C]"
C_dot_min_f = min(C_dot_w, C_dot_f)                 "minimum fictitious capacity rate [W/K]"
C_dot_w = M_dot_w*c_w                               "water capacity rate [W/K]"
c_w = 4187                                          "water specific heat, constant [J/kg-K]"
C_dot_f = M_dot_a*c_p_f                             "fictitious air capacity rate [W/K]"
omega_f = C_dot_min_f/C_dot_max_f                   "capacity-rate ratio [-]"
C_dot_max_f = max(C_dot_w, C_dot_f)                 "maximum fictitious capacity rate [W/K]"
Q_dot = M_dot_a*(h_a_ex - h_a_su)                   "air-side energy balance [W]"
h_a_su = ENTHALPY(AirH2O,T=t_a_su,P=P,R=RH_su)      "inlet moist-air specific enthalpy [J/kg]"
t_wb_ex = temperature(AirH2O,h=h_a_ex,P=P,R=1)      "wet-bulb temperature of the saturated outlet air [°C]"
Q_dot = C_dot_w*(t_w_su - t_w_ex)                   "water-side energy balance [W]"
