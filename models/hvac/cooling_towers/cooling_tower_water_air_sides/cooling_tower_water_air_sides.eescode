{=============================================================================
  Cooling tower water and air sides (exercise)
  CoolSolve Library model CSL-0232
 -----------------------------------------------------------------------------
  Teaching exercise (ULiège MSTh, repetition 6, exercise 1), not an exam.
  A direct-contact cooling tower is closed on the water side and on the
  moist-air side. The air side uses wet-bulb temperatures and a fictitious
  capacity rate. The same heat rate follows from the moist-air enthalpy
  change and from the counterflow effectiveness-NTU relation. cp_w is
  CP(Water) at the mean water temperature. cp_a_f is an unknown, fixed by
  AU_f/AU = cp_a_f/cp_a together with the air-side energy balance.

  Inputs : AU, M_dot_w, M_dot_a, T_w_su, P_su, T_a_su, RH_su, RH_ex
  Outputs: Q_dot_ct, T_w_ex, T_a_ex
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : Stéphane Bertagnolio, ULiège MSTh, MSTh-SB-R6-Ex1.EES
           - see README.md
  Licence: MIT. Status: verified against the EES stored solution.
=============================================================================}

"MSTh - SB - R6 - Exercice 1"

"!Cooling tower"
AU = 90000            "overall heat-transfer coefficient [W/K]"
M_dot_w = 50          "water mass flow rate [kg/s]"
M_dot_a = 60          "air mass flow rate [kg/s]"
T_w_su = 35           "inlet water temperature [°C]"
P_su = 101325         "pressure [Pa]"
T_a_su = 25           "inlet air dry-bulb temperature [°C]"
RH_su = 0.7           "inlet air relative humidity [-]"
RH_ex = 1             "outlet air relative humidity [-]"

"Water side, as in the original."
Q_dot_ct = C_dot_w*(T_w_su - T_w_ex)                         "tower heat rate, water side [W]"
C_dot_w = M_dot_w*cp_w                                       "water capacity rate [W/K]"
cp_w = CP(Water, T=T_w_m, P=P_su)                            "specific heat of liquid water [J/kg-K]"
"Provisional value in the original, not an equation:"
"cp_w=4187"
T_w_m = (T_w_su + T_w_ex)/2                                  "mean water temperature [°C]"

"Air side, as in the original."
Q_dot_ct = C_dot_a_f*(T_wb_ex - T_wb_su)                     "tower heat rate on the wet-bulb rise [W]"
T_wb_ex = WETBULB(AirH2O, T=T_a_ex, P=P_su, R=RH_ex)        "outlet air wet-bulb temperature [°C]"
T_wb_su = WETBULB(AirH2O, T=T_a_su, P=P_su, R=RH_su)        "inlet air wet-bulb temperature [°C]"
C_dot_a_f = M_dot_a*cp_a_f                                   "fictitious air capacity rate [W/K]"
"cp_a_f=4000"    "provisional value in the original, not an equation"

Q_dot_ct = M_dot_a*(h_a_ex - h_a_su)                        "tower heat rate from the moist-air enthalpy change [W]"
h_a_ex = ENTHALPY(AirH2O, T=T_a_ex, P=P_su, R=RH_ex)        "outlet moist-air enthalpy [J/kg]"
h_a_su = ENTHALPY(AirH2O, T=T_a_su, P=P_su, R=RH_su)        "inlet moist-air enthalpy [J/kg]"

"Tower performance, as in the original."
Q_dot_ct = epsilon_ct*C_dot_min_f*(T_w_su - T_wb_su)        "tower heat rate from the effectiveness [W]"
C_dot_min_f = min(C_dot_a_f, C_dot_w)                       "smaller capacity rate [W/K]"
epsilon_ct = (1 - exp(-NTU_f*(1 - omega_f)))/(1 - omega_f*exp(-NTU_f*(1 - omega_f)))    "counterflow effectiveness [-]"
NTU_f = AU_f/C_dot_min_f                                     "number of transfer units [-]"
AU_f/AU = cp_a_f/cp_a                                        "specific-heat ratio, as in the original [-]"
cp_a = CP(AirH2O, T=T_a_m, P=P_su, R=RH_su)                 "moist-air specific heat at the inlet humidity [J/kg-K]"
T_a_m = (T_a_su + T_a_ex)/2                                  "mean air dry-bulb temperature [°C]"
omega_f = C_dot_min_f/C_dot_max_f                            "capacity-rate ratio [-]"
C_dot_max_f = max(C_dot_a_f, C_dot_w)                        "larger capacity rate [W/K]"
