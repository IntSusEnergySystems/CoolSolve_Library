{=============================================================================
  Exercise: cooling tower at nominal and half fan speed
  CoolSolve Library model CSL-0215
 -----------------------------------------------------------------------------
  Teaching exercise (ULiège MSTh, repetition R6, exercise 2). The tower is
  rated as a fictitious dry counterflow exchanger on wet-bulb temperatures,
  once at the nominal fan speed and once at half speed (suffix _r). The
  outlet air is saturated. The stored solution holds the mix at half speed
  only (theta = 0).

  Inputs : AU_dry, M_dot_w, M_dot_a, T_w_su, P_atm, T_a_su, RH_su, W_dot,
           eta, theta
  Outputs: T_w_ex, T_w_ex_r, Q_dot, Q_dot_r, W_dot_r, T_w_ex_set, W_dot_mean
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège MSTh, 2024-10-05, R6 exercise 2; the file names no author
           - see README.md
=============================================================================}

"!Problem data (as in the original)"
AU_dry = 90000      "dry overall heat-transfer coefficient [W/K]"
M_dot_w = 50        "water mass flow rate [kg/s]"
M_dot_a = 60        "air mass flow rate [kg/s]"
T_w_su = 35         "water inlet temperature [°C]"
P_atm = 101325      "atmospheric pressure [Pa]"
T_a_su = 25         "inlet air dry-bulb temperature [°C]"
RH_su = 0.7         "inlet air relative humidity [-]"

"!Nominal regime"
"The original left a commented provisional value cp_a_f = 4000; it is not an equation."
Q_dot = C_dot_w*(T_w_su - T_w_ex)          "heat rejected, water side [W]"
C_dot_w = M_dot_w*c_w                      "water capacity rate [W/K]"
c_w = 4187                                 "water specific heat, constant [J/kg-K]"

Q_dot = epsilon_f*C_dot_min_f*(T_w_su - T_wb_su)   "heat rejected from the effectiveness [W]"
T_wb_su = wetbulb(AirH2O,T=T_a_su,P=P_atm,R=RH_su) "inlet air wet-bulb temperature [°C]"
T_wb_ex = wetbulb(AirH2O,T=T_a_ex,P=P_atm,R=RH_ex) "outlet air wet-bulb temperature [°C]"
RH_ex = 1                                  "outlet air taken as saturated, as in the original [-]"

C_dot_min_f = min(C_dot_w, C_dot_a_f)      "minimum fictitious capacity rate [W/K]"
Q_dot = C_dot_a_f*(T_wb_ex - T_wb_su)      "heat rejected, fictitious air side [W]"
C_dot_a_f = M_dot_a*cp_a_f                 "fictitious air capacity rate [W/K]"

epsilon_f = (1 - exp(-NTU_f*(1 - omega_f)))/(1 - omega_f*exp(-NTU_f*(1 - omega_f)))   "counterflow effectiveness [-]"

NTU_f = AU_f/C_dot_min_f                   "number of transfer units [-]"
omega_f = C_dot_min_f/C_dot_max_f          "capacity-rate ratio [-]"
C_dot_max_f = max(C_dot_w, C_dot_a_f)      "maximum fictitious capacity rate [W/K]"

AU_f = AU_dry*cp_a_f/cp_a                  "UA referred to the fictitious fluid [W/K]"

cp_a = cp(AirH2O,T=T_a_su,P=P_atm,R=RH_su) "inlet moist-air specific heat [J/kg-K]"

h_a_ex - h_a_su = cp_a_f*(T_wb_ex - T_wb_su)   "fictitious-fluid enthalpy change [J/kg]"
h_a_ex = enthalpy(AirH2O,T=T_a_ex,P=P_atm,w=w_a_ex)   "outlet moist-air enthalpy [J/kg]"
h_a_su = enthalpy(AirH2O,T=T_a_su,P=P_atm,w=w_a_su)   "inlet moist-air enthalpy [J/kg]"
w_a_su = humrat(AirH2O,T=T_a_su,P=P_atm,R=RH_su)      "inlet humidity ratio [kg/kg]"
w_a_ex = humrat(AirH2O,T=T_a_ex,P=P_atm,R=RH_ex)      "outlet humidity ratio [kg/kg]"

"!Reduced regime (half fan speed, suffix _r as in the original)"
AU_dry_r = AU_dry/2                        "dry UA at half speed [W/K]"
M_dot_a_r = M_dot_a/2                      "air mass flow at half speed [kg/s]"

Q_dot_r = C_dot_w*(T_w_su - T_w_ex_r)      "heat rejected at half speed, water side [W]"

Q_dot_r = epsilon_f_r*C_dot_min_f_r*(T_w_su - T_wb_su)   "heat rejected at half speed, from the effectiveness [W]"
T_wb_ex_r = wetbulb(AirH2O,T=T_a_ex_r,P=P_atm,R=RH_ex)   "half-speed outlet wet-bulb temperature [°C]"

C_dot_min_f_r = min(C_dot_w, C_dot_a_f_r)  "minimum fictitious capacity rate at half speed [W/K]"
Q_dot_r = C_dot_a_f_r*(T_wb_ex_r - T_wb_su) "heat rejected at half speed, fictitious air side [W]"
C_dot_a_f_r = M_dot_a_r*cp_a_f_r           "fictitious air capacity rate at half speed [W/K]"

epsilon_f_r = (1 - exp(-NTU_f_r*(1 - omega_f_r)))/(1 - omega_f_r*exp(-NTU_f_r*(1 - omega_f_r)))   "half-speed counterflow effectiveness [-]"

NTU_f_r = AU_f_r/C_dot_min_f_r             "number of transfer units at half speed [-]"
omega_f_r = C_dot_min_f_r/C_dot_max_f_r    "capacity-rate ratio at half speed [-]"
C_dot_max_f_r = max(C_dot_w, C_dot_a_f_r)  "maximum fictitious capacity rate at half speed [W/K]"

AU_f_r = AU_dry_r*cp_a_f_r/cp_a            "half-speed UA referred to the fictitious fluid [W/K]"

h_a_ex_r - h_a_su = cp_a_f_r*(T_wb_ex_r - T_wb_su)   "fictitious-fluid enthalpy change at half speed [J/kg]"
"As in the original, the half-speed outlet enthalpy uses the nominal dry-bulb T_a_ex."
"The original left a commented provisional value cp_a_f_r = 4000; it is not an equation."
h_a_ex_r = enthalpy(AirH2O,T=T_a_ex,P=P_atm,w=w_a_ex_r)   "half-speed outlet enthalpy at T_a_ex [J/kg]"
w_a_ex_r = humrat(AirH2O,T=T_a_ex_r,P=P_atm,R=RH_ex)      "half-speed outlet humidity ratio [kg/kg]"

"!Fan"
W_dot = 15000                              "fan power at the nominal speed [W]"
W_dot = V_dot_a*DELTAp/eta                 "fan power from volume flow and pressure rise [W]"
eta = 0.6                                  "fan efficiency, taken constant [-]"

V_dot_a = A*C_a                            "nominal air volume flow [m^3/s]"
V_dot_a = M_dot_a*v_a                      "nominal air volume flow from the specific volume [m^3/s]"
v_a = volume(AirH2O,T=T_a_su,P=P_atm,R=RH_su)   "inlet moist-air specific volume [m^3/kg]"
v_a*DELTAp = C_a^2/2                       "nominal velocity head [J/kg]"

"!Fan at half speed"
W_dot_r = V_dot_a_r*DELTAp_r/eta           "fan power at half speed [W]"
V_dot_a_r = A*C_a_r                        "half-speed air volume flow [m^3/s]"
V_dot_a_r = M_dot_a_r*v_a_r                "half-speed air volume flow from the specific volume [m^3/s]"
v_a_r = v_a                                "same inlet state, as in the original [m^3/kg]"

v_a_r*DELTAp_r = C_a_r^2/2                 "half-speed velocity head [J/kg]"

"!Operating regimes"
"The original only comments a trial T_w_ex_set = 25 and leaves theta free."
"The stored solution holds theta at 0, so the tower runs at half speed only."
theta = 0                                  "time fraction at nominal speed [-]; stored value"
T_w_ex_set = theta*T_w_ex + (1 - theta)*T_w_ex_r   "time-weighted outlet water temperature [°C]"
W_dot_mean = theta*W_dot + (1 - theta)*W_dot_r     "time-weighted fan power [W]"
