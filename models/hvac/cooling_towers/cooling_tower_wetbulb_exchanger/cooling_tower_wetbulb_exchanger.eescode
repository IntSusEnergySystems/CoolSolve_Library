{=============================================================================
  Exercise: cooling tower rated on wet-bulb temperatures
  CoolSolve Library model CSL-0198
 -----------------------------------------------------------------------------
  Teaching exercise (ULiège MSTh, repetition R6, exercise 1). A direct-contact
  cooling tower is rated as a fictitious dry counterflow exchanger: the
  temperatures of that fluid are the wet-bulb temperatures of the moist air.
  The outlet air is saturated. As in the original: working with these
  fictitious values is the same as a dry ideal fluid at the wet-bulb
  temperatures.

  Inputs : AU_dry, M_dot_w, M_dot_a, T_w_su, P_atm, T_a_su, RH_su
  Outputs: T_w_ex, Q_dot, T_a_ex, T_wb_ex
  Units  : SI - temperatures in °C, pressures in Pa, energies in J
  Source : ULiège MSTh, 2024-10-05, R6 exercise 1; the file names no author
           - see README.md
=============================================================================}

"!Problem data (as in the original)"
AU_dry = 90000      "dry overall heat-transfer coefficient [W/K]"
M_dot_w = 50        "water mass flow rate [kg/s]"
M_dot_a = 60        "air mass flow rate [kg/s]"
T_w_su = 35         "water inlet temperature [°C]"
P_atm = 101325      "atmospheric pressure [Pa]"
T_a_su = 25         "inlet air dry-bulb temperature [°C]"
RH_su = 0.7         "inlet air relative humidity [-]"

"!Rating on wet-bulb temperatures"
"The original left a commented provisional value cp_a_f = 4000; it is not an equation."
Q_dot = C_dot_w*(T_w_su - T_w_ex)          "heat rejected, water side [W]"
C_dot_w = M_dot_w*c_w                      "water capacity rate [W/K]"
c_w = 4187                                 "water specific heat, constant [J/kg-K]"

Q_dot = epsilon_f*C_dot_min_f*(T_w_su - T_wb_su)   "heat rejected from the effectiveness [W]"
T_wb_su = wetbulb(AirH2O,T=T_a_su,P=P_atm,R=RH_su) "inlet air wet-bulb temperature [°C]"
T_wb_ex = wetbulb(AirH2O,T=T_a_ex,P=P_atm,R=RH_ex) "outlet air wet-bulb temperature [°C]"
RH_ex = 1                                  "outlet air taken as saturated, as in the original [-]"

C_dot_min_f = min(C_dot_w, C_dot_a_f)      "minimum fictitious capacity rate [W/K]"
Q_dot = C_dot_a_f*(T_wb_ex - T_wb_su)      "heat rejected, fictitious air side [W]"
C_dot_a_f = M_dot_a*cp_a_f                 "fictitious air capacity rate [W/K]"

epsilon_f = (1 - exp(-NTU_f*(1 - omega_f)))/(1 - omega_f*exp(-NTU_f*(1 - omega_f)))   "counterflow effectiveness [-]"

NTU_f = AU_f/C_dot_min_f                   "number of transfer units [-]"
omega_f = C_dot_min_f/C_dot_max_f          "capacity-rate ratio [-]"
C_dot_max_f = max(C_dot_w, C_dot_a_f)      "maximum fictitious capacity rate [W/K]"

AU_f = AU_dry*cp_a_f/cp_a                  "UA referred to the fictitious fluid [W/K]"

cp_a = cp(AirH2O,T=T_a_su,P=P_atm,R=RH_su) "inlet moist-air specific heat [J/kg-K]"

h_a_ex - h_a_su = cp_a_f*(T_wb_ex - T_wb_su)   "fictitious-fluid enthalpy change [J/kg]"
h_a_ex = enthalpy(AirH2O,T=T_a_ex,P=P_atm,w=w_a_ex)   "outlet moist-air enthalpy [J/kg]"
h_a_su = enthalpy(AirH2O,T=T_a_su,P=P_atm,w=w_a_su)   "inlet moist-air enthalpy [J/kg]"
w_a_su = humrat(AirH2O,T=T_a_su,P=P_atm,R=RH_su)      "inlet humidity ratio [kg/kg]"
w_a_ex = humrat(AirH2O,T=T_a_ex,P=P_atm,R=RH_ex)      "outlet humidity ratio [kg/kg]"
