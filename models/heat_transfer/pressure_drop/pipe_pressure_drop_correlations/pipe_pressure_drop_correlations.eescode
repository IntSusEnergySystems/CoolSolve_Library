{=============================================================================
  Pressure drop in straight pipes: friction factors and two-phase correlations
  CoolSolve Library model CSL-0130 (function library, kind = function)
  -----------------------------------------------------------------------------
  Six Darcy friction factors for single-phase pipe flow (Churchill 1977,
  Swamee-Jain 1976, Konakov, Petukhov 1970, Haaland 1983, Cheng for supercritical
  CO2); the single-phase pressure drop of a straight pipe (Darcy-Weisbach plus
  hydrostatic term); the two-phase frictional drops of Friedel 1979,
  Muller-Steinhagen & Heck 1986 and Choi-Kedzierski-Domanski 2001; the two-phase
  acceleration term (homogeneous or Zivi void fraction) and gravity term, plus
  the dimensionless numbers, void fractions and mixture density they need. One
  FUNCTION per correlation, SI arguments (m, Pa, Pa.s, kg/m^3, N/m, degC);
  outputs are a Darcy friction factor [-] or a pressure drop [Pa].
  Source : LaboThapPy (E. Neven, S. Gendebien, B. Chaudoir, ULiège Thermo-
           dynamics Laboratory), labothappy/correlations/pressure_drop/
           pipe_DP.py, commit f03f7f47, Apache-2.0 (licence of the model: MIT)
  Status : VERIFIED against the LaboThapPy correlations of that commit; no
           CoolSolve gap blocking. The demonstration program at the end calls
           every function; cases, reference values and deviations: README.md.
=============================================================================}

"!--- Dimensionless numbers and two-phase mixture relations (helpers)"

FUNCTION Re_pipe(G, d_hyd, mu)
{RE_PIPE - Reynolds number of a pipe flow from its mass flux (as the
 compute_reynolds helper of the original).
  Re = G*d_hyd/mu      G [kg/(m^2.s)], d_hyd [m], mu [Pa.s]  ->  Re [-]}
  Re_pipe = G*d_hyd/mu
END

FUNCTION Fr_pipe(G, d_hyd, rho)
{FR_PIPE - Froude number of a pipe flow (as the compute_froude helper of the
 original).
  Fr = G/(SQRT(g*d_hyd)*rho)      G [kg/(m^2.s)], d_hyd [m], rho [kg/m^3]}

  Fr_pipe = G/(SQRT(9.81*d_hyd)*rho)   "9.81 [m/s^2] gravitational acceleration"
END

FUNCTION We_pipe(G, d_hyd, sigma, rho)
{WE_PIPE - Weber number of a pipe flow (as the compute_weber helper of the
 original).
  We = G^2*d_hyd/(sigma*rho)     G [kg/(m^2.s)], d_hyd [m], sigma [N/m],
                                 rho [kg/m^3]}

  We_pipe = G^2*d_hyd/(sigma*rho)
END

FUNCTION alpha_homogeneous(rho_l, rho_v, x)
{ALPHA_HOMOGENEOUS - Homogeneous void fraction (no slip, slip ratio S = 1), as
 the void_fraction_homogeneous helper of the original.
  alpha = 1/(1 + S*(rho_v/rho_l)*(1-x)/x), S = 1     x [-] -> alpha [-]}

  alpha_homogeneous = 1/(1 + (rho_v/rho_l)*(1 - x)/x)
END

FUNCTION alpha_Zivi(rho_l, rho_v, x)
{ALPHA_ZIVI - Zivi (1964) void fraction, slip-ratio method with
 S = (rho_l/rho_v)^(1/3), as the void_fraction_zivi helper of the original.
  alpha = 1/(1 + S*(rho_v/rho_l)*(1-x)/x)             x [-] -> alpha [-]}

  alpha_Zivi = 1/(1 + (rho_l/rho_v)^(1/3)*(rho_v/rho_l)*(1 - x)/x)
END

FUNCTION rho_two_phase_homogeneous(x, rho_l, rho_v)
{RHO_TWO_PHASE_HOMOGENEOUS - Homogeneous (no-slip) density of a saturated
 two-phase mixture, as the compute_two_phase_density helper of the original
 with its default void fraction (alpha = None -> homogeneous).
  rho = 1/(alpha/rho_v + (1-alpha)/rho_l) with the homogeneous alpha
                                               x [-] -> rho [kg/m^3]}

  alpha = alpha_homogeneous(rho_l, rho_v, x)
  rho_two_phase_homogeneous = 1/(alpha/rho_v + (1 - alpha)/rho_l)
END

"!--- Single-phase Darcy friction factors (one FUNCTION per correlation)"

FUNCTION f_Churchill(K, d_hyd, Re)
{F_CHURCHILL - Darcy friction factor, Churchill (1977): one equation valid in
 all flow regimes (laminar, transition, turbulent) with the surface roughness,
 smooth transition near Re = 2300 (as in the original).
  f = 8*[(8/Re)^12 + 1/(A + B)^1.5]^(1/12)
  A = [2.457*LN(1/((7/Re)^0.9 + 0.27*K/d_hyd))]^16,  B = (37530/Re)^16
 K [m] absolute roughness, d_hyd [m] hydraulic diameter, Re [-] -> f [-]
Validity: Re > 0 (all flow regimes), any relative roughness K/d_hyd.
Original: Churchill, S. W., "Friction-Factor Equation Spans All Fluid Flow
 Regimes", Chemical Engineering 84(24): 91-92, 1977.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_churchill,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  A = (2.457*LN(1/((7/Re)^0.9 + 0.27*K/d_hyd)))^16
  B = (37530/Re)^16
  f_Churchill = 8*((8/Re)^12 + 1/(A + B)^1.5)^(1/12)
END

FUNCTION f_Swamee_Jain(K, d_hyd, Re)
{F_SWAMEE_JAIN - Darcy friction factor, Swamee and Jain (1976): explicit
 approximation of the Colebrook-White equation with the surface roughness.
  f = 0.25/[LOG10(K/(3.7*d_hyd) + 5.74/Re^0.9)]^2
 K [m], d_hyd [m], Re [-] -> f [-]
Validity: Re >= 5000 (turbulent, recommended), Re >= 4000 acceptable;
 accuracy about 2 % of Colebrook-White (as in the original).
Original: Swamee, P. K. and A. K. Jain, "Explicit Equations for Pipe Flow
 Problems", Journal of the Hydraulics Division, ASCE 102(HY5): 657-664, 1976.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_swamee_jain,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  f_Swamee_Jain = 0.25/(LOG10(K/(3.7*d_hyd) + 5.74/Re^0.9))^2
END

FUNCTION f_Konakov(Re)
{F_KONAKOV - Darcy friction factor of a hydraulically smooth pipe, Konakov
 formula (as printed in the original).
  f = (1.8*LOG10(Re) - 1.5)^(-2)                    Re [-] -> f [-]
Validity: 4E3 <= Re <= 3E6, smooth pipes (as in the original).
Original: Khlapuk, M., O. Bezusyak, L. Volk and Z. Zhang, "Theoretical
 research of friction factor in hydraulically smooth pipes", E3S Web of
 Conferences 280: 10009, 2021 - https://doi.org/10.1051/e3sconf/202128010009
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_konakov,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  f_Konakov = (1.8*LOG10(Re) - 1.5)^(-2)
END

FUNCTION f_Petukhov(Re)
{F_PETUKHOV - Darcy friction factor of a hydraulically smooth pipe, Petukhov
 formula (as in the original; the same expression is the Filonenko limit of
 the Petukhov-Kirillov friction factor).
  f = (0.79*LN(Re) - 1.64)^(-2)                     Re [-] -> f [-]
Validity: 3E3-1E4 <= Re <= 5E6 (turbulent), 0.5 <= Pr <= 200, smooth pipes
 (as in the original).
Original: Petukhov, B. S., "Heat Transfer and Friction in Turbulent Pipe Flow
 with Variable Physical Properties", Advances in Heat Transfer 6: 503-564,
 Academic Press, 1970.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_petukhov,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  f_Petukhov = (0.79*LN(Re) - 1.64)^(-2)
END

FUNCTION f_Haaland(K, d_hyd, Re)
{F_HAALAND - Darcy friction factor, Haaland (1983): explicit approximation of
 the Colebrook-White equation with the surface roughness.
  f = 1/(-1.8*LOG10((K/(3.75*d_hyd))^1.11 + 6.9/Re))^2
 K [m], d_hyd [m], Re [-] -> f [-]
Validity: 4E3 <= Re <= 1E8 (turbulent), 1E-6 <= K/d_hyd <= 0.05 (as in the
 original).
Original: Haaland, S. E., "Simple and Explicit Formulas for the Friction
 Factor in Turbulent Pipe Flow", Journal of Fluids Engineering 105(1): 89-90,
 1983.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_haaland,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  f_Haaland = 1/(-1.8*LOG10((K/(3.75*d_hyd))^1.11 + 6.9/Re))^2
END

FUNCTION T_pseudo_critical_CO2(P)
{T_PSEUDO_CRITICAL_CO2 - Pseudo-critical temperature of carbon dioxide from its
 pressure, as the pseudo_critical_temperature_CO2 helper of the original.
  p = P/1E6 [MPa]; T_pc = -31.40 + 12.15*p - 0.6927*p^2 + 0.03160*p^3
                   - 0.0007521*p^4 + 273.15 [K]
 P [Pa] -> T_pc [°C]
Validity: 7.5 <= p <= 14 MPa (as in the original).
Original: Yang, Z. and J. Yang, "Investigation on the Properties of Supercritical
 CO2 Fluid and its Heat Transfer Characteristics", 2012.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/properties/supercritical.py,
 pseudo_critical_temperature_CO2, Apache-2.0
 - https://github.com/thermo-calculations/LaboThapPy}

  p = P/1E6
  T_pseudo_critical_CO2 = -31.40 + 12.15*p - 0.6927*p^2 + 0.03160*p^3 - 0.0007521*p^4
END

FUNCTION f_Cheng_CO2(G, d_hyd, P, h, mu)
{F_CHENG_CO2 - Darcy friction factor of supercritical carbon dioxide in a
 horizontal tube, from a Froude-number analysis separating liquid-like (LL),
 vapour-like (VL) and pseudo-boiling two-phase-like (TPL) flow regimes
 (as in the original).
  x_pb  = (h - h_LL)/(h_LV - h_LL)     pseudo-vapour quality, 0 = liquid-like
  Re    = G*d_hyd/mu
  LL or VL (x_pb < 0 or x_pb > 1):  f = 1.5*(1.82*LOG10(Re) - 1.64)^(-2)
  TPL:  Fr_VL = G^2*x_pb/(rho^2*G_gravity*d_hyd)
        f = 4.379*Re^(-0.388)*Fr_VL^(-0.0167)
 h_LL = h(P, T_minus), h_LV = h(P, T_plus) are the liquid-like and vapour-like
 enthalpies at the pseudo-boiling bounds T_minus and T_plus [K]; rho = rho(P, h)
 The bounds follow the linear pseudo-boiling model of Banuti (2019) from the
 enthalpy anchors of the pseudo-critical state and of the liquid state at
 p_L = 0.1*P_crit (see README.md).
 G [kg/(m^2.s)], d_hyd [m], P [Pa], h [J/kg], mu [Pa.s] -> f [-]
Assumptions of the original: d_hyd = 10 mm, G = 496.7-1346.2 kg/(m^2.s),
 heat flux 97.4-400.3 kW/m^2, P = 7.53-23.51 MPa, Fr = 7.58E-5 to 1834,
 Re = 6.18E4 to 5.35E5, horizontal tube, roughness not used.
Original: Cheng, L., J. Xu, W. Cao, K. Zhou and G. Liu, "Supercritical carbon
 dioxide heat transfer in horizontal tube based on the Froude number analysis",
 2024. Pseudo-critical temperature: Yang, Z. and J. Yang (2012). Pseudo-boiling
 bounds: Banuti, D., "The Latent Heat of Supercritical Fluids", Periodica
 Polytechnica Chemical Engineering 63(2): 270-275, 2019.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, friction_factor_cheng_CO2
 (with the pseudo_boiling_bounds and pseudo_critical_temperature_CO2 helpers
 of labothappy/correlations/properties/supercritical.py), Apache-2.0
 - https://github.com/thermo-calculations/LaboThapPy}

  rho = density('R744', P=P, H=h)
  Re = G*d_hyd/mu

  "Pseudo-critical state of carbon dioxide [K]"
  T_pc = T_pseudo_critical_CO2(P) + 273.15
  cp_pc = cp('R744', P=P, T=T_pc - 273.15)
  h_0_pc = enthalpy('R744', P=P, T=T_pc - 273.15)
  h_0_pc_intercept = h_0_pc - cp_pc*T_pc   "enthalpy intercept of the anchor"

  "Liquid-like anchor at p_L = 0.1*P_crit (10 % of the critical pressure)"
  P_crit_CO2 = P_crit('R744')
  P_triple_CO2 = P_triple('R744')
  p_L = 0.1*P_crit_CO2
  IF p_L < P_triple_CO2 THEN
    p_L = 1.05*P_triple_CO2
  ENDIF
  T_L = temperature('R744', P=p_L, x=0) + 273.15
  cp_L = cp('R744', P=p_L, T=T_L - 0.01 - 273.15)   "0.01 K subcooling, as in the original"
  h_L = enthalpy('R744', P=p_L, T=T_L - 0.01 - 273.15)
  h_L_intercept = h_L - cp_L*T_L   "enthalpy intercept of the liquid anchor"

  "Vapour-like anchor: heat capacity of the ideal gas at the upper table limit"
  T_max_CO2 = 1500   "T_max of the carbon dioxide tables, as in the original [K]"
  cp_IG = cp('R744', P=P, T=T_max_CO2 - 273.15)

  "Pseudo-boiling bounds (Banuti 2019) [K]"
  T_plus = h_0_pc_intercept/(cp_IG - cp_pc)
  T_minus = (h_L_intercept - h_0_pc_intercept)/(cp_pc - cp_L)

  "Pseudo-vapour quality and flow regime"
  h_LL = enthalpy('R744', P=P, T=T_minus - 273.15)
  h_LV = enthalpy('R744', P=P, T=T_plus - 273.15)
  x_pb = (h - h_LL)/(h_LV - h_LL)

  IF x_pb < 0 OR x_pb > 1 THEN
    f_Cheng_CO2 = 1.5*(1.82*LOG10(Re) - 1.64)^(-2)
  ELSE
    Fr_VL = G^2*x_pb/(rho^2*9.81*d_hyd)   "9.81 [m/s^2] gravitational acceleration"
    f_Cheng_CO2 = 4.379*Re^(-0.388)*Fr_VL^(-0.0167)
  ENDIF
END

"!--- Single-phase pressure drop of a straight pipe"

FUNCTION dP_pipe_friction(f, L, d_hyd, G, rho)
{DP_PIPE_FRICTION - Frictional pressure drop of a straight pipe, Darcy-Weisbach
 equation (as in the original).
  dP = f*(L/d_hyd)*(rho*v^2/2) with v = G/rho, i.e. dP = f*(L/d_hyd)*G^2/(2*rho)
 f [-] Darcy friction factor, L [m], d_hyd [m], G [kg/(m^2.s)], rho [kg/m^3]
 -> dP [Pa]}

  dP_pipe_friction = f*(L/d_hyd)*(rho*(G/rho)^2/2)
END

FUNCTION dP_pipe_gravity(L, rho, theta)
{DP_PIPE_GRAVITY - Hydrostatic pressure drop of a pipe of length L inclined
 by theta to the horizontal, positive theta being a downward flow (as in the
 original).
  dP = G_gravity*rho*L*SIN(theta)      L [m], rho [kg/m^3], theta [deg] -> dP [Pa]}

  dP_pipe_gravity = 9.81*rho*L*SIN(theta)   "9.81 [m/s^2] gravitational acceleration"
END

FUNCTION dP_pipe_single_phase(f, L, d_hyd, G, rho, theta)
{DP_PIPE_SINGLE_PHASE - Total pressure drop of a straight pipe in single-phase
 flow: frictional (Darcy-Weisbach) plus hydrostatic term. The friction factor
 f is computed by the caller with one of the f_* functions of this file (the
 original selects it with its correlation= argument).
  dP = dP_friction + dP_gravity
 f [-], L [m], d_hyd [m], G [kg/(m^2.s)], rho [kg/m^3], theta [deg] -> dP [Pa]}

  dP_pipe_single_phase = dP_pipe_friction(f, L, d_hyd, G, rho) + dP_pipe_gravity(L, rho, theta)
END

"!--- Two-phase frictional pressure drop of a straight pipe"

FUNCTION dP_Muller_Steinhagen_Heck(G, x, rho_l, rho_v, mu_l, mu_v, d_hyd, L, K)
{DP_MULLER_STEINHAGEN_HECK - Two-phase frictional pressure drop over a length L
 of pipe, Muller-Steinhagen and Heck (1986). Direct empirical curve fit (not a
 multiplier model): the single-phase pressure drops of the liquid and of the
 vapour, both at the total mass flux, are interpolated with the quality.
  dP_lo = f_l*(L/d_hyd)*G^2/(2*rho_l),  dP_vo = f_v*(L/d_hyd)*G^2/(2*rho_v)
         (f_l, f_v: Swamee-Jain factors of the two phases)
  G_MSH = dP_lo + 2*(dP_vo - dP_lo)*x
  dP_tp = G_MSH*(1 - x)^(1/3) + dP_vo*x^3
 G [kg/(m^2.s)], x [-], rho_l, rho_v [kg/m^3], mu_l, mu_v [Pa.s], d_hyd, L [m],
 K [m] -> dP_tp [Pa]
Validity: 0 < x < 1; fitted on 9300 measurements (air-water, water-hydrocarbon
 and refrigerants, channels of 4 to 392 mm) (as in the original).
Original: Muller-Steinhagen, H. and K. Heck, "A Simple Friction Pressure Drop
 Correlation for Two-Phase Flow in Pipes", Chemical Engineering and Processing:
 Process Intensification 20(6): 297-308, 1986.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py,
 pressure_drop_muller_steinhagen_heck, Apache-2.0
 - https://github.com/thermo-calculations/LaboThapPy}

  Re_l = Re_pipe(G, d_hyd, mu_l)
  Re_v = Re_pipe(G, d_hyd, mu_v)
  f_l = f_Swamee_Jain(K, d_hyd, Re_l)
  f_v = f_Swamee_Jain(K, d_hyd, Re_v)
  dP_lo = f_l*(L/d_hyd)*G^2/(2*rho_l)
  dP_vo = f_v*(L/d_hyd)*G^2/(2*rho_v)
  G_MSH = dP_lo + 2*(dP_vo - dP_lo)*x
  dP_Muller_Steinhagen_Heck = G_MSH*(1 - x)^(1/3) + dP_vo*x^3
END

FUNCTION dP_Friedel(G, x, rho_l, rho_v, mu_l, mu_v, sigma, d_hyd, L, K)
{DP_FRIEDEL - Two-phase frictional pressure drop over a length L of pipe,
 Friedel (1979). Separated-flow model: the liquid-only pressure drop at the
 total mass flux is corrected by the two-phase multiplier Phi_l^2.
  dP_tp = dP_lo*Phi_l^2
  dP_lo = f_l*(L/d_hyd)*G^2/(2*rho_l)          f_l, f_v: Churchill factors
  Phi_l^2 = E + 3.24*F*H/(Fr^0.0454*We^0.035)
  E = (1 - x)^2 + x^2*(rho_l*f_v/(rho_v*f_l))
  F = x^0.78*(1 - x)^0.224
  H = (rho_l/rho_v)^0.91*(mu_v/mu_l)^0.19*(1 - mu_v/mu_l)^0.7
  Fr = G/(SQRT(G_gravity*d_hyd)*rho_h),  We = G^2*d_hyd/(sigma*rho_h)
  rho_h = homogeneous two-phase density at x (slip ratio 1), as in the
  original
 G [kg/(m^2.s)], x [-], rho_l, rho_v [kg/m^3], mu_l, mu_v [Pa.s], sigma [N/m],
 d_hyd, L [m], K [m] -> dP_tp [Pa]
Validity: separated flow regimes, 0 < x < 1; the multiplier Phi_l^2 is typically
 2 to 10 (as in the original).
Original: Friedel, L., "Improved Friction Pressure Drop Correlations for
 Horizontal and Vertical Two-Phase Pipe Flow", European Two-Phase Flow Group
 Meeting, Ispra, Italy, 1979.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, pressure_drop_friedel,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  rho_h = rho_two_phase_homogeneous(x, rho_l, rho_v)
  Re_l = Re_pipe(G, d_hyd, mu_l)
  Re_v = Re_pipe(G, d_hyd, mu_v)
  f_l = f_Churchill(K, d_hyd, Re_l)
  f_v = f_Churchill(K, d_hyd, Re_v)
  dP_lo = f_l*(L/d_hyd)*G^2/(2*rho_l)
  Fr = Fr_pipe(G, d_hyd, rho_h)
  We = We_pipe(G, d_hyd, sigma, rho_h)
  F_friedel = x^0.78*(1 - x)^0.224
  H_friedel = (rho_l/rho_v)^0.91*(mu_v/mu_l)^0.19*(1 - mu_v/mu_l)^0.7
  E_friedel = (1 - x)^2 + x^2*(rho_l*f_v/(rho_v*f_l))
  Phi_l2 = E_friedel + 3.24*F_friedel*H_friedel/(Fr^0.0454*We^0.035)
  dP_Friedel = dP_lo*Phi_l2
END

FUNCTION dP_Choi(G, rho_su, rho_ex, x_su, x_ex, mu_l_sat, h_lv_sat, L, d_hyd)
{DP_CHOI - Two-phase frictional pressure drop for evaporation and condensation
 in smooth and micro-fin tubes, Choi, Kedzierski and Domanski (2001): a
 modification of the Bo Pierre (1964) homogeneous-flow correlation (hydraulic
 diameter instead of the smooth-tube diameter, liquid phase kept in the
 specific-volume average, friction factor re-regressed on NIST micro-fin data).
  Re_fo = G*d_hyd/mu_l_sat                    all-liquid Reynolds number
  K_f   = |x_ex - x_su|*h_lv_sat/(G_gravity*L)     two-phase (boiling) number
  f_N   = 0.00506*Re_fo^(-0.0951)*K_f^0.1554
  dP_tp = f_N*L*(v_ex + v_su)/d_hyd*G^2,  v_su = 1/rho_su, v_ex = 1/rho_ex
 rho_su, rho_ex are the quality-weighted two-phase densities at the tube inlet
 and outlet, x_su, x_ex the corresponding qualities, mu_l_sat the saturated
 liquid viscosity and h_lv_sat the latent heat at the averaged saturation
 temperature (as in the original)
 G [kg/(m^2.s)], rho_su, rho_ex [kg/m^3], x_su, x_ex [-], mu_l_sat [Pa.s],
 h_lv_sat [J/kg], L [m], d_hyd [m] -> dP_tp [Pa]
Validity: evaporation and condensation; developed on R125, R134a, R32, R410A,
 R22, R407C and R32/R134a (25/75 % mass) (as in the original).
Original: Choi, J. Y., M. A. Kedzierski and P. A. Domanski, "Generalized
 Pressure Drop Correlation for Evaporation and Condensation in Smooth and
 Micro-Fin Tubes", IIR Commission B1, Paderborn, Germany, 2001; full derivation
 and validation in NISTIR 6333, Choi, Kedzierski, Domanski, 1999.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py, pressure_drop_choi,
 Apache-2.0 - https://github.com/thermo-calculations/LaboThapPy}

  Re_fo = G*d_hyd/mu_l_sat
  K_f = ABS(x_ex - x_su)*h_lv_sat/(9.81*L)   "9.81 [m/s^2] gravitational acceleration"
  f_N = 0.00506*Re_fo^(-0.0951)*K_f^0.1554
  dP_Choi = f_N*L*((1/rho_ex) + (1/rho_su))/d_hyd*G^2
END

"!--- Two-phase acceleration and gravity terms of a straight pipe"

FUNCTION dP_acceleration_two_phase(G, rho_l, rho_v, x_inlet, x_outlet, void_model)
{DP_ACCELERATION_TWO_PHASE - Acceleration pressure drop of a two-phase pipe
 flow, separated-flow model with a selectable void fraction (as in the original,
 ACHP methodology).
  dP = G^2*(f(x_outlet) - f(x_inlet))
  f(x) = x^2*v_v/alpha + (1 - x)^2*v_l/(1 - alpha),  v_l = 1/rho_l, v_v = 1/rho_v
  alpha = homogeneous void fraction (void_model = 1, default of the original)
          or Zivi void fraction (void_model = 2)
 Positive when the quality increases (vapour accelerating, opposing the flow),
 negative when it decreases (flow decelerating, aiding the flow); typically
 5 to 15 % of the total pressure drop in an evaporator (as in the original).
 G [kg/(m^2.s)], rho_l, rho_v [kg/m^3], x_inlet, x_outlet [-], void_model = 1
 or 2 [-] -> dP [Pa]
Original: Wallis, G. B., "One-Dimensional Two-Phase Flow", McGraw-Hill, 1969;
 Collier, J. G. and J. R. Thome, "Convective Boiling and Condensation", 3E,
 Oxford University Press, 1994; ACHP documentation, FluidCorrelations.
Taken from: LaboThapPy (ULiège Thermodynamics Laboratory), commit f03f7f47,
 labothappy/correlations/pressure_drop/pipe_DP.py,
 pressure_drop_pipe_acceleration_two_phase, Apache-2.0
 - https://github.com/thermo-calculations/LaboThapPy}

  IF ABS(x_inlet) < 1E-12 THEN
    f_inlet = 1/rho_l
  ELSE
    IF ABS(1 - x_inlet) < 1E-12 THEN
      f_inlet = 1/rho_v
    ELSE
      IF void_model = 1 THEN
        alpha_in = alpha_homogeneous(rho_l, rho_v, x_inlet)
      ELSE
        alpha_in = alpha_Zivi(rho_l, rho_v, x_inlet)
      ENDIF
      f_inlet = x_inlet^2/(rho_v*alpha_in) + (1 - x_inlet)^2/(rho_l*(1 - alpha_in))
    ENDIF
  ENDIF

  IF ABS(x_outlet) < 1E-12 THEN
    f_outlet = 1/rho_l
  ELSE
    IF ABS(1 - x_outlet) < 1E-12 THEN
      f_outlet = 1/rho_v
    ELSE
      IF void_model = 1 THEN
        alpha_out = alpha_homogeneous(rho_l, rho_v, x_outlet)
      ELSE
        alpha_out = alpha_Zivi(rho_l, rho_v, x_outlet)
      ENDIF
      f_outlet = x_outlet^2/(rho_v*alpha_out) + (1 - x_outlet)^2/(rho_l*(1 - alpha_out))
    ENDIF
  ENDIF

  dP_acceleration_two_phase = G^2*(f_outlet - f_inlet)
END

FUNCTION dP_gravity_two_phase(L, rho_l, rho_v, x_inlet, x_outlet, theta)
{DP_GRAVITY_TWO_PHASE - Gravitational pressure drop of a two-phase pipe flow;
 the mixture density is taken at the mean of the inlet and outlet qualities
 with the homogeneous void fraction (as in the original).
  x_mean = (x_inlet + x_outlet)/2
  dP = G_gravity*rho_h*x_mean*L*SIN(theta)
 L [m], rho_l, rho_v [kg/m^3], x_inlet, x_outlet [-], theta [deg] -> dP [Pa]
Note: the original comments quote a positive theta as an upward flow for this
 function and as a downward flow for the single-phase term dP_pipe_gravity,
 while both equations are dP = G_gravity*rho*L*SIN(theta); see README.md.}

  x_mean = (x_inlet + x_outlet)/2
  rho_h = rho_two_phase_homogeneous(x_mean, rho_l, rho_v)
  dP_gravity_two_phase = 9.81*rho_h*L*SIN(theta)   "9.81 [m/s^2] gravitational acceleration"
END

FUNCTION dP_pipe_two_phase(dP_friction, dP_acceleration, dP_gravity)
{DP_PIPE_TWO_PHASE - Total pressure drop of a straight pipe in two-phase flow:
 frictional, acceleration and gravity terms (as in the original).
  dP_total = dP_friction + dP_acceleration + dP_gravity   -> dP_total [Pa]}

  dP_pipe_two_phase = dP_friction + dP_acceleration + dP_gravity
END

"!--- Demonstration program: inputs"

fluid$ = 'R134a'

"Case A - Darcy friction factors of a smooth pipe at Re = 1E5"
Re_A = 1E5
K_A = 0
d_hyd_A = 0.02

"Case A2 - same Reynolds number in a pipe of relative roughness 5E-3"
Re_A2 = 1E5
K_A2 = 0.0001
d_hyd_A2 = 0.02

"Case B - single-phase water flow, 2 bar and 20 °C, 20 mm x 10 m pipe"
fluid1p$ = 'Water'
P_B = 2E5
T_B = 20
D_B = 0.02
L_B = 10
K_B = 0
theta_B = 0
M_dot_B = 1.02253164556962   "same mass flow rate as the example (m_dot = 0.02 + 40*(2 - 0.02)/79) [kg/s]"
A_B = PI*D_B^2/4
G_B = M_dot_B/A_B
rho_B = density(fluid1p$, P=P_B, T=T_B)
mu_B = viscosity(fluid1p$, P=P_B, T=T_B)
v_B = G_B/rho_B
Re_B = Re_pipe(G_B, D_B, mu_B)

"Case B2 - same pipe inclined by 45 degrees (single-phase gravity term)"
theta_B2 = 45

"Case C/D/E - two-phase R134a at 10 °C, 10 mm x 3 m tube, 0.05 kg/s"
T_sat = 10
P_sat = pressure(fluid$, T=T_sat, x=0)
D_2p = 0.01
L_2p = 3
K_2p = 0
M_dot_2p = 0.05
A_2p = PI*D_2p^2/4
G_2p = M_dot_2p/A_2p
x_C = 0.508135593220339   "same quality as the example (x = 0.02 + 30*(0.98 - 0.02)/59)"
rho_l = density(fluid$, P=P_sat, x=0)
rho_v = density(fluid$, P=P_sat, x=1)
mu_l = viscosity(fluid$, P=P_sat, x=0)
mu_v = viscosity(fluid$, P=P_sat, x=1)
mu_l_sat = viscosity(fluid$, P=P_sat, x=0)   "saturated liquid viscosity at the averaged saturation temperature [Pa-s]"
sigma_2p = surfacetension(fluid$, T=T_sat, x=x_C)
x_su = 0.3
x_ex = 0.7
h_l_sat = enthalpy(fluid$, P=P_sat, x=0)
h_v_sat = enthalpy(fluid$, P=P_sat, x=1)
h_lv_sat = h_v_sat - h_l_sat   "latent heat of vaporization at 10 °C [J/kg]"
rho_su = rho_two_phase_homogeneous(x_su, rho_l, rho_v)
rho_ex = rho_two_phase_homogeneous(x_ex, rho_l, rho_v)
h_in = enthalpy(fluid$, P=P_sat, x=x_su)
P_in = P_sat

"Case F - supercritical carbon dioxide at 90 bar, 8 mm x 2 m tube, 0.05 kg/s"
fluidCO2$ = 'R744'
P_F = 90E5
D_F = 0.008
L_F = 2
M_dot_F = 0.05
A_F = PI*D_F^2/4
G_F = M_dot_F/A_F

"!--- Demonstration program: results"

"Case A - friction factors, smooth pipe"
f_Churchill_A = f_Churchill(K_A, d_hyd_A, Re_A)
f_Swamee_Jain_A = f_Swamee_Jain(K_A, d_hyd_A, Re_A)
f_Konakov_A = f_Konakov(Re_A)
f_Petukhov_A = f_Petukhov(Re_A)
f_Haaland_A = f_Haaland(K_A, d_hyd_A, Re_A)

"Case A2 - friction factors, relative roughness K/d_hyd = 5E-3"
f_Churchill_A2 = f_Churchill(K_A2, d_hyd_A2, Re_A2)
f_Swamee_Jain_A2 = f_Swamee_Jain(K_A2, d_hyd_A2, Re_A2)
f_Haaland_A2 = f_Haaland(K_A2, d_hyd_A2, Re_A2)

"Case B - single-phase water pressure drop with the five smooth-pipe factors"
dP_B_Churchill = dP_pipe_single_phase(f_Churchill(K_B, D_B, Re_B), L_B, D_B, G_B, rho_B, theta_B)
dP_B_Swamee_Jain = dP_pipe_single_phase(f_Swamee_Jain(K_B, D_B, Re_B), L_B, D_B, G_B, rho_B, theta_B)
dP_B_Konakov = dP_pipe_single_phase(f_Konakov(Re_B), L_B, D_B, G_B, rho_B, theta_B)
dP_B_Petukhov = dP_pipe_single_phase(f_Petukhov(Re_B), L_B, D_B, G_B, rho_B, theta_B)
dP_B_Haaland = dP_pipe_single_phase(f_Haaland(K_B, D_B, Re_B), L_B, D_B, G_B, rho_B, theta_B)

"Case B2 - the same flow in a pipe inclined by 45 degrees"
dP_B2_Churchill = dP_pipe_single_phase(f_Churchill(K_B, D_B, Re_B), L_B, D_B, G_B, rho_B, theta_B2)
dP_B2_gravity = dP_pipe_gravity(L_B, rho_B, theta_B2)
dP_B2_friction = dP_pipe_friction(f_Churchill(K_B, D_B, Re_B), L_B, D_B, G_B, rho_B)

"Case C - two-phase frictional pressure drop of R134a at x = 0.51"
dP_Friedel_C = dP_Friedel(G_2p, x_C, rho_l, rho_v, mu_l, mu_v, sigma_2p, D_2p, L_2p, K_2p)
dP_MSH_C = dP_Muller_Steinhagen_Heck(G_2p, x_C, rho_l, rho_v, mu_l, mu_v, D_2p, L_2p, K_2p)

"Case D - Choi correlation, evaporation from x = 0.3 to x = 0.7"
dP_Choi_D = dP_Choi(G_2p, rho_su, rho_ex, x_su, x_ex, mu_l_sat, h_lv_sat, L_2p, D_2p)

"Case E - acceleration and gravity terms, and total two-phase pressure drop"
dP_acc_hom_E = dP_acceleration_two_phase(G_2p, rho_l, rho_v, x_su, x_ex, 1)
dP_acc_zivi_E = dP_acceleration_two_phase(G_2p, rho_l, rho_v, x_su, x_ex, 2)
dP_acc_x0_E = dP_acceleration_two_phase(G_2p, rho_l, rho_v, 0, x_ex, 1)   "single-phase liquid inlet"
dP_acc_x1_E = dP_acceleration_two_phase(G_2p, rho_l, rho_v, x_su, 1, 1)   "single-phase vapour outlet"
dP_grav_45_E = dP_gravity_two_phase(L_2p, rho_l, rho_v, x_su, x_ex, 45)
dP_grav_m45_E = dP_gravity_two_phase(L_2p, rho_l, rho_v, x_su, x_ex, -45)

"Total two-phase pressure drop: outlet quality read at the constant inlet
 enthalpy and the outlet pressure P_in - dP_friction (as in the original, where
 the outlet state is found with an iteration on the pressure)"
dP_friction_E = dP_Friedel(G_2p, x_su, rho_l, rho_v, mu_l, mu_v, sigma_2p, D_2p, L_2p, K_2p)
P_out = P_in - dP_friction_E
x_out = quality(fluid$, P=P_out, H=h_in)
dP_acc_E = dP_acceleration_two_phase(G_2p, rho_l, rho_v, x_su, x_out, 1)
dP_grav_E = dP_gravity_two_phase(L_2p, rho_l, rho_v, x_su, x_out, 0)
dP_total_E = dP_pipe_two_phase(dP_friction_E, dP_acc_E, dP_grav_E)
"same pipe inclined by 45 degrees"
dP_grav_E_45 = dP_gravity_two_phase(L_2p, rho_l, rho_v, x_su, x_out, 45)
dP_total_E_45 = dP_pipe_two_phase(dP_friction_E, dP_acc_E, dP_grav_E_45)

"Case F - supercritical carbon dioxide (Cheng correlation)"
T_F1 = 0
T_F2 = 30
T_F3 = 60
rho_F1 = density(fluidCO2$, P=P_F, T=T_F1)
mu_F1 = viscosity(fluidCO2$, P=P_F, T=T_F1)
h_F1 = enthalpy(fluidCO2$, P=P_F, T=T_F1)
rho_F2 = density(fluidCO2$, P=P_F, T=T_F2)
mu_F2 = viscosity(fluidCO2$, P=P_F, T=T_F2)
h_F2 = enthalpy(fluidCO2$, P=P_F, T=T_F2)
rho_F3 = density(fluidCO2$, P=P_F, T=T_F3)
mu_F3 = viscosity(fluidCO2$, P=P_F, T=T_F3)
h_F3 = enthalpy(fluidCO2$, P=P_F, T=T_F3)
f_Cheng_CO2_F1 = f_Cheng_CO2(G_F, D_F, P_F, h_F1, mu_F1)
f_Cheng_CO2_F2 = f_Cheng_CO2(G_F, D_F, P_F, h_F2, mu_F2)
f_Cheng_CO2_F3 = f_Cheng_CO2(G_F, D_F, P_F, h_F3, mu_F3)
dP_F1 = dP_pipe_single_phase(f_Cheng_CO2_F1, L_F, D_F, G_F, rho_F1, 0)
dP_F2 = dP_pipe_single_phase(f_Cheng_CO2_F2, L_F, D_F, G_F, rho_F2, 0)
dP_F3 = dP_pipe_single_phase(f_Cheng_CO2_F3, L_F, D_F, G_F, rho_F3, 0)