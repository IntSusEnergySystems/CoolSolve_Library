h_Ganguli_VDI_A3 = h_Ganguli_VDI(m_A3, A_A3, A_min_A3, A_increase_A3, A_fin_A3, A_tube_showing_A3, tube_diameter_A3, fin_diameter_A3, fin_thickness_A3, bare_length_A3, pitch_parallel_A3, pitch_normal_A3, tube_rows_A3, rho_A3, Cp_A3, mu_A3, k_A3, k_fin_A3)

"!Case A4 - fan: 52.95 m/s tip speed (3177 m/min), 18.717 kW (25.1 hp), 4.267 m fan"
tip_speed_A4 = 52.95
power_A4 = 18717.066776715    "25.1 hp, as in the original [1]"
fan_diameter_A4 = 4.267

air_cooler_noise_GPSA_A4 = air_cooler_noise_GPSA(tip_speed_A4, power_A4)
air_cooler_noise_Mukherjee_A4 = air_cooler_noise_Mukherjee(tip_speed_A4, power_A4, fan_diameter_A4, 0)
air_cooler_noise_Mukherjee_ind_A4 = air_cooler_noise_Mukherjee(tip_speed_A4, power_A4, fan_diameter_A4, 1)

"!Case B - second, uniform input set: 2-row in-line low-fin bundle"
"!2 rows of 10 tubes, 1.2 m long, 19.05 mm OD, 0.8 mm fins at 3.5 mm pitch,"
"!3 mm high, in-line square pitches of 40 mm, 2.35 kg/s of air"
m_B = 2.35
A_B = 4.389792295
A_min_B = 0.2349428571
A_increase_B = 3.05624297
A_fin_B = 3.281761542
A_tube_showing_B = 1.108030753
tube_diameter_B = 0.01905
fin_diameter_B = 0.02505
fin_thickness_B = 0.0008
bare_length_B = 0.0027
fin_height_B = 0.003
pitch_parallel_B = 0.04
pitch_normal_B = 0.04
tube_rows_B = 2
flow_area_contraction_ratio_B = 0.4661564626
rho_B = 1.16
Cp_B = 1007
mu_B = 1.9E-5
k_B = 0.026
k_fin_B = 15
Pr_wall_B = Cp_B*mu_B/k_B   "Pr_wall = Pr: no property correction, as in the original [1]"

h_Briggs_Young_B = h_Briggs_Young(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, rho_B, Cp_B, mu_B, k_B, k_fin_B)
h_ESDU_high_fin_B = h_ESDU_high_fin(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, Cp_B, mu_B, k_B, k_fin_B, Pr_wall_B)
h_ESDU_high_fin_wall_B = h_ESDU_high_fin(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, Cp_B, mu_B, k_B, k_fin_B, 0.7)
h_ESDU_low_fin_B = h_ESDU_low_fin(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, Cp_B, mu_B, k_B, k_fin_B, Pr_wall_B)
h_ESDU_low_fin_wall_B = h_ESDU_low_fin(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, Cp_B, mu_B, k_B, k_fin_B, 0.77)
h_Ganguli_VDI_B = h_Ganguli_VDI(m_B, A_B, A_min_B, A_increase_B, A_fin_B, A_tube_showing_B, tube_diameter_B, fin_diameter_B, fin_thickness_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, Cp_B, mu_B, k_B, k_fin_B)
dP_ESDU_high_fin_B = dP_ESDU_high_fin(m_B, A_min_B, A_increase_B, flow_area_contraction_ratio_B, tube_diameter_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, mu_B)
dP_ESDU_low_fin_B = dP_ESDU_low_fin(m_B, A_min_B, A_increase_B, flow_area_contraction_ratio_B, tube_diameter_B, fin_height_B, bare_length_B, pitch_parallel_B, pitch_normal_B, tube_rows_B, rho_B, mu_B)

"!Case B - helper functions and second fan: 42 m/s tip speed, 45 kW, 3 m fan"
I0_B = bessel_mod_I_series(0, 1.5)
I1_B = bessel_mod_I_series(1, 1.5)
K0_B = bessel_mod_K_series(0, 1.5)
K1_B = bessel_mod_K_series(1, 1.5)
eta_fin_B = eta_fin_Kern_Kraus_aircooler(tube_diameter_B, fin_diameter_B, fin_thickness_B, k_fin_B, 98.5)

tip_speed_B = 42
power_B = 45000
fan_diameter_B = 3

air_cooler_noise_GPSA_B = air_cooler_noise_GPSA(tip_speed_B, power_B)
air_cooler_noise_Mukherjee_B = air_cooler_noise_Mukherjee(tip_speed_B, power_B, fan_diameter_B, 0)
air_cooler_noise_Mukherjee_ind_B = air_cooler_noise_Mukherjee(tip_speed_B, power_B, fan_diameter_B, 1)