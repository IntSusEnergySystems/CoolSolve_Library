{=============================================================================
  R22 chiller with an R407C heat pump upgrading its condenser heat
  CoolSolve Library model CSL-0319
 -----------------------------------------------------------------------------
  R22 water chiller (evaporator duty Q_dot_ev, water 8 -> 4 degC, condenser water
  30 -> 35 degC, eps-NTU exchangers, constant isentropic efficiency epsilon_s).
  As in the original, a second machine (R407C heat pump) takes the condenser
  heat of the chiller (35 -> 30 degC) at its evaporator and delivers it to a
  water circuit (60 -> 70 degC). The global COP and the part-load factors
  ELF = W_dot_el/W_dot_el_max and CLF = Q_dot_ev/Q_dot_ev_max are computed.
  Inputs : T_ev, T_cd, epsilon_s, eta_m, T_ev_pac, T_cd_pac, epsilon_c_pac_s, CLF
  Outputs: COP_chiller, COP_pac, COP_global, W_dot_el, W_dot_el_pac, ELF
  Units  : SI - temperatures in degC, pressures in Pa, energies in J
  Source : ULiege, course "Machines et systemes thermiques", exercise session 10,
           exercise 4 (MSTH-SB-R10-EX4.EES, SB) - see README.md
  Status : verified (R22 side: stored EES solution; R407C side: the EES 7.458
           R407C properties deviate, two CoolProp formulations agree, README);
           the (T,x=0.5) calls on R407C are rewritten with (P,x=0.5), see
           README (CS-GAP-PROP-TQ-PSEUDOPURE)
=============================================================================}

"MSTh 281105 R10 Ex 4 (title of the original)"

fluid$='R22'     "string variable of the original, not used by the equations"
"Q_dot_ev=450000 [W]  (commented out in the original: the load is set by CLF at the end)"

"Secondary fluids"
T_w_cd_su=30     "condenser water inlet [degC]"
T_w_cd_ex=35     "condenser water outlet [degC]"
T_w_ev_su=8      "evaporator water inlet [degC]"
T_w_ev_ex=4      "evaporator water outlet [degC]"

epsilon_s=0.67   "global isentropic efficiency of the R22 compressor-motor group [-]"

"Assumptions:"
T_ev=0           "evaporating temperature [degC]"
T_cd=45          "condensing temperature [degC]"
eta_m=0.9        "motor efficiency [-]"
DELTAT_sc=3      "subcooling [K]"
DELTAT_oh=0      "superheat [K] (not used by the equations, as in the original)"

"!CALCULATIONS"
"!Compression 1-2"

W_dot_el=W_dot_cp_s/epsilon_s
W_dot_el=W_dot_cp/eta_m

W_dot_cp=M_dot_r*w_cp  "actual compression [W]"
w_cp=h_2-h_1           "[J/kg]"

W_dot_cp_s=M_dot_r*w_cp_s "isentropic compression [W]"
w_cp_s=h_2_s-h_1          "[J/kg]"
h_2_s=ENTHALPY(R22,S=S_1,P=P_cd)
P_cd=PRESSURE(R22,T=T_cd,x=0.5)
s_1=ENTROPY(R22,T=T_ev,x=1)

"!Condenser 2-3"
"Q_dot_cd=M_dot_r*(h_2-h_3)"
Q_dot_cd=Q_dot_ev+W_dot_cp "equivalent to the previous (commented) equation [W]"
h_3=ENTHALPY(R22,T=T_3,x=0)
T_3=T_cd-DELTAT_sc

"!Evaporator 4-1"
Q_dot_ev=M_dot_r*(h_1-h_4)
h_1=ENTHALPY(R22,T=T_ev,x=1)

"!Expansion 3-4"
h_4=h_3 "isenthalpic expansion"

"Found (original comment): nominal (maximum) electrical power of the compressor-motor group"
"W_dot_el=276350 [W]"

"!Evaporator:"
Q_dot_ev=M_dot_w_ev*cp_w_ev*(T_w_ev_su-T_w_ev_ex)
cp_w_ev=CP(Water,T=T_w_ev_m,P=P_atm)
T_w_ev_m=(T_w_ev_su+T_w_ev_ex)/2
P_atm=101325
"provisional value (original comment): cp_w_ev=4187"
Q_dot_ev=epsilon_ev*C_dot_min_ev*(T_w_ev_su-T_ev)
C_dot_min_ev=M_dot_w_ev*cp_w_ev


"!Condenser"
Q_dot_cd=M_dot_w_cd*cp_w_cd*(T_w_cd_ex-T_w_cd_su)
cp_w_cd=CP(Water,T=T_w_cd_m,P=P_atm)
T_w_cd_m=(T_w_cd_su+T_w_cd_ex)/2
"provisional value (original comment): cp_w_cd=4187"
Q_dot_cd=epsilon_cd*C_dot_min_cd*(T_cd-T_w_cd_su)
C_dot_min_cd=M_dot_w_cd*cp_w_cd

"!Addition of a heat pump (R407C)"
"Assumptions:"
T_cd_pac=80       "condensing temperature [degC]"
T_ev_pac=20       "evaporating temperature [degC]"
DELTAT_sc_pac=3   "subcooling [K]"
eta_m_pac=0.9     "motor efficiency [-]"
DELTAT_oh_pac=0   "superheat [K] (not used by the equations, as in the original)"
"Evaporator:"
Q_dot_ev_pac=Q_dot_cd
T_w_ev_pac_su=T_w_cd_ex
T_w_ev_pac_ex=T_w_cd_su
M_dot_w_ev_pac=M_dot_w_cd
Q_dot_ev_pac=epsilon_ev_pac*M_dot_w_ev_pac*cp_w_ev_pac*(T_w_ev_pac_su-T_ev_pac)
cp_w_ev_pac=cp_w_cd
"Original: P_ev_pac=PRESSURE(R407C,T=T_ev_pac,x=0.5). The (T,x=0.5) pair returns NaN in CoolProp for
 R407C: the supported (P,x=0.5) pair is used and the equation is written implicitly in P_ev_pac."
T_ev_pac=TEMPERATURE(R407C,P=P_ev_pac,x=0.5)
Q_dot_ev_pac=M_dot_r_pac*(h_1_pac-h_4_pac)
h_1_pac=ENTHALPY(R407C,T=T_ev_pac,x=1)
h_4_pac=h_3_pac

"Condenser:"
T_w_cd_pac_su=60
T_w_cd_pac_ex=70
Q_dot_cd_pac=epsilon_cd_pac*M_dot_w_cd_pac*cp_w_cd_pac*(T_cd_pac-T_w_cd_pac_su)
Q_dot_cd_pac=M_dot_w_cd_pac*cp_w_cd_pac*(T_w_cd_pac_ex-T_w_cd_pac_su)
cp_w_cd_pac=4187
"Assumption:"
"Original: P_cd_pac=PRESSURE(R407C,T=T_cd_pac-DELTAT_sc_pac,x=0.5), rewritten as above."
T_cd_pac-DELTAT_sc_pac=TEMPERATURE(R407C,P=P_cd_pac,x=0.5)
h_3_pac=ENTHALPY(R407C,T=T_cd_pac-3,x=0)

"Compression:"
epsilon_c_pac_s=0.6   "global isentropic efficiency of the R407C compressor-motor group [-]"
epsilon_c_pac_s=W_dot_cp_pac_s/W_dot_el_pac
eta_m_pac=W_dot_cp_pac/W_dot_el_pac
W_dot_cp_pac_s=M_dot_r_pac*w_cp_pac_s
w_cp_pac_s=h_2_pac_s-h_1_pac
h_2_pac_s=ENTHALPY(R407C,s=s_1_pac,P=P_cd_pac)
s_1_pac=ENTROPY(R407C,T=T_ev_pac,x=1)
Q_dot_ev_pac+W_dot_cp_pac=Q_dot_cd_pac

"!COP of the installation"

COP_global=(Q_dot_ev+Q_dot_cd_pac)/(W_dot_el+W_dot_el_pac)
COP_pac=Q_dot_cd_pac/W_dot_el_pac
COP_chiller=Q_dot_ev/W_dot_el

"Part-load factors: electrical power and evaporator duty relative to their nominal values"
ELF=W_dot_el/W_dot_el_max
W_dot_el_max=276350   "nominal electrical power of the R22 group [W] (value found by the original at CLF = 1)"
CLF=Q_dot_ev/Q_dot_ev_max
Q_dot_ev_max=900000   "nominal evaporator duty [W]"
CLF=1   "default operating point: in the original CLF is a column of a parametric table (full load, stored solution)"

"Original comment: the COPs can be increased by reducing the temperature differences (T_evap <-> T_cond);
 the limits are the effectivenesses of the exchangers."

"!State points for the thermodynamic diagrams (post-processing, no effect on the results)"
{R22 chiller: arrays P[i], h[i], T[i], s[i] (1: evaporator outlet, 2: compressor outlet,
 3: condenser outlet, 4: evaporator inlet). R407C heat pump: arrays P_pac[i], h_pac[i],
 T_pac[i], s_pac[i], same numbering. Use them with the "Overlay array path" option of the
 CoolSolve Diagram tab.}
P[1] = P_ev_r22
P_ev_r22 = PRESSURE(R22, T=T_ev, x=1)
h[1] = h_1
T[1] = T_ev
s[1] = S_1
P[2] = P_cd
h[2] = h_2
T[2] = TEMPERATURE(R22, h=h[2], P=P[2])
s[2] = ENTROPY(R22, h=h[2], P=P[2])
P[3] = P_cd
h[3] = h_3
T[3] = T_3
s[3] = ENTROPY(R22, h=h[3], P=P[3])
P[4] = P_ev_r22
h[4] = h_4
T[4] = TEMPERATURE(R22, h=h[4], P=P[4])
s[4] = ENTROPY(R22, h=h[4], P=P[4])
P_pac[1] = P_ev_pac
h_pac[1] = h_1_pac
T_pac[1] = TEMPERATURE(R407C, h=h_pac[1], P=P_pac[1])
s_pac[1] = s_1_pac
P_pac[2] = P_cd_pac
h_pac[2] = h_1_pac+W_dot_cp_pac/M_dot_r_pac
T_pac[2] = TEMPERATURE(R407C, h=h_pac[2], P=P_pac[2])
s_pac[2] = ENTROPY(R407C, h=h_pac[2], P=P_pac[2])
P_pac[3] = P_cd_pac
h_pac[3] = h_3_pac
T_pac[3] = TEMPERATURE(R407C, h=h_pac[3], P=P_pac[3])
s_pac[3] = ENTROPY(R407C, h=h_pac[3], P=P_pac[3])
P_pac[4] = P_ev_pac
h_pac[4] = h_4_pac
T_pac[4] = TEMPERATURE(R407C, h=h_pac[4], P=P_pac[4])
s_pac[4] = ENTROPY(R407C, h=h_pac[4], P=P_pac[4])
